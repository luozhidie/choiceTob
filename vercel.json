{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "functions": {
    "src/app/api/tryon/generate/route.ts": {
      "memory": 2048,
      "maxDuration": 120
    },
    "src/app/api/mini/upload-product-image/route.ts": {
      "memory": 2048,
      "maxDuration": 120
    }
  },
  "crons": [
    { "path": "/api/finance/signal/run", "schedule": "30 8 * * 1-5" },
    { "path": "/api/ssq/sync", "schedule": "0 14 * * 0,2,4" },
    { "path": "/api/lottery/dailypick", "schedule": "0 15 * * *" },
    { "path": "/api/admin/products/auto-unpublish", "schedule": "0 4 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ]
}
