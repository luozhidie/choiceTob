<view class="page">
  <!-- hero -->
  <view class="hero">
    <view class="hero-title">邀请好友 · 首单返红包</view>
    <view class="hero-sub">好友通过你的邀请码注册并下首单，你立得 <text class="hl">¥8–100</text> 随机红包</view>
  </view>

  <!-- 邀请码卡片 -->
  <view class="code-card">
    <view class="code-row">
      <view class="code-left">
        <text class="code-label">我的邀请码</text>
        <text class="code-value">{{invite_code || '—'}}</text>
      </view>
      <view class="code-copy" bindtap="copyCode">复制</view>
    </view>
    <view class="code-link" wx:if="{{invite_link}}">
      <text class="link-text" selectable="true">{{invite_link}}</text>
      <view class="link-copy" bindtap="copyLink">复制链接</view>
    </view>
    <view class="code-actions">
      <view class="act-btn" bindtap="sharePoster">转发送给好友</view>
    </view>
  </view>

  <!-- 统计 -->
  <view class="stat-row">
    <view class="stat">
      <text class="stat-num">{{invited_count}}</text>
      <text class="stat-label">已邀请好友</text>
    </view>
    <view class="stat">
      <text class="stat-num">{{rewards.length}}</text>
      <text class="stat-label">已返红包</text>
    </view>
  </view>

  <!-- 返利明细 -->
  <view class="card-block">
    <view class="block-head">
      <text class="block-title">返利明细</text>
      <text class="block-extra">好友首单完成后到账</text>
    </view>
    <view class="reward" wx:for="{{rewards}}" wx:key="id">
      <view class="reward-main">
        <text class="reward-amt">¥{{item.reward_amount / 100}}</text>
        <text class="reward-meta" wx:if="{{item.first_order_amount}}">好友首单 ¥{{item.first_order_amount / 100}}</text>
      </view>
      <text class="reward-status {{item.reward_granted ? 'on' : ''}}">{{item.reward_granted ? '已发放' : '待发放'}}</text>
    </view>
    <view class="reward-empty" wx:if="{{rewards.length === 0}}">还没有返利，快去邀请好友吧</view>
  </view>

  <!-- 规则 -->
  <view class="rules">
    <text class="rules-title">活动规则</text>
    <text class="rules-line">1. 好友在注册时填写你的邀请码，即建立邀请关系；</text>
    <text class="rules-line">2. 好友完成首笔订单后，你获得 ¥8–100 随机红包；</text>
    <text class="rules-line">3. 红包存入「我的红包」，下单时可直接抵扣。</text>
  </view>

  <!-- 未登录 -->
  <view class="empty" wx:if="{{!loading && notLogin}}">
    <text class="empty-icon">🔒</text>
    <text class="empty-text">请先登录后查看邀请</text>
    <view class="empty-btn" bindtap="goLogin">去登录</view>
  </view>

  <view class="loading" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
  </view>
</view>
