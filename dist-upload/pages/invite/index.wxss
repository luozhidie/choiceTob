page { background: var(--bg); }

.hero {
  background: linear-gradient(135deg, #2d1b2e, #4a3a4b);
  color: #fff;
  padding: 44rpx 32rpx 36rpx;
  border-radius: 0 0 32rpx 32rpx;
  text-align: center;
}
.hero-title { font-size: 34rpx; font-weight: 800; }
.hero-sub { font-size: 22rpx; opacity: 0.8; margin-top: 12rpx; line-height: 1.6; }
.hero-sub .hl { color: #C9A24B; font-weight: 700; }

/* code card */
.code-card {
  background: var(--surface);
  border-radius: var(--r-md);
  margin: 24rpx;
  padding: 28rpx 24rpx;
  box-shadow: var(--sh-1);
}
.code-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.code-label { font-size: 22rpx; color: var(--text-3); display: block; }
.code-value {
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 6rpx;
  color: #2d1b2e;
}
.code-copy {
  background: #2d1b2e;
  color: #fff;
  font-size: 24rpx;
  padding: 12rpx 32rpx;
  border-radius: 30rpx;
}
.code-link {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  background: #f7f3ee;
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
}
.link-text {
  flex: 1;
  font-size: 22rpx;
  color: var(--text-2);
  word-break: break-all;
}
.link-copy {
  font-size: 22rpx;
  color: #b8860b;
  margin-left: 16rpx;
  flex-shrink: 0;
}
.code-actions { margin-top: 22rpx; }
.act-btn {
  background: #C9A24B;
  color: #2d1b2e;
  font-weight: 700;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 40rpx;
  font-size: 28rpx;
}

/* stat */
.stat-row {
  display: flex;
  gap: 24rpx;
  margin: 0 24rpx;
}
.stat {
  flex: 1;
  background: var(--surface);
  border-radius: var(--r-md);
  padding: 28rpx 0;
  text-align: center;
  box-shadow: var(--sh-1);
}
.stat-num { font-size: 44rpx; font-weight: 800; color: #2d1b2e; display: block; }
.stat-label { font-size: 22rpx; color: var(--text-3); display: block; margin-top: 6rpx; }

/* block */
.card-block {
  background: var(--surface);
  border-radius: var(--r-md);
  margin: 24rpx;
  padding: 28rpx 24rpx;
  box-shadow: var(--sh-1);
}
.block-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.block-title { font-size: 30rpx; font-weight: 700; color: var(--text); }
.block-extra { font-size: 22rpx; color: var(--text-3); }

.reward {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.reward:last-child { border-bottom: none; }
.reward-amt { font-size: 32rpx; font-weight: 800; color: #2d1b2e; }
.reward-meta { font-size: 20rpx; color: var(--text-3); display: block; margin-top: 4rpx; }
.reward-status { font-size: 22rpx; color: #b8860b; }
.reward-status.on { color: #2fae6b; }
.reward-empty { font-size: 24rpx; color: var(--text-3); text-align: center; padding: 24rpx 0; }

/* rules */
.rules {
  margin: 8rpx 24rpx 40rpx;
  background: var(--surface);
  border-radius: var(--r-md);
  padding: 28rpx 24rpx;
  box-shadow: var(--sh-1);
}
.rules-title { font-size: 26rpx; font-weight: 700; color: var(--text); display: block; margin-bottom: 12rpx; }
.rules-line { font-size: 22rpx; color: var(--text-2); display: block; line-height: 1.9; }

/* empty / loading */
.empty { text-align: center; padding: 120rpx 0; color: #ccc; }
.empty-icon { font-size: 80rpx; display: block; margin-bottom: 20rpx; }
.empty-text { font-size: 26rpx; }
.empty-btn {
  margin-top: 30rpx;
  background: #2d1b2e;
  color: #fff;
  font-size: 26rpx;
  padding: 14rpx 56rpx;
  border-radius: 40rpx;
  display: inline-block;
}
.loading { text-align: center; padding: 80rpx 0; }
.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 3rpx solid #eee;
  border-top-color: #2d1b2e;
  border-radius: 50%;
  display: inline-block;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
