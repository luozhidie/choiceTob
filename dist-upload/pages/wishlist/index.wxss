.page { min-height: 100vh; background: #f5f5f7; padding-bottom: 40rpx; }

.nav {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}
.nav-back { font-size: 44rpx; color: #2d1b2e; line-height: 1; padding: 0 8rpx; }
.nav-title { font-size: 32rpx; font-weight: 700; color: #2d1b2e; }
.nav-count {
  margin-left: auto;
  font-size: 24rpx;
  color: #fff;
  background: #f59e0b;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

.loading { text-align: center; color: #999; padding: 80rpx 0; font-size: 26rpx; }

.empty { display: flex; flex-direction: column; align-items: center; gap: 18rpx; padding: 120rpx 60rpx; text-align: center; }
.empty-ic { width: 110rpx; height: 110rpx; border-radius: 50%; background: #fff7ed; color: #f59e0b; font-size: 56rpx; line-height: 110rpx; text-align: center; }
.empty-title { font-size: 30rpx; color: #333; font-weight: 600; }
.empty-sub { font-size: 25rpx; color: #999; line-height: 1.5; }
.empty-btn { margin-top: 16rpx; padding: 18rpx 56rpx; background: linear-gradient(135deg, #f59e0b, #f97316); color: #fff; border-radius: 999rpx; font-size: 27rpx; font-weight: 700; }

.list { padding: 20rpx; display: flex; flex-direction: column; gap: 16rpx; }
.card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
}
.card-img { width: 130rpx; height: 130rpx; border-radius: 14rpx; background: #f0f0f0; overflow: hidden; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
.card-img image { width: 100%; height: 100%; }
.card-ph { font-size: 44rpx; }
.card-body { flex: 1; min-width: 0; }
.card-title { font-size: 28rpx; color: #1a1a2e; line-height: 1.45; display: block;
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.card-tags { display: flex; gap: 10rpx; margin-top: 10rpx; flex-wrap: wrap; }
.tag { font-size: 20rpx; color: #b45309; background: #fff7ed; border: 1rpx solid #fed7aa; border-radius: 8rpx; padding: 2rpx 10rpx; }
.tag.off { color: #999; background: #f3f3f3; border-color: #e5e5e5; }
.card-price { display: block; margin-top: 10rpx; font-size: 28rpx; font-weight: 700; color: #f59e0b; }
.card-del { flex-shrink: 0; font-size: 24rpx; color: #ef4444; padding: 12rpx 20rpx; border: 1rpx solid #fecaca; border-radius: 999rpx; }
.card-del:active { background: #fef2f2; }
