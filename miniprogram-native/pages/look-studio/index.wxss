.page { padding: 14rpx; padding-bottom: 180rpx; font-family: system-ui, sans-serif; color: #1a1a1a; }
.hero { margin-bottom: 14rpx; }
.ht { font-size: 38rpx; font-weight: 800; display: block; }
.hs { font-size: 22rpx; color: #888; margin-top: 6rpx; display: block; line-height: 1.4; }

.card { background: #fff; border-radius: 20rpx; border: 1rpx solid #eee; padding: 18rpx; margin-bottom: 14rpx; }
.ct { font-size: 26rpx; font-weight: 700; display: block; margin-bottom: 12rpx; }
.me-row { display: flex; }
.me-pic { width: 140rpx; height: 186rpx; border-radius: 16rpx; border: 2rpx dashed #bbb; display: flex; align-items: center; justify-content: center; overflow: hidden; background: #fafafa; flex-shrink: 0; }
.me-img { width: 100%; height: 100%; }
.me-ph { font-size: 20rpx; color: #aaa; text-align: center; white-space: pre; }
.me-info { flex: 1; margin-left: 16rpx; }
.hint { font-size: 20rpx; color: #999; line-height: 1.5; display: block; }
.pro-entry { font-size: 20rpx; color: #C9A24B; font-weight: 700; margin-top: 12rpx; display: inline-block; }
.pro-entry.on { color: #999; font-weight: 400; }
.lab { font-size: 20rpx; color: #999; display: block; margin: 6rpx 0 4rpx; }
.chips { white-space: nowrap; }
.chip { display: inline-block; font-size: 20rpx; padding: 6rpx 16rpx; border-radius: 30rpx; border: 1rpx solid #ddd; margin-right: 8rpx; color: #666; background: #fff; }
.chip.on { background: #222; color: #fff; border-color: #222; }

.tabs { display: flex; gap: 10rpx; margin: 14rpx 0; }
.tab { flex: 1; text-align: center; padding: 18rpx 0; border-radius: 16rpx; font-size: 26rpx; font-weight: 700; background: #f0f0f0; color: #666; }
.tab.on { background: #222; color: #fff; }

.grid2 { display: flex; flex-wrap: wrap; gap: 14rpx; }
.lcard { width: calc(50% - 7rpx); background: #fff; border: 1rpx solid #eee; border-radius: 16rpx; padding: 14rpx; box-sizing: border-box; }
.lname { font-size: 24rpx; font-weight: 700; display: block; margin-bottom: 10rpx; }
.lrow { display: flex; gap: 6rpx; height: 220rpx; margin-bottom: 10rpx; }
.limg { flex: 1; height: 100%; border-radius: 10rpx; }
.lbtn { font-size: 22rpx; color: #333; background: #f0f0f0; text-align: center; padding: 12rpx 0; border-radius: 10rpx; display: block; }

.grid3 { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; }
.pcard { width: calc(33.33% - 8rpx); background: #fff; border: 1rpx solid #eee; border-radius: 14rpx; padding: 8rpx; box-sizing: border-box; }
.pimg { width: 100%; height: 240rpx; border-radius: 10rpx; }
.ptitle { font-size: 20rpx; color: #333; margin-top: 6rpx; line-height: 1.3; height: 52rpx; overflow: hidden; display: block; }
.ptags { display: flex; flex-wrap: wrap; gap: 4rpx; margin: 6rpx 0; }
.tg { font-size: 16rpx; padding: 2rpx 8rpx; border-radius: 8rpx; }
.tg.s { background: #f3f0ff; color: #7b4dff; }
.tg.t { background: #eef; color: #446; }
.pprice { font-size: 22rpx; font-weight: 800; color: #C0392B; margin-top: 4rpx; display: block; }
.pbtn { font-size: 20rpx; background: #222; color: #fff; text-align: center; padding: 10rpx 0; border-radius: 10rpx; display: block; }

.auto-box { background: #fff; border: 1rpx solid #eee; border-radius: 16rpx; padding: 18rpx; margin-top: 12rpx; }
.auto-tip { font-size: 22rpx; color: #666; line-height: 1.5; display: block; }
.auto-btn { display: block; text-align: center; background: #7b4dff; color: #fff; font-size: 26rpx; font-weight: 700; padding: 20rpx 0; border-radius: 14rpx; margin: 14rpx 0; }
.tray-prev { display: flex; gap: 8rpx; flex-wrap: wrap; }
.tp-img { width: 120rpx; height: 150rpx; border-radius: 10rpx; }

.empty { color: #aaa; font-size: 22rpx; text-align: center; padding: 30rpx; }

.tray-bar { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; border-top: 1rpx solid #eee; padding: 14rpx; display: flex; align-items: center; gap: 14rpx; }
.tray-scroll { flex: 1; white-space: nowrap; }
.tray-empty { font-size: 22rpx; color: #aaa; }
.tray-item { display: inline-block; position: relative; margin-right: 10rpx; }
.ti-img { width: 84rpx; height: 108rpx; border-radius: 10rpx; border: 1rpx solid #eee; }
.ti-x { position: absolute; top: -8rpx; right: -8rpx; background: #c0392b; color: #fff; border-radius: 50%; width: 32rpx; height: 32rpx; font-size: 22rpx; text-align: center; line-height: 32rpx; }
.try-btn { background: #222; color: #fff; font-size: 24rpx; font-weight: 700; padding: 22rpx 26rpx; border-radius: 14rpx; white-space: nowrap; }

.mask { position: fixed; inset: 0; background: rgba(0,0,0,.88); display: flex; align-items: center; justify-content: center; padding: 30rpx; z-index: 50; }
.result { width: 100%; }
.rc { color: #fff; font-size: 22rpx; text-align: center; display: block; margin-bottom: 16rpx; }
.rimg { width: 100%; border-radius: 16rpx; border: 1rpx solid #444; }

/* —— 推广 / 付费墙 —— */
.promo { background: linear-gradient(90deg,#fcefe9,#fff); color: #2d1b2e; font-size: 24rpx; font-weight: 700; padding: 14rpx 18rpx; border-radius: 14rpx; margin-bottom: 12rpx; border: 1rpx solid #C9A24B; }
.pkg-link { font-size: 20rpx; color: #C9A24B; margin-top: 8rpx; display: inline-block; }
.pass-bar { display: flex; align-items: center; justify-content: space-between; background: #222; color: #fff; border-radius: 14rpx; padding: 16rpx 18rpx; margin-bottom: 14rpx; }
.pass-t { font-size: 22rpx; }
.pass-go { font-size: 22rpx; color: #C9A24B; font-weight: 700; }
.result .save-btn { display: block; text-align: center; background: #C9A24B; color: #2d1b2e; font-weight: 800; font-size: 26rpx; padding: 20rpx 0; border-radius: 14rpx; margin-top: 18rpx; }
.buy-tip { color: #fcefe9; font-size: 20rpx; text-align: center; display: block; margin-top: 14rpx; line-height: 1.5; opacity: .85; }
.close-tip { color: #bbb; font-size: 20rpx; text-align: center; display: block; margin-top: 12rpx; }
.sheet-mask { position: fixed; inset: 0; background: rgba(0,0,0,.55); display: flex; align-items: flex-end; z-index: 60; }
.sheet { background: #fff; width: 100%; border-radius: 24rpx 24rpx 0 0; padding: 24rpx; box-sizing: border-box; }
.sheet-t { font-size: 28rpx; font-weight: 800; display: block; margin-bottom: 16rpx; }
.pkg { display: flex; align-items: center; justify-content: space-between; background: #fafafa; border: 1rpx solid #eee; border-radius: 16rpx; padding: 18rpx; margin-bottom: 12rpx; }
.pkg.hl { background: rgba(201,162,75,.12); border-color: #C9A24B; }
.pkg-l { flex: 1; }
.pkg-name { font-size: 26rpx; font-weight: 700; display: block; }
.pkg-desc { font-size: 20rpx; color: #888; margin-top: 4rpx; display: block; }
.pkg-price { font-size: 34rpx; font-weight: 800; color: #C9A24B; white-space: nowrap; }
.pkg-unit { font-size: 20rpx; color: #999; font-weight: 400; }
.sheet-close { display: block; text-align: center; color: #999; font-size: 24rpx; padding: 18rpx 0 6rpx; }
