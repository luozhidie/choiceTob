<view class="page">
  <!-- 顶部 -->
  <view class="hero">
    <text class="ht">云衣橱•AI虚拟试衣 · 先试再买</text>
    <text class="hs">上传你的照片，一件件往上加：选好单品点「＋加这件」，真人照上就多一件，叠到满意为止。</text>
    <text class="pkg-link" bindtap="openPackages">试衣套餐 / 续费 ›</text>
  </view>
  <view wx:if="{{promo}}" class="promo">扫码专享 · 新人首单 ¥9.9 试穿一整套</view>

  <!-- 普通版 / 专业版 切换 -->
  <view class="mode-tabs">
    <view class="mode-tab {{!proMode?'on':''}}" bindtap="switchToBasic">普通版</view>
    <view class="mode-tab {{proMode?'on':''}}" bindtap="switchToPro">专业版</view>
  </view>

  <view class="pass-bar" bindtap="openPackages">
    <text class="pass-t">{{passText}}</text>
    <text class="pass-go">{{isPass ? '管理' : '去开通'}} ›</text>
  </view>
  <view class="history-entry" bindtap="goHistory">
    <text class="he-t">我的试衣记录 ›</text>
    <text class="he-d">最近 7 天可回看</text>
  </view>

  <!-- ① 上传照片 -->
  <view class="card">
    <text class="ct">① 上传你的照片（第 1 件试穿对象）</text>
    <text class="hint" style="margin-bottom:12rpx;">建议用高清正脸半身照，原图越清晰，叠穿后越不易丢细节。</text>
    <view class="me-row">
      <view class="me-pic" bindtap="choosePerson">
        <image wx:if="{{personPath}}" src="{{personPath}}" mode="aspectFill" class="me-img"/>
        <text wx:else class="me-ph">上传\n照片</text>
      </view>
      <view class="me-info">
        <text class="hint">仅用于本次试穿，不会公开。试衣为 AI 合成效果，仅供参考。</text>
        <text wx:if="{{!proMode}}" class="pro-entry" bindtap="togglePro">想要更懂你的穿衣风格？升级专业版 ›</text>
        <text wx:if="{{proMode}}" class="pro-entry on" bindtap="togglePro">‹ 返回极简模式</text>
      </view>
    </view>
    <view class="auth-row" bindtap="toggleAuth">
      <view class="ck {{agreedAuth ? 'on' : ''}}">{{agreedAuth ? '✓' : ''}}</view>
      <text class="auth-t">我已同意《肖像使用授权》：照片仅用于本次 AI 试衣合成，不外传、不公开</text>
    </view>
  </view>

  <!-- ② 画布 -->
  <view class="card">
    <view style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8rpx;">
      <text class="ct" style="margin:0;">② 我的造型画布</text>
      <text style="font-size:24rpx;color:#C9A24B;">已穿 {{stack.length}} 件</text>
    </view>
    <view style="width:100%;aspect-ratio:3/4;border-radius:12rpx;background:#16100f;border:1rpx solid #4a3840;overflow:hidden;display:flex;align-items:center;justify-content:center;">
      <image wx:if="{{canvasUrl}}" src="{{canvasUrl}}" mode="widthFix" style="width:100%;"/>
      <image wx:elif="{{personPath}}" src="{{personPath}}" mode="aspectFill" style="width:100%;height:100%;"/>
      <text wx:else style="color:#8a7580;font-size:26rpx;">上传照片后，这里显示你的实时造型</text>
    </view>
    <view style="display:flex;gap:16rpx;margin-top:16rpx;">
      <text style="flex:1;text-align:center;padding:18rpx 0;border-radius:10rpx;border:1rpx solid #4a3840;color:{{stack.length===0?'#6b5560':'#f3ece9'}};font-size:26rpx;" bindtap="undo">↶ 撤销一件</text>
      <text style="flex:1;text-align:center;padding:18rpx 0;border-radius:10rpx;border:1rpx solid #4a3840;color:{{stack.length===0?'#6b5560':'#f3ece9'}};font-size:26rpx;" bindtap="resetCanvas">清空重来</text>
    </view>
    <scroll-view wx:if="{{stack.length>0}}" scroll-x class="tray-scroll" show-scrollbar="{{false}}" style="margin-top:16rpx;">
      <view wx:for="{{stack}}" wx:key="id" style="position:relative;display:inline-block;width:88rpx;height:116rpx;border-radius:8rpx;overflow:hidden;margin-right:12rpx;border:1rpx solid #4a3840;">
        <image src="{{item.resultUrl}}" mode="cover" style="width:100%;height:100%;"/>
        <text style="position:absolute;top:2rpx;left:4rpx;background:rgba(0,0,0,.6);color:#C9A24B;font-size:18rpx;padding:0 8rpx;border-radius:6rpx;">{{index+1}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- 普通版：上传我的衣服图 + 全部商品网格 -->
  <block wx:if="{{!proMode}}">
    <view class="card">
      <text class="ct">③ 上传我自己的衣服（直接叠上去）</text>
      <view class="cloth-row">
        <view class="cloth-pic" bindtap="chooseCloth">
          <text class="cloth-ph">上传\n衣服</text>
        </view>
        <view class="cloth-info">
          <text class="hint">上传你想试穿的衣服照片（正面平铺/挂拍效果最佳），会自动叠到你的造型上。</text>
        <text class="hint" style="margin-top:6rpx;color:#aaa;">鞋 · 包 · 配饰由 AI 创意合成，比例位置仅供参考。</text>
          <text class="shop-entry" bindtap="openShopPick">从店铺挑选也行 ›</text>
        </view>
      </view>
      <block wx:if="{{showShopPick}}">
        <scroll-view scroll-x class="chips" show-scrollbar="{{false}}" wx:if="{{categories.length}}">
          <text class="chip {{category===''?'on':''}}" data-c="" bindtap="setCategory">全部</text>
          <text wx:for="{{categories}}" wx:key="code" class="chip {{category===item.code?'on':''}}" data-c="{{item.code}}" bindtap="setCategory">{{item.name}}</text>
        </scroll-view>
        <view class="grid3">
          <view wx:for="{{browseProducts}}" wx:key="id" class="pcard">
            <image src="{{item.cover}}" mode="aspectFill" class="pimg"/>
            <text class="ptitle">{{item.title}}</text>
            <text class="pprice">¥{{item.price}}</text>
            <text wx:if="{{item.category==='shoes'||item.category==='bag'||item.category==='accessory'}}" class="hint" style="color:#bbb;">AI 合成 · 比例仅供参考</text>
            <text class="pbtn" data-id="{{item.id}}" bindtap="addOne">＋ 加这件</text>
          </view>
        </view>
        <text class="close-shop" bindtap="closeShopPick">‹ 收起店铺挑选</text>
      </block>
    </view>

    <view class="card">
      <text class="ct">挑单品 · 一件件加</text>
      <view class="grid3">
          <view wx:for="{{products}}" wx:key="id" class="pcard">
            <image src="{{item.cover}}" mode="aspectFill" class="pimg"/>
            <text class="ptitle">{{item.title}}</text>
            <text class="pprice">¥{{item.price}}</text>
            <text wx:if="{{item.category==='shoes'||item.category==='bag'||item.category==='accessory'}}" class="hint" style="color:#bbb;">AI 合成 · 比例仅供参考</text>
            <text class="pbtn" data-id="{{item.id}}" bindtap="addOne">＋ 加这件</text>
          </view>
      </view>
    </view>
  </block>

  <!-- 专业版：形象 + tabs -->
  <block wx:if="{{proMode}}">
    <view class="card">
      <text class="ct">我的形象（色彩季型 + 穿衣风格）</text>
      <text class="lab">色彩季型</text>
      <scroll-view scroll-x class="chips" show-scrollbar="{{false}}">
        <text wx:for="{{seasons}}" wx:key="code" class="chip {{mySeason===item.code?'on':''}}" data-c="{{item.code}}" bindtap="setMySeason">{{item.name_zh}}</text>
      </scroll-view>
      <text class="lab">穿衣风格（主风格）</text>
      <scroll-view scroll-x class="chips" show-scrollbar="{{false}}">
        <text wx:for="{{mainStyles}}" wx:key="code" class="chip {{myStyle===item.code?'on':''}}" data-c="{{item.code}}" bindtap="setMyStyle">{{item.gender==='women'?'女':'男'}}·{{item.name_zh}}</text>
      </scroll-view>
    </view>

    <view class="tabs">
      <text class="tab {{mode==='browse'?'on':''}}" data-m="browse" bindtap="setMode">挑单品</text>
      <text class="tab {{mode==='manual'?'on':''}}" data-m="manual" bindtap="setMode">手工组合</text>
      <text class="tab {{mode==='closet'?'on':''}}" data-m="closet" bindtap="setMode">我的衣橱</text>
      <text class="tab {{mode==='auto'?'on':''}}" data-m="auto" bindtap="setMode">按形象生成</text>
    </view>

      <view wx:if="{{mode==='browse'}}" class="grid3">
        <view wx:for="{{products}}" wx:key="id" class="pcard">
          <image src="{{item.cover}}" mode="aspectFill" class="pimg"/>
          <text class="ptitle">{{item.title}}</text>
          <text class="pprice">¥{{item.price}}</text>
          <text wx:if="{{item.category==='shoes'||item.category==='bag'||item.category==='accessory'}}" class="hint" style="color:#bbb;">AI 合成 · 比例仅供参考</text>
          <text class="pbtn" data-id="{{item.id}}" bindtap="addOne">＋ 加这件</text>
        </view>
      </view>

    <view wx:if="{{mode==='manual'}}">
      <scroll-view scroll-x class="chips" show-scrollbar="{{false}}">
        <text class="chip {{filterSeason===''?'on':''}}" data-c="" bindtap="setFilter">全部风格</text>
        <text wx:for="{{seasons}}" wx:key="code" class="chip {{filterSeason===item.code?'on':''}}" data-c="{{item.code}}" bindtap="setFilter">{{item.name_zh}}</text>
      </scroll-view>
      <view class="grid3">
        <view wx:for="{{browseProducts}}" wx:key="id" class="pcard">
          <image src="{{item.cover}}" mode="aspectFill" class="pimg"/>
          <text class="ptitle">{{item.title}}</text>
          <text class="pprice">¥{{item.price}}</text>
          <text wx:if="{{item.category==='shoes'||item.category==='bag'||item.category==='accessory'}}" class="hint" style="color:#bbb;">AI 合成 · 比例仅供参考</text>
          <text class="pbtn" data-id="{{item.id}}" bindtap="addOne">＋ 加这件</text>
        </view>
      </view>
    </view>

    <view wx:if="{{mode==='closet'}}" class="closet-box">
      <text class="cl-tip">上传你自己的衣服 / 配饰 / 鞋 / 包，参与 AI 搭配；试穿时也能直接试你自己的衣服。</text>
      <view class="cl-upload" bindtap="uploadToCloset"><text>＋ 上传单品到衣橱</text></view>
      <view class="grid3">
        <view wx:for="{{closetItems}}" wx:key="id" class="pcard">
          <image src="{{item.image_url}}" mode="aspectFill" class="pimg"/>
          <text class="ptitle">{{item.catName}}</text>
          <view class="cl-acts">
            <text class="cl-add" data-id="{{item.id}}" bindtap="addOne">＋ 加</text>
            <text class="cl-del" data-id="{{item.id}}" bindtap="delCloset">删除</text>
          </view>
        </view>
      </view>
      <view wx:if="{{closetItems.length===0}}" class="empty">衣橱空空，先上传你的单品吧</view>
    </view>

    <view wx:if="{{mode==='auto'}}" class="auto-box">
      <text class="auto-tip">基于你选的穿衣风格，自动挑出最匹配单品，点「＋加这件」逐件穿上身。</text>
      <text class="auto-btn" bindtap="autoGenerate">✨ 按我的形象挑单品</text>
      <view class="grid3">
        <view wx:for="{{recommend}}" wx:key="id" class="pcard">
          <image src="{{item.cover}}" mode="aspectFill" class="pimg"/>
          <text class="ptitle">{{item.title}}</text>
          <text wx:if="{{item.category==='shoes'||item.category==='bag'||item.category==='accessory'}}" class="hint" style="color:#bbb;">AI 合成 · 比例仅供参考</text>
          <text class="pbtn" data-id="{{item.id}}" bindtap="addOne">＋ 加这件</text>
        </view>
      </view>
      <view wx:if="{{recommend.length===0}}" class="empty">点上方按钮，让 AI 按你的风格挑单品</view>
    </view>
  </block>

  <!-- 保存最终结果 -->
  <view wx:if="{{canvasUrl}}" class="card" style="margin-top:12rpx;">
    <text class="pbtn" style="display:block;text-align:center;background:#C9A24B;color:#1c111d;padding:20rpx 0;border-radius:10rpx;" bindtap="saveResult">保存 / 查看最终造型大图</text>
  </view>

  <!-- 套餐面板 -->
  <view wx:if="{{showPackages}}" class="sheet-mask" bindtap="closePackages">
    <view class="sheet" catchtap="noop">
      <text class="sheet-t">选择试衣套餐</text>
      <view wx:for="{{packages}}" wx:key="id" class="pkg {{item.highlight ? 'hl' : ''}}" data-id="{{item.id}}" bindtap="buyPackage">
        <view class="pkg-l">
          <text class="pkg-name">{{item.name}}{{item.highlight ? ' · 新人' : ''}}</text>
          <text class="pkg-desc">{{item.desc}}</text>
        </view>
        <text class="pkg-price">¥{{item.price}}</text>
      </view>
      <text class="sheet-close" bindtap="closePackages">关闭</text>
    </view>
  </view>
</view>
