<view class="page">
  <!-- 顶部 -->
  <view class="hero">
    <text class="ht">整体造型 · Look Studio</text>
    <text class="hs">把打过「色彩季型×穿衣风格」标签的服装，试穿到与你季型/风格匹配的你身上</text>
    <text class="pkg-link" bindtap="openPackages">试衣套餐 / 续费 ›</text>
  </view>
  <view wx:if="{{promo}}" class="promo">扫码专享 · 新人首单体验 ¥1 试穿一整套</view>
  <view class="pass-bar" bindtap="openPackages">
    <text class="pass-t">{{passText}}</text>
    <text class="pass-go">{{isPass ? '管理' : '去开通'}} ›</text>
  </view>

  <!-- 我的形象 -->
  <view class="card">
    <text class="ct">① 我的形象（试穿对象）</text>
    <view class="me-row">
      <view class="me-pic" bindtap="choosePerson">
        <image wx:if="{{personPath}}" src="{{personPath}}" mode="aspectFill" class="me-img"/>
        <text wx:else class="me-ph">上传\n照片</text>
      </view>
      <view class="me-info">
        <text class="lab">色彩季型</text>
        <scroll-view scroll-x class="chips" show-scrollbar="{{false}}">
          <text wx:for="{{seasons}}" wx:key="code" class="chip {{mySeason===item.code?'on':''}}" data-c="{{item.code}}" bindtap="setMySeason">{{item.name_zh}}</text>
        </scroll-view>
        <text class="lab">穿衣风格（主风格）</text>
        <scroll-view scroll-x class="chips" show-scrollbar="{{false}}">
          <text wx:for="{{mainStyles}}" wx:key="code" class="chip {{myStyle===item.code?'on':''}}" data-c="{{item.code}}" bindtap="setMyStyle">{{item.gender==='women'?'女':'男'}}·{{item.name_zh}}</text>
        </scroll-view>
      </view>
    </view>
  </view>

  <!-- 模式 Tab -->
  <view class="tabs">
    <text class="tab {{mode==='look'?'on':''}}" data-m="look" bindtap="setMode">造型</text>
    <text class="tab {{mode==='buyer'?'on':''}}" data-m="buyer" bindtap="setMode">买手</text>
    <text class="tab {{mode==='manual'?'on':''}}" data-m="manual" bindtap="setMode">手工组合</text>
    <text class="tab {{mode==='auto'?'on':''}}" data-m="auto" bindtap="setMode">按风格生成</text>
  </view>

  <!-- 造型 -->
  <view wx:if="{{mode==='look'}}" class="grid2">
    <view wx:for="{{lookCards}}" wx:key="code" class="lcard">
      <text class="lname">{{item.gender==='women'?'女·':'男·'}}{{item.name_zh}} 风格造型</text>
      <view class="lrow">
        <image wx:for="{{item.items}}" wx:for-item="it" wx:key="id" src="{{it.cover}}" mode="aspectFill" class="limg"/>
      </view>
      <text class="lbtn" data-code="{{item.code}}" bindtap="loadLook">装入我的造型 →</text>
    </view>
    <view wx:if="{{lookCards.length===0}}" class="empty">暂无足够商品，去「手工组合」挑选</view>
  </view>

  <!-- 买手 -->
  <view wx:if="{{mode==='buyer'}}">
    <scroll-view scroll-x class="chips" show-scrollbar="{{false}}">
      <text wx:for="{{mainStyles}}" wx:key="code" class="chip {{buyerStyle===item.code?'on':''}}" data-c="{{item.code}}" bindtap="setBuyer">{{item.gender==='women'?'女·':'男·'}}{{item.name_zh}} 买手</text>
    </scroll-view>
    <view class="grid3">
      <view wx:for="{{buyerProducts}}" wx:key="id" class="pcard">
        <image src="{{item.cover}}" mode="aspectFill" class="pimg"/>
        <text class="ptitle">{{item.title}}</text>
        <view class="ptags">
          <text wx:for="{{item.seasonNames}}" wx:for-item="sn" wx:key="*this" class="tg s">{{sn}}</text>
          <text wx:for="{{item.styleNames}}" wx:for-item="st" wx:key="*this" class="tg t">{{st}}</text>
        </view>
        <text class="pbtn" data-id="{{item.id}}" bindtap="addTray">加入造型</text>
      </view>
    </view>
    <view wx:if="{{buyerProducts.length===0}}" class="empty">该买手暂无匹配商品</view>
  </view>

  <!-- 手工组合 -->
  <view wx:if="{{mode==='manual'}}">
    <scroll-view scroll-x class="chips" show-scrollbar="{{false}}">
      <text class="chip {{filterSeason===''?'on':''}}" data-c="" bindtap="setFilter">全部季型</text>
      <text wx:for="{{seasons}}" wx:key="code" class="chip {{filterSeason===item.code?'on':''}}" data-c="{{item.code}}" bindtap="setFilter">{{item.name_zh}}</text>
    </scroll-view>
    <view class="grid3">
      <view wx:for="{{browseProducts}}" wx:key="id" class="pcard">
        <image src="{{item.cover}}" mode="aspectFill" class="pimg"/>
        <text class="ptitle">{{item.title}}</text>
        <view class="ptags">
          <text wx:for="{{item.seasonNames}}" wx:for-item="sn" wx:key="*this" class="tg s">{{sn}}</text>
          <text wx:for="{{item.styleNames}}" wx:for-item="st" wx:key="*this" class="tg t">{{st}}</text>
        </view>
        <text class="pbtn" data-id="{{item.id}}" bindtap="addTray">加入造型</text>
      </view>
    </view>
  </view>

  <!-- 按风格生成 -->
  <view wx:if="{{mode==='auto'}}" class="auto-box">
    <text class="auto-tip">基于你在「我的形象」选择的季型与风格，自动挑出最匹配单品组成完整造型。</text>
    <text class="auto-btn" bindtap="autoGenerate">✨ 一键生成我的专属造型</text>
    <view class="tray-prev" wx:if="{{tray.length>0}}">
      <image wx:for="{{tray}}" wx:key="id" src="{{item.cover}}" mode="aspectFill" class="tp-img"/>
    </view>
  </view>

  <!-- 我的造型 底栏 -->
  <view class="tray-bar">
    <scroll-view scroll-x class="tray-scroll" show-scrollbar="{{false}}">
      <text wx:if="{{tray.length===0}}" class="tray-empty">「我的造型」空空如也</text>
      <view wx:for="{{tray}}" wx:key="id" class="tray-item">
        <image src="{{item.cover}}" mode="aspectFill" class="ti-img"/>
        <text class="ti-x" data-id="{{item.id}}" catchtap="removeTray">×</text>
      </view>
    </scroll-view>
    <text class="try-btn" bindtap="doTryOn">{{loading?'生成中…':'试穿 (' + tray.length + '件/' + tray.length + ' credit)'}}</text>
  </view>

  <!-- 结果弹层 -->
  <view wx:if="{{showResult}}" class="mask" bindtap="closeResult">
    <view class="result" catchtap="noop">
      <text class="rc">整体造型已生成 · 消耗 {{resultCredits}} credit</text>
      <image src="{{resultUrl}}" mode="widthFix" class="rimg" bindtap="previewResult"/>
      <text class="save-btn" catchtap="saveResult">保存到相册（高清）</text>
      <text class="close-tip" catchtap="closeResult">点击空白处关闭</text>
    </view>
  </view>

  <!-- 套餐面板 -->
  <view wx:if="{{showPackages}}" class="sheet-mask" bindtap="closePackages">
    <view class="sheet" catchtap="noop">
      <text class="sheet-t">选择试衣套餐</text>
      <view wx:for="{{packages}}" wx:key="id" class="pkg {{item.highlight ? 'hl' : ''}}" data-id="{{item.id}}" bindtap="buyPackage">
        <view class="pkg-l">
          <text class="pkg-name">{{item.name}}{{item.highlight ? ' · 新人' : ''}}</text>
          <text class="pkg-desc">{{item.desc}}</text>
        </view>
        <text class="pkg-price">¥{{item.price}}<text class="pkg-unit">/{{item.unit}}</text></text>
      </view>
      <text class="sheet-close" bindtap="closePackages">关闭</text>
    </view>
  </view>
</view>
