<view class="page">
  <!-- Hero -->
  <view class="hero">
    <text class="h-icon">👑</text>
    <text class="h-title">骆芷蝶 · VIP会员</text>
    <text class="h-desc">企划定品控方向，严选稳货源</text>
  </view>

  <!-- 当前会员状态 -->
  <view class="status-card" wx:if="{{isMember}}">
    <view class="sc-left">
      <text class="sc-type">{{memberLabel}}</text>
      <text class="sc-exp">有效期至 {{expireDate}}</text>
    </view>
    <view class="sc-badge">✓ 已开通</view>
  </view>

  <!-- ═════ 两条代理赛道 ══════ -->
  <view class="guide-section">
    <text class="guide-title">两种会员方式</text>
    <text class="guide-sub">认证会员可先看会员价；会员折扣与退换额度按所选赛道生效</text>
    <view class="guide-cards">
      <!-- 998 合作代理开通（公开入口：非代理可见，购买后成为代理解锁试衣） -->
      <view class="gc-card gc-pay" bindtap="buyTryonAgent">
        <view class="gc-icon"><text>{{showTryonAgent?'试':'代'}}</text></view>
        <text class="gc-name">{{showTryonAgent?'虚拟试衣会员':'成为合作代理'}}</text>
        <text class="gc-sub">¥998 开通 · 享会员店铺专属价与权益</text>
        <view class="gc-features">
          <text class="gc-f">✓ 单件发货 3.3 折</text><text class="gc-f">✓ 满 5 件 2.8 折</text><text class="gc-f">✓ 赠 100 次专属额度</text>
        </view>
        <view class="gc-btn gc-btn-main">{{showTryonAgent?'继续使用 ›':'立即开通 ↓'}}</view>
      </view>
      <!-- 直接充值（旧·预存货款） -->
      <view class="gc-card gc-pay" bindtap="scrollToDeposit" style="margin-top:16rpx;background:rgba(201,162,75,.08);">
        <view class="gc-icon"><text>充</text></view>
        <text class="gc-name">预存货款会员</text>
        <text class="gc-sub">充值即同时享折扣+退换额度</text>
        <view class="gc-features">
          <text class="gc-f">✓ 退换额度</text><text class="gc-f">✓ 会员折扣</text><text class="gc-f">✓ 优先发货</text>
        </view>
        <view class="gc-btn gc-btn-main">选套餐 ↓</view>
      </view>
    </view>
  </view>

  <!-- 会员升级进度（锚点 id="deposit"） -->
  <view id="deposit" class="plans">
    <!-- 代理中心入口 -->
    <view class="agent-center-card {{isAgent?'ace-active':''}}" bindtap="goAgentCenter">
      <view class="ace-left">
        <text class="ace-tag">AGENT</text>
        <text class="ace-title">权益中心</text>
        <text class="ace-desc">{{isAgent?'已开通会员店铺 · 享专属价 · 分享搭配':'购买 ¥998 专业版或充值货款，即可开通会员店铺享专属价'}}</text>
      </view>
      <view class="ace-btn">{{isAgent?'进入 ›':'去开通 ›'}}</view>
    </view>

    <!-- 998 虚拟试衣会员套餐 -->
    <block wx:if="{{showTryonAgent}}">
    <view class="deposit-header"><text class="dh-title">虚拟试衣会员</text><text class="dh-sub">¥998 开通 · 无需预存</text></view>
    <view class="plan-card pc-hl" wx:if="{{tryonAgentPlan}}">
      <view class="pc-tag">推荐</view>
      <text class="pc-name">{{tryonAgentPlan.name}}</text>
      <text class="pc-price">{{tryonAgentPlan.priceLabel}}</text>
      <text class="pc-desc">{{tryonAgentPlan.discountLabel}}</text>
      <view class="pc-features">
        <text class="pc-f" wx:for="{{tryonAgentPlan.features}}" wx:key="*this" wx:for-item="feat">✓ {{feat}}</text>
      </view>
      <view class="pc-btn" bindtap="buyTryonAgent">立即开通</view>
    </view>
    </block>

    <!-- 充值会员套餐 -->
    <view class="deposit-header" style="margin-top:24rpx;"><text class="dh-title">充值会员套餐</text><text class="dh-sub">充值即得 折扣权 + 退换额度</text></view>

    <view class="plan-card {{item.highlight?'pc-hl':''}}" wx:for="{{depositPlans}}" wx:key="id">
      <view class="pc-tag" wx:if="{{item.highlight}}">推荐</view>
      <text class="pc-name">{{item.name}}</text>
      <text class="pc-price">{{item.priceLabel}}</text>
      <text class="pc-desc">{{item.discountLabel}}</text>
      <view class="pc-features">
        <text class="pc-f" wx:for="{{item.features}}" wx:key="*this" wx:for-item="feat">✓ {{feat}}</text>
      </view>
      <view class="pc-btn" bindtap="selectPlan" data-plan="{{item}}">立即充值</view>
    </view>
  </view>

  <!-- 支付弹窗 -->
  <view class="modal-mask" wx:if="{{showPay}}" bindtap="closePay">
    <view class="modal" catchtap="noop">
      <view class="modal-close" bindtap="closePay">✕</view>
      <text class="m-title">联系顾问充值</text>
      <text class="m-name">{{selectedPlan.name}}</text>
      <text class="m-price">{{selectedPlan.priceLabel}}</text>
      <text class="m-tip">预存货款为线下对公入账，由顾问确认后开通</text>
      <view class="mwx"><text class="mwxl">顾问微信</text><text class="mwxv" user-select="true">{{advisorWx}}</text></view>
      <view class="m-btn" bindtap="copyAdvisor">复制微信号</view>
    </view>
  </view>
</view>
