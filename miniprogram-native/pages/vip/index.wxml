<view class="page">
  <!-- Hero -->
  <view class="hero">
    <text class="h-icon">👑</text>
    <text class="h-title">{{vipCopy.hero.title}}</text>
    <text class="h-desc">{{vipCopy.hero.subtitle}}</text>
  </view>

  <!-- 当前会员状态 -->
  <view class="status-card" wx:if="{{isMember}}">
    <view class="sc-left">
      <text class="sc-type">{{memberLabel}}</text>
      <text class="sc-exp">有效期至 {{expireDate}}</text>
    </view>
    <view class="sc-badge">✓ 已开通</view>
  </view>

  <!-- ═════ 两条代理赛道 ══════ -->
  <view class="guide-section">
    <text class="guide-title">{{vipCopy.guideSection.title}}</text>
    <text class="guide-sub">{{vipCopy.guideSection.subtitle}}</text>
    <view class="guide-cards">
      <!-- 998 合作代理开通（公开入口：非代理可见，购买后成为代理解锁试衣） -->
      <view class="gc-card gc-pay" bindtap="buyTryonAgent">
        <view class="gc-icon"><text>{{showTryonAgent?vipCopy.tryonCard.icon:vipCopy.tryonCard.inactiveIcon}}</text></view>
        <text class="gc-name">{{showTryonAgent?vipCopy.tryonCard.nameActive:vipCopy.tryonCard.nameInactive}}</text>
        <text class="gc-sub">{{vipCopy.tryonCard.sub}}</text>
        <view class="gc-features">
          <text wx:for="{{vipCopy.tryonCard.features}}" wx:key="*this" wx:for-item="f" class="gc-f">✓ {{f}}</text>
        </view>
        <view class="gc-btn gc-btn-main">{{showTryonAgent?vipCopy.tryonCard.btnActive:vipCopy.tryonCard.btnInactive}}</view>
      </view>
      <!-- 直接充值（旧·预存货款） -->
      <view class="gc-card gc-pay" bindtap="scrollToDeposit" style="margin-top:16rpx;background:rgba(201,162,75,.08);">
        <view class="gc-icon"><text>{{vipCopy.depositCard.icon}}</text></view>
        <text class="gc-name">{{vipCopy.depositCard.name}}</text>
        <text class="gc-sub">{{vipCopy.depositCard.sub}}</text>
        <view class="gc-features">
          <text wx:for="{{vipCopy.depositCard.features}}" wx:key="*this" wx:for-item="f" class="gc-f">✓ {{f}}</text>
        </view>
        <view class="gc-btn gc-btn-main">{{vipCopy.depositCard.btn}}</view>
      </view>
    </view>
  </view>

  <!-- 会员升级进度（锚点 id="deposit"） -->
  <view id="deposit" class="plans">
    <!-- 代理中心入口 -->
    <view class="agent-center-card {{isAgent?'ace-active':''}}" bindtap="goAgentCenter">
      <view class="ace-left">
        <text class="ace-tag">{{vipCopy.agentCenter.tag}}</text>
        <text class="ace-title">{{vipCopy.agentCenter.title}}</text>
        <text class="ace-desc">{{isAgent?vipCopy.agentCenter.descActive:vipCopy.agentCenter.descInactive}}</text>
      </view>
      <view class="ace-btn">{{isAgent?vipCopy.agentCenter.btnActive:vipCopy.agentCenter.btnInactive}}</view>
    </view>

    <!-- 998 虚拟试衣会员套餐 -->
    <block wx:if="{{showTryonAgent}}">
    <view class="deposit-header"><text class="dh-title">{{vipCopy.tryonHeader.title}}</text><text class="dh-sub">{{vipCopy.tryonHeader.sub}}</text></view>
    <view class="plan-card pc-hl" wx:if="{{tryonAgentPlan}}">
      <view class="pc-tag">推荐</view>
      <text class="pc-name">{{tryonAgentPlan.name}}</text>
      <text class="pc-price">{{tryonAgentPlan.priceLabel}}</text>
      <text class="pc-desc">{{tryonAgentPlan.discountLabel}}</text>
      <view class="pc-features">
        <text class="pc-f" wx:for="{{tryonAgentPlan.features}}" wx:key="*this" wx:for-item="feat">✓ {{feat}}</text>
      </view>
      <view class="pc-btn" bindtap="buyTryonAgent">{{vipCopy.tryonPlan.btn}}</view>
    </view>
    </block>

    <!-- 充值会员套餐 -->
    <view class="deposit-header" style="margin-top:24rpx;"><text class="dh-title">{{vipCopy.depositHeader.title}}</text><text class="dh-sub">{{vipCopy.depositHeader.sub}}</text></view>

    <view class="plan-card {{item.highlight?'pc-hl':''}}" wx:for="{{depositPlans}}" wx:key="id">
      <view class="pc-tag" wx:if="{{item.highlight}}">推荐</view>
      <text class="pc-name">{{item.name}}</text>
      <text class="pc-price">{{item.priceLabel}}</text>
      <text class="pc-desc">{{item.discountLabel}}</text>
      <view class="pc-features">
        <text class="pc-f" wx:for="{{item.features}}" wx:key="*this" wx:for-item="feat">✓ {{feat}}</text>
      </view>
      <view class="pc-btn" bindtap="selectPlan" data-plan="{{item}}">{{vipCopy.depositPlanBtn}}</view>
    </view>
  </view>

  <!-- 支付弹窗 -->
  <view class="modal-mask" wx:if="{{showPay}}" bindtap="closePay">
    <view class="modal" catchtap="noop">
      <view class="modal-close" bindtap="closePay">✕</view>
      <text class="m-title">{{vipCopy.payModal.title}}</text>
      <text class="m-name">{{selectedPlan.name}}</text>
      <text class="m-price">{{selectedPlan.priceLabel}}</text>
      <text class="m-tip">{{vipCopy.payModal.tip}}</text>
      <view class="mwx"><text class="mwxl">{{vipCopy.payModal.advisorLabel}}</text><text class="mwxv" user-select="true">{{advisorWx}}</text></view>
      <view class="m-btn" bindtap="copyAdvisor">{{vipCopy.payModal.copyBtn}}</view>
    </view>
  </view>
</view>
