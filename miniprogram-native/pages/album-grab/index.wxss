page {
  padding: 24rpx;
  background: #f6f3f0;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 头部 */
.hd { margin-bottom: 24rpx; }
.h1 {
  display: block;
  font-size: 38rpx;
  font-weight: 800;
  color: #2d1b2e;
}
.sub {
  display: block;
  font-size: 24rpx;
  color: #888;
  margin-top: 8rpx;
  line-height: 1.5;
}

/* 操作按钮 */
.actions { display: flex; gap: 16rpx; margin-bottom: 16rpx; }
.btn {
  text-align: center;
  padding: 22rpx 0;
  border-radius: 40rpx;
  font-size: 27rpx;
  font-weight: 600;
}
.btn.primary { flex: 1; background: linear-gradient(135deg, #2d1b2e, #4a3a4b); color: #fff; }
.btn.ghost { flex: 0 0 30%; border: 1rpx solid #2d1b2e; color: #2d1b2e; }
.btn.link { color: #C9A24B; font-size: 25rpx; font-weight: 600; margin-top: 10rpx; }

.tip {
  font-size: 24rpx;
  color: #C9A24B;
  background: #fbf6ec;
  border: 1rpx solid #f0e3c8;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  margin-bottom: 16rpx;
}

/* 图片网格 */
.grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.cell {
  position: relative;
  width: calc((100% - 32rpx) / 3);
  height: 220rpx;
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,.05);
}
.img { width: 100%; height: 100%; }
.del {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0,0,0,.55);
  color: #fff;
  font-size: 30rpx;
  line-height: 40rpx;
  text-align: center;
}
.cap {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  text-align: center;
  font-size: 20rpx;
  color: #fff;
  background: linear-gradient(transparent, rgba(45,27,46,.75));
  padding: 8rpx 0 6rpx;
}

/* 空状态 */
.empty { text-align: center; padding: 100rpx 0; }
.ei { font-size: 80rpx; display: block; }
.et { display: block; font-size: 28rpx; color: #bbb; margin-top: 16rpx; }
.es { display: block; font-size: 23rpx; color: #ccc; margin-top: 8rpx; }

/* 底部说明 */
.foot {
  margin-top: 40rpx;
  text-align: center;
  padding: 0 8rpx 40rpx;
}
.ft { display: block; font-size: 23rpx; color: #999; line-height: 1.6; }
