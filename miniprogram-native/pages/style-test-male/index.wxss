.page { min-height: 100vh; background: #f8f6f3; padding-bottom: 40rpx; }

.intro { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 100vh; padding: 60rpx; text-align: center; background: linear-gradient(180deg, #2d1b2e 0%, #1c111d 100%); }
.intro-title { font-size: 44rpx; font-weight: 800; color: #C9A24B; margin-bottom: 16rpx; }
.intro-sub { font-size: 28rpx; color: #f3ece9; margin-bottom: 40rpx; }
.intro-desc { font-size: 26rpx; color: #b9a7ad; line-height: 1.7; margin-bottom: 60rpx; }
.intro-btn { background: #C9A24B; color: #1c111d; font-size: 30rpx; font-weight: 800; padding: 28rpx 80rpx; border-radius: 50rpx; }
.intro-back { color: #999; font-size: 26rpx; margin-top: 40rpx; }

.top-bar { position: fixed; top: 0; left: 0; right: 0; z-index: 10; background: #fff; padding: 20rpx 24rpx; display: flex; align-items: center; gap: 20rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,.06); }
.top-back { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; font-size: 36rpx; color: #333; }
.progress-wrap { flex: 1; }
.progress-track { height: 10rpx; background: #eee; border-radius: 10rpx; overflow: hidden; }
.progress-fill { height: 100%; background: #C9A24B; border-radius: 10rpx; transition: width .3s; }
.progress-text { font-size: 20rpx; color: #999; margin-top: 8rpx; display: block; text-align: right; }

.question-list { padding: 140rpx 24rpx 160rpx; height: 100vh; box-sizing: border-box; }
.q-card { background: #fff; border-radius: 24rpx; padding: 30rpx; margin-bottom: 24rpx; border: 2rpx solid transparent; }
.q-done { border-color: #C9A24B; }
.q-head { display: flex; align-items: flex-start; margin-bottom: 24rpx; }
.q-num { width: 44rpx; height: 44rpx; border-radius: 50%; background: #2d1b2e; color: #C9A24B; font-size: 24rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; margin-right: 16rpx; flex-shrink: 0; }
.q-text { font-size: 30rpx; font-weight: 700; color: #1c111d; line-height: 1.4; flex: 1; }
.q-options { display: flex; flex-wrap: wrap; gap: 16rpx; }
.opt { width: calc(50% - 8rpx); background: #f5f3f0; border-radius: 16rpx; padding: 22rpx 18rpx; display: flex; align-items: center; gap: 12rpx; border: 2rpx solid #f5f3f0; }
.opt-on { background: #fff8f0; border-color: #C9A24B; }
.opt-dot { width: 36rpx; height: 36rpx; border-radius: 50%; border: 2rpx solid #ccc; color: #fff; font-size: 20rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.opt-on .opt-dot { background: #C9A24B; border-color: #C9A24B; }
.opt-label { font-size: 26rpx; color: #333; line-height: 1.4; }

.bottom-actions { position: fixed; bottom: 0; left: 0; right: 0; background: #fff; padding: 24rpx; display: flex; gap: 20rpx; box-shadow: 0 -2rpx 12rpx rgba(0,0,0,.06); }
.act-prev { flex: 1; text-align: center; padding: 24rpx 0; border-radius: 16rpx; border: 2rpx solid #ddd; font-size: 28rpx; color: #666; }
.act-submit { flex: 2; text-align: center; padding: 24rpx 0; border-radius: 16rpx; background: #2d1b2e; color: #C9A24B; font-size: 28rpx; font-weight: 800; }

.result { min-height: 100vh; background: linear-gradient(180deg, #2d1b2e 0%, #1c111d 100%); padding: 80rpx 40rpx; display: flex; flex-direction: column; align-items: center; text-align: center; }
.res-title { font-size: 28rpx; color: #b9a7ad; margin-bottom: 20rpx; }
.res-name { font-size: 52rpx; font-weight: 800; color: #C9A24B; margin-bottom: 16rpx; }
.res-sub { font-size: 26rpx; color: #f3ece9; margin-bottom: 30rpx; opacity: .85; }
.res-desc { font-size: 28rpx; color: #f3ece9; line-height: 1.7; margin-bottom: 40rpx; text-align: left; }
.res-note { font-size: 22rpx; color: #b9a7ad; line-height: 1.7; margin-bottom: 50rpx; text-align: left; padding: 20rpx; background: rgba(255,255,255,.06); border-radius: 14rpx; }
.res-tags { display: flex; flex-wrap: wrap; justify-content: center; gap: 16rpx; margin-bottom: 80rpx; }
.res-tag { background: rgba(201,162,75,.2); color: #C9A24B; font-size: 24rpx; padding: 10rpx 22rpx; border-radius: 30rpx; border: 1rpx solid rgba(201,162,75,.4); }
.res-actions { width: 100%; display: flex; flex-direction: column; gap: 20rpx; }
.res-btn { text-align: center; padding: 28rpx 0; border-radius: 16rpx; border: 2rpx solid #C9A24B; color: #C9A24B; font-size: 28rpx; }
.res-gold { background: #C9A24B; color: #1c111d; font-weight: 800; }
.res-img { width: 100%; max-width: 560rpx; border-radius: 20rpx; margin-bottom: 30rpx; border: 2rpx solid rgba(201,162,75,.4); }
