.page{background:#f5f5f7;min-height:100vh;padding-bottom:40rpx;}
.brand{background:#fff;text-align:center;padding:56rpx 32rpx 40rpx;}
.logo{width:120rpx;height:120rpx;border-radius:28rpx;margin:0 auto 20rpx;background:linear-gradient(135deg,#c9a24b,#a87f2e);color:#fff;font-size:56rpx;font-weight:700;display:flex;align-items:center;justify-content:center;}
.b-name{font-size:38rpx;font-weight:700;color:#111;}
.b-sub{font-size:24rpx;color:#888;margin-top:10rpx;}
.b-ver{font-size:22rpx;color:#aaa;margin-top:8rpx;}
.card{background:#fff;border-radius:24rpx;margin:24rpx 24rpx 0;padding:32rpx;box-shadow:0 4rpx 16rpx rgba(0,0,0,0.04);}
.intro-p{font-size:27rpx;color:#444;line-height:1.8;margin-bottom:16rpx;}
.intro-p:last-child{margin-bottom:0;}
.card-title{font-size:30rpx;font-weight:700;color:#111;margin-bottom:24rpx;}
.adv-grid{display:flex;flex-wrap:wrap;}
.adv-item{width:50%;padding:16rpx 0;text-align:center;}
.adv-icon{font-size:44rpx;}
.adv-name{font-size:26rpx;font-weight:600;color:#222;margin-top:10rpx;}
.adv-desc{font-size:22rpx;color:#999;margin-top:4rpx;}
.scope-item{font-size:27rpx;color:#444;line-height:1.8;padding:8rpx 0;}
.scope-tip{font-size:22rpx;color:#aaa;margin-top:16rpx;line-height:1.6;}
.contact-row{display:flex;align-items:center;padding:20rpx 0;border-bottom:1rpx solid #f0f0f0;}
.contact-row:last-child{border-bottom:none;}
.c-label{width:100rpx;font-size:26rpx;color:#999;}
.c-value{flex:1;font-size:27rpx;color:#333;}
.footer{text-align:center;font-size:22rpx;color:#aaa;margin-top:40rpx;line-height:1.6;}
