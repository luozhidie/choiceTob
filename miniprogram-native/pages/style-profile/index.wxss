.page { padding: 24rpx 20rpx 0; background: #f6f3ef; min-height: 100vh; }
.hero { background: linear-gradient(135deg,#2d1b2e,#7b4dff); border-radius: 20rpx; padding: 28rpx 26rpx; margin-bottom: 18rpx; }
.ht { display: block; color: #fff; font-size: 34rpx; font-weight: 800; }
.hs { display: block; color: rgba(255,255,255,.82); font-size: 22rpx; line-height: 1.6; margin-top: 8rpx; }

.card { background: #fff; border-radius: 18rpx; padding: 22rpx 20rpx; margin-bottom: 16rpx; }
.ct { display: block; font-size: 26rpx; font-weight: 700; color: #2d1b2e; margin-bottom: 14rpx; }

.chips { display: flex; flex-wrap: wrap; gap: 14rpx; }
.chip { margin: 0; padding: 12rpx 22rpx; font-size: 23rpx; color: #555; background: #f3efe9; border: 1rpx solid #e7ded2; border-radius: 999rpx; line-height: 1.3; }
.chip::after { border: none; }
.chip.on { color: #fff; background: linear-gradient(135deg,#2d1b2e,#7b4dff); border-color: transparent; font-weight: 700; }

.gender-toggle { display: flex; gap: 14rpx; margin-bottom: 14rpx; }
.gt { margin: 0; flex: 1; text-align: center; font-size: 23rpx; color: #777; background: #f3efe9; border: 1rpx solid #e7ded2; padding: 14rpx 0; border-radius: 12rpx; line-height: 1.3; }
.gt::after { border: none; }
.gt-on { color: #fff; background: linear-gradient(135deg,#2d1b2e,#7b4dff); border-color: transparent; font-weight: 700; }
.sub-tip { display: block; font-size: 21rpx; color: #a08f74; margin-bottom: 12rpx; }
.sub-ct { display: block; font-size: 23rpx; font-weight: 700; color: #2d1b2e; margin: 18rpx 0 12rpx; }
.sub-chips { padding-top: 4rpx; }
.sub-chip { font-size: 21rpx; padding: 10rpx 18rpx; }

.row { display: flex; align-items: center; padding: 14rpx 0; border-bottom: 1rpx solid #f1ece4; }
.row:last-child { border-bottom: none; }
.lab { width: 180rpx; font-size: 24rpx; color: #666; }
.inp { flex: 1; font-size: 24rpx; color: #333; text-align: right; }

.photo-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.photo-thumb { position: relative; width: calc(33.33% - 11rpx); aspect-ratio: 3/4; background: #f3efe9; border: 2rpx dashed #d9cdb8; border-radius: 14rpx; overflow: hidden; box-sizing: border-box; }
.photo-thumb.on { border: 2rpx solid #C9A24B; }
.timg { width: 100%; height: 100%; }
.default-badge { position: absolute; top: 8rpx; left: 8rpx; background: rgba(201,162,75,.92); color: #fff; font-size: 18rpx; padding: 2rpx 10rpx; border-radius: 8rpx; }
.del-photo { position: absolute; top: 4rpx; right: 4rpx; width: 40rpx; height: 40rpx; background: rgba(0,0,0,.55); color: #fff; border-radius: 50%; font-size: 26rpx; text-align: center; line-height: 40rpx; }
.photo-thumb.add { display: flex; flex-direction: column; align-items: center; justify-content: center; background: #f8f5f1; border: 2rpx dashed #c9bdb0; }
.add-icon { font-size: 48rpx; color: #a08f74; line-height: 1; }
.add-t { font-size: 20rpx; color: #a08f74; margin-top: 8rpx; }

.save-btn { margin: 8rpx 0 20rpx; background: linear-gradient(135deg,#2d1b2e,#7b4dff); color: #fff; font-size: 30rpx; font-weight: 800; text-align: center; padding: 26rpx 0; border-radius: 16rpx; }
.bottom-pad { height: 40rpx; }
