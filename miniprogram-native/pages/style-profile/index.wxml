<view class="page">
  <view class="hero">
    <text class="ht">我的形象档案</text>
    <text class="hs">完成诊断，AI 搭配更精准：按你的色彩季型、风格、身材与常去场合生成造型。</text>
  </view>

  <view class="card">
    <text class="ct">色彩季型（选 1 个）</text>
    <view class="chips">
      <button wx:for="{{seasonTypes}}" wx:key="code" plain data-c="{{item.code}}" id="{{item.code}}" class="chip {{seasonType===item.code?'on':''}}" bindtap="setSeason">{{item.name}}</button>
    </view>
  </view>

  <view class="card">
    <text class="ct">穿衣风格（主风格 + 偏风格）</text>
    <view class="gender-toggle">
      <button class="gt {{gender==='women'?'gt-on':''}}" plain data-g="women" bindtap="setGender">女士 · 8 主风格</button>
      <button class="gt {{gender==='men'?'gt-on':''}}" plain data-g="men" bindtap="setGender">男士 · 5 主风格</button>
    </view>
    <text class="sub-tip">先选你的主风格，再叠加偏风格（可多选）</text>
    <view class="chips">
      <button wx:for="{{mainList}}" wx:key="code" plain data-c="{{item.code}}" id="{{item.code}}" class="chip {{mainStyle===item.code?'on':''}}" bindtap="toggleMain">{{item.name}}</button>
    </view>
    <view wx:if="{{mainStyle}}">
      <text class="sub-ct">{{subHeading}}</text>
      <view class="chips sub-chips">
        <button class="chip sub-chip pure {{pureSelected?'on':''}}" plain bindtap="togglePureMain">纯{{mainName}}</button>
        <button wx:for="{{subList}}" wx:key="code" plain data-c="{{item.code}}" id="{{item.code}}" class="chip sub-chip {{styleTags.indexOf(item.code)>-1?'on':''}}" bindtap="toggleSub">{{item.name}}</button>
      </view>
    </view>
  </view>

  <view class="card">
    <text class="ct">常去场合（可多选）</text>
    <view class="chips">
      <button wx:for="{{occasionsList}}" wx:key="code" plain data-c="{{item.code}}" id="{{item.code}}" class="chip {{occasions.indexOf(item.code)>-1?'on':''}}" bindtap="toggleOccasion">{{item.name}}</button>
    </view>
  </view>

  <view class="card">
    <text class="ct">身材与尺码</text>
    <view class="row"><text class="lab">身高(cm)</text><input class="inp" type="digit" value="{{height}}" data-f="height" bindinput="onInput" placeholder="如 165"/></view>
    <view class="row"><text class="lab">体重(kg)</text><input class="inp" type="digit" value="{{weight}}" data-f="weight" bindinput="onInput" placeholder="如 52"/></view>
    <view class="row"><text class="lab">上装尺码</text><input class="inp" value="{{sizes.top}}" data-k="top" bindinput="onSize" placeholder="如 M"/></view>
    <view class="row"><text class="lab">下装尺码</text><input class="inp" value="{{sizes.bottom}}" data-k="bottom" bindinput="onSize" placeholder="如 L"/></view>
    <view class="row"><text class="lab">鞋码</text><input class="inp" type="digit" value="{{sizes.shoe}}" data-k="shoe" bindinput="onSize" placeholder="如 38"/></view>
    <view class="row"><text class="lab">身材特点</text><input class="inp" value="{{bodyType}}" data-f="bodyType" bindinput="onInput" placeholder="如 梨形/沙漏型"/></view>
  </view>

  <view class="card">
    <text class="ct">全身照（用于试衣合成）</text>
    <view class="photo" bindtap="choosePhoto">
      <image wx:if="{{fullBodyPhoto}}" src="{{fullBodyPhoto}}" mode="aspectFill" class="pimg"/>
      <text wx:else class="ph">上传全身照</text>
    </view>
  </view>

  <view class="save-btn" bindtap="save">保存形象档案</view>
  <view class="bottom-pad"></view>
</view>
