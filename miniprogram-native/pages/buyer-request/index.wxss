.page{background:#f7f4f6;min-height:100vh;padding-bottom:60rpx;}
.hero{padding:40rpx 32rpx 28rpx;background:linear-gradient(135deg,#2d1b2e 0%,#4a2f4d 100%);}
.hero-title{display:block;font-size:40rpx;font-weight:800;color:#fff;letter-spacing:2rpx;}
.hero-sub{display:block;margin-top:12rpx;font-size:24rpx;color:rgba(255,255,255,.72);}

.form{padding:24rpx;}
.block{background:#fff;border-radius:20rpx;padding:26rpx 24rpx;margin-bottom:20rpx;box-shadow:0 2rpx 12rpx rgba(0,0,0,.04);}
.block-title{font-size:30rpx;font-weight:700;color:#2d1b2e;margin-bottom:18rpx;}
.block-hint{font-size:22rpx;color:#999;margin-top:12rpx;display:block;}
.row-between{display:flex;align-items:center;justify-content:space-between;margin-bottom:4rpx;}

.chips{display:flex;flex-wrap:wrap;gap:16rpx;}
.chip{padding:14rpx 26rpx;border-radius:999rpx;background:#f3eef0;border:2rpx solid #f0e6ea;font-size:26rpx;color:#555;}
.chip-on{background:#2d1b2e;color:#fff;border-color:#2d1b2e;font-weight:600;}

.budget-row{display:flex;align-items:center;gap:16rpx;}
.budget-input{flex:1;background:#f6f4f5;border-radius:12rpx;padding:18rpx 20rpx;font-size:28rpx;}
.budget-sep{color:#999;}

.textarea{width:100%;height:160rpx;background:#f6f4f5;border-radius:12rpx;padding:18rpx 20rpx;font-size:28rpx;box-sizing:border-box;}
.input{width:100%;background:#f6f4f5;border-radius:12rpx;padding:20rpx;font-size:28rpx;box-sizing:border-box;}

.submit-btn{margin-top:12rpx;background:linear-gradient(135deg,#C9A24B,#a8842f);color:#fff;font-size:32rpx;font-weight:700;border-radius:999rpx;padding:24rpx 0;border:none;}
.submit-btn[disabled]{opacity:.6;}
.foot-tip{text-align:center;font-size:22rpx;color:#aaa;margin-top:18rpx;}

/* 成功卡 */
.done-card{margin:40rpx 32rpx;background:#fff;border-radius:24rpx;padding:48rpx 40rpx;text-align:center;box-shadow:0 6rpx 24rpx rgba(0,0,0,.06);}
.done-icon{width:96rpx;height:96rpx;margin:0 auto 20rpx;border-radius:50%;background:linear-gradient(135deg,#C9A24B,#a8842f);color:#fff;font-size:52rpx;line-height:96rpx;}
.done-title{display:block;font-size:36rpx;font-weight:800;color:#2d1b2e;margin-bottom:12rpx;}
.done-desc{display:block;font-size:26rpx;color:#666;line-height:1.6;margin-bottom:28rpx;}
.done-qr{display:flex;flex-direction:column;align-items:center;margin-bottom:28rpx;}
.qr-img{width:300rpx;height:300rpx;border-radius:16rpx;background:#f6f4f5;}
.qr-tip{font-size:24rpx;color:#999;margin-top:14rpx;}
.done-btn{display:inline-block;padding:18rpx 60rpx;background:#2d1b2e;color:#fff;border-radius:999rpx;font-size:28rpx;}
