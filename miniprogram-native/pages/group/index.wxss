page { background: var(--bg); }

.hero {
  background: linear-gradient(135deg, #2d1b2e, #4a3a4b);
  color: #fff;
  padding: 44rpx 32rpx 36rpx;
  border-radius: 0 0 32rpx 32rpx;
  text-align: center;
}
.hero-title { font-size: 34rpx; font-weight: 800; }
.hero-sub { font-size: 22rpx; opacity: 0.8; margin-top: 12rpx; }

/* qr card */
.qr-card {
  background: var(--surface);
  border-radius: var(--r-md);
  margin: 24rpx;
  padding: 32rpx 24rpx;
  text-align: center;
  box-shadow: var(--sh-1);
}
.qr-tip { font-size: 24rpx; color: var(--text-2); display: block; margin-bottom: 24rpx; }
.qr-img {
  width: 360rpx;
  height: 360rpx;
  margin: 0 auto;
  background: #f7f3ee;
  border-radius: 16rpx;
}
.qr-fallback {
  width: 360rpx;
  height: 360rpx;
  margin: 0 auto;
  background: #f7f3ee;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.qr-fallback-icon { font-size: 72rpx; }
.qr-fallback-text { font-size: 24rpx; color: var(--text-2); margin-top: 12rpx; }
.qr-fallback-sub { font-size: 20rpx; color: var(--text-3); margin-top: 6rpx; }
.qr-btn {
  margin-top: 28rpx;
  background: linear-gradient(135deg, #2d1b2e, #4a3a4b);
  color: #fff;
  font-weight: 600;
  font-size: 28rpx;
  padding: 22rpx 0;
  border-radius: 40rpx;
}

/* benefits */
.card-block {
  background: var(--surface);
  border-radius: var(--r-md);
  margin: 24rpx;
  padding: 28rpx 24rpx;
  box-shadow: var(--sh-1);
}
.block-title { font-size: 30rpx; font-weight: 700; color: var(--text); display: block; margin-bottom: 16rpx; }
.benefit {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.benefit:last-child { border-bottom: none; }
.benefit-icon {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #f7f3ee;
  border-radius: 16rpx;
  font-size: 38rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}
.benefit-main { flex: 1; }
.benefit-t { font-size: 26rpx; color: var(--text); font-weight: 600; display: block; }
.benefit-d { font-size: 22rpx; color: var(--text-3); display: block; margin-top: 4rpx; }

/* empty */
.empty { text-align: center; padding: 120rpx 0; color: #ccc; }
.empty-icon { font-size: 80rpx; display: block; margin-bottom: 20rpx; }
.empty-text { font-size: 26rpx; }
.empty-btn {
  margin-top: 30rpx;
  background: #2d1b2e;
  color: #fff;
  font-size: 26rpx;
  padding: 14rpx 56rpx;
  border-radius: 40rpx;
  display: inline-block;
}
