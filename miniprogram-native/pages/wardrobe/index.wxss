.page{display:flex;flex-direction:column;padding:24rpx;background:var(--bg);min-height:100vh;box-sizing:border-box;padding-bottom:200rpx;}

/* 顶部标题 */
.hero{padding:24rpx 8rpx 16rpx;}
.hero-title{font-size:40rpx;font-weight:bold;color:#2d1b2e;}
.hero-sub{font-size:22rpx;color:#999;margin-top:8rpx;line-height:1.5;}

.loading{padding:120rpx 40rpx;text-align:center;color:#999;font-size:26rpx;}

/* 分区 */
.zone{background:#fff;border-radius:24rpx;padding:28rpx 24rpx;margin-bottom:24rpx;box-shadow:0 4rpx 16rpx rgba(0,0,0,.05);}
.zone-vip{background:linear-gradient(135deg,#2d1b2e,#4a3a5a);}
.zone-vip .zone-name{color:#C9A24B;}
.zone-vip .zone-tip{color:rgba(255,255,255,.7);}
.zone-vip .zone-empty{color:rgba(255,255,255,.5);}
.zone-vip .zone-count{color:#C9A24B;}

.zone-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:10rpx;}
.zone-name{font-size:30rpx;font-weight:bold;color:#2d1b2e;}
.zone-count{font-size:22rpx;color:#999;}
.zone-tip{font-size:22rpx;color:#999;line-height:1.5;margin-bottom:20rpx;}
.zone-empty{padding:40rpx 0;text-align:center;font-size:24rpx;color:#bbb;}

/* 图片网格 */
.grid{display:flex;flex-wrap:wrap;justify-content:space-between;}
.card{width:48%;background:#fff;border-radius:16rpx;overflow:hidden;margin-bottom:20rpx;box-shadow:0 2rpx 10rpx rgba(0,0,0,.06);position:relative;}
.card-img{width:100%;height:320rpx;background:#eee;display:block;}
.card-cat{position:absolute;top:8rpx;left:8rpx;background:rgba(0,0,0,.5);color:#fff;font-size:20rpx;padding:4rpx 12rpx;border-radius:8rpx;}
.card-note{position:absolute;bottom:0;left:0;right:0;background:rgba(0,0,0,.55);color:#fff;font-size:20rpx;padding:8rpx 12rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.del{position:absolute;top:8rpx;right:8rpx;width:40rpx;height:40rpx;border-radius:50%;background:rgba(0,0,0,.4);color:#fff;display:flex;align-items:center;justify-content:center;font-size:28rpx;z-index:2;}

/* 试衣入口条 */
.tryon-bar{margin:8rpx 8rpx 0;padding:26rpx 0;text-align:center;background:linear-gradient(90deg,#2d1b2e,#7b4dff);color:#fff;border-radius:16rpx;font-size:28rpx;font-weight:600;}

/* 上传按钮 */
.fab{position:fixed;right:40rpx;bottom:60rpx;width:96rpx;height:96rpx;border-radius:50%;background:#2d1b2e;color:#fff;font-size:48rpx;display:flex;align-items:center;justify-content:center;box-shadow:0 8rpx 24rpx rgba(45,27,46,.35);z-index:10;}

/* 顶部双 Tab */
.tabs{display:flex;background:#fff;border-radius:18rpx;padding:8rpx;margin-bottom:24rpx;box-shadow:0 4rpx 16rpx rgba(0,0,0,.05);}
.tab{flex:1;text-align:center;font-size:28rpx;color:#888;padding:18rpx 0;border-radius:14rpx;transition:all .2s;}
.tab-on{background:linear-gradient(135deg,#2d1b2e,#4a3a5a);color:#C9A24B;font-weight:bold;}

/* 按场合搭配 */
.outfit{margin-top:16rpx;}
.outfit-name{font-size:24rpx;color:#2d1b2e;font-weight:bold;margin-bottom:12rpx;padding-left:8rpx;border-left:6rpx solid #C9A24B;}

/* 每日搭配灵感区块 */
.zone-looks{display:flex;align-items:center;justify-content:space-between;background:linear-gradient(135deg,#f6efe2,#f3e6d0);border:1rpx solid #e7d3ad;}
.looks-left{display:flex;flex-direction:column;}
.looks-title{font-size:30rpx;font-weight:bold;color:#2d1b2e;}
.looks-sub{font-size:22rpx;color:#9a8358;margin-top:6rpx;line-height:1.4;max-width:480rpx;}
.looks-go{font-size:26rpx;color:#b8893f;font-weight:bold;white-space:nowrap;}

/* 搭配需求输入 */
.needs{width:100%;min-height:160rpx;background:#f7f5f2;border:1rpx solid #ececec;border-radius:14rpx;padding:20rpx;font-size:26rpx;color:#333;box-sizing:border-box;margin-top:8rpx;}
