.page { min-height: 100vh; background: #1a0f1c; padding: 0 16px 20px; box-sizing: border-box; }

.topbar { padding: 22px 4px 16px; }
.tb-title { display: block; font-size: 22px; font-weight: 800;
  background: linear-gradient(90deg, #e3c987, #C9A24B); -webkit-background-clip: text; background-clip: text; color: transparent; }
.tb-sub { display: block; font-size: 12px; color: #b9a89e; margin-top: 4px; }

.credits-bar { display: flex; align-items: center; justify-content: space-between;
  background: rgba(127,200,160,.1); border: 1px solid rgba(127,200,160,.3);
  border-radius: 14px; padding: 12px 16px; margin-bottom: 16px; }
.cb-label { font-size: 13px; color: #b9a89e; }
.cb-num { font-size: 22px; font-weight: 800; color: #7fc8a0; }

.plans { display: flex; flex-direction: column; gap: 12px; }
.plan { background: linear-gradient(160deg, #241420, #1c1019); border: 1px solid rgba(201,162,75,.25);
  border-radius: 16px; padding: 16px; }
.plan-top { display: flex; justify-content: space-between; align-items: flex-start; }
.plan-name { display: block; font-size: 16px; font-weight: 700; color: #fcefe9; }
.plan-desc { display: block; font-size: 12px; color: #b9a89e; margin-top: 3px; }
.plan-price { font-size: 22px; font-weight: 800; color: #C9A24B; white-space: nowrap; }
.plan-unit { font-size: 12px; color: #b9a89e; font-weight: 400; }
.plan-foot { display: flex; align-items: center; gap: 10px; margin-top: 14px;
  border-top: 1px solid rgba(201,162,75,.18); padding-top: 12px; }
.plan-credits { font-size: 12px; color: #f3e9df; }
.plan-sub { font-size: 11px; color: #b08ad6; flex: 1; }
.plan-buy { font-size: 13px; color: #1a0f1c; font-weight: 700; background: linear-gradient(145deg, #C9A24B, #9c7a2e);
  padding: 6px 14px; border-radius: 20px; }

.note { font-size: 11.5px; color: #b9a89e; line-height: 1.6; margin-top: 16px; padding: 0 4px; }
