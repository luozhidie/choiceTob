<view class="page">
  <!-- Hero -->
  <view class="hero">
    <text class="ht">八大风格 · 真人试穿</text>
    <text class="hs">上传你的真人照，逐一试穿八大风格代表款，用眼睛判断哪几款最像你——比问卷更直观。</text>
  </view>

  <!-- 拍照要求 -->
  <view class="tip-card">
    <text class="tip-t">拍照要求（直接影响试穿效果）</text>
    <text class="tip-li">· 正面站立，双腿自然伸直并拢，双手自然下垂（不要凹造型）</text>
    <text class="tip-li">· 全身或至少膝盖以上入镜，衣服轮廓清楚</text>
    <text class="tip-li">· 面无表情，不要笑太用力（试衣会继承你的表情）</text>
    <text class="tip-li">· 自己的衣服自然垂落，不要扎进裤/裙腰；上衣扣子全扣好</text>
    <text class="tip-li">· 不穿内搭、真空也可；下装保持原样，建议穿黑色短裙/黑裤拍摄</text>
    <text class="tip-li">· 光线均匀，背景干净（白墙/纯色最佳）</text>
  </view>

  <!-- ① 上传真人照 -->
  <view class="card">
    <text class="ct">① 上传你的真人照</text>

    <!-- 从形象档案选择已有全身照 -->
    <view wx:if="{{profilePhotos.length > 0}}" class="profile-box">
      <text class="profile-t">从形象档案选择全身照</text>
      <scroll-view scroll-x class="profile-scroll" enhanced show-scrollbar="{{false}}">
        <view class="profile-list">
          <view wx:for="{{profilePhotos}}" wx:key="*this" class="profile-item {{selectedProfileIndex === index ? 'on' : ''}}" data-index="{{index}}" bindtap="selectProfilePhoto">
            <image src="{{item}}" mode="aspectFill" class="profile-img"/>
            <view wx:if="{{selectedProfileIndex === index}}" class="profile-check">✓</view>
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="me-row">
      <view class="me-pic" bindtap="choosePerson">
        <image wx:if="{{personPath}}" src="{{personPath}}" mode="aspectFill" class="me-img"/>
        <text wx:else class="me-ph">上传\n照片</text>
      </view>
      <view class="me-info">
        <text class="hint">{{uploading ? '自动处理白底中…' : (personUrl ? '已处理白底，可开始试穿' : (profilePhotos.length ? '点击上方形象档案照片，或左侧重新上传' : '点击上传正面、光线良好的半身/全身照'))}}</text>
      </view>
    </view>
  </view>

  <!-- ② 开始试穿 -->
  <view class="card">
    <text class="ct">② 开始 8 套试穿</text>
    <text class="hint" style="margin-bottom:12rpx;">每件风格衣调用一次试衣（约 15–40 秒），共 8 张，请保持页面打开。</text>
    <view wx:if="{{!checking && proLeft <= 0}}" class="hint" style="color:#C9A24B;margin-bottom:12rpx;">你还没有专业版权益，开通 ¥998 专业版后即可试穿 8 大风格。</view>
    <view wx:elif="{{proLeft > 0}}" class="hint" style="color:#C9A24B;margin-bottom:12rpx;">剩余专业次数：{{proLeft}} 次</view>
    <view class="btn {{running || checking ? 'disabled' : ''}}" bindtap="startTryon">
      {{running ? ('试穿中 ' + doneCount + '/8…') : (checking ? '检查权益中…' : (proLeft <= 0 ? '开通专业版 ¥998' : (!personPath ? '请先上传真人照' : (uploading ? '白底处理中…' : (personUrl ? '开始 8 套风格试穿' : '处理白底后开始')))))}}
    </view>
  </view>

  <!-- ③ 结果网格 -->
  <view wx:if="{{results.length > 0 && (running || doneCount > 0)}}" class="card">
    <text class="ct">③ 试穿效果（点选最适合你的，最多 2 个）</text>
    <view class="grid">
      <view wx:for="{{results}}" wx:key="id" class="gcard {{selected.indexOf(item.id) >= 0 ? 'on' : ''}} {{item.url ? 'tap' : ''}}" data-id="{{item.id}}" bindtap="toggleSelect">
        <view class="gimg-box">
          <image wx:if="{{item.url}}" src="{{item.url}}" mode="aspectFill" class="gimg"/>
          <text wx:elif="{{item.error}}" class="gerr">{{item.error}}</text>
          <text wx:else class="gloading">生成中…</text>
        </view>
        <text class="gname">{{item.name}}</text>
        <view wx:if="{{selected.indexOf(item.id) >= 0}}" class="gcheck">✓</view>
      </view>
    </view>
    <view class="hint" style="color:#C9A24B;margin-top:12rpx;">✨ AI 已自动画质增强（超分 + 锐化）</view>
  </view>

  <!-- ④ 结论 -->
  <view wx:if="{{doneCount === 8 && !running && selected.length > 0}}" class="card">
    <text class="ct">④ 我的风格结论</text>
    <view wx:if="{{!concluded}}">
      <text class="hint" style="margin-bottom:14rpx;">已选 {{selected.length}}/2 个风格</text>
      <view class="btn" bindtap="saveConclusion">生成我的风格结论</view>
    </view>
    <view wx:else class="concl">
      <text class="concl-t">最适合你的风格</text>
      <text class="concl-v">{{selectedNames}}</text>
      <text class="concl-reset" bindtap="reset">重新试穿</text>
    </view>
  </view>

  <view style="height:40rpx;"></view>
</view>
