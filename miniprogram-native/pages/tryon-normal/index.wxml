<view class="page">
  <view class="head">
    <text class="h-title">普通版</text>
    <text class="h-sub">快速看上身 · 不想研究搭配选这个</text>
  </view>
  <view class="card">
    <text class="c-h">包含</text>
    <view class="feat ok" wx:for="{{include}}" wx:key="*this">✓ {{item}}</view>
    <text class="c-h mt">不含</text>
    <view class="feat no" wx:for="{{exclude}}" wx:key="*this">— {{item}}</view>
  </view>

  <view class="price-row" bindtap="buyPackage" data-id="tryon_first_9_9">
    <view>
      <text class="pr-title">首单体验</text>
      <text class="pr-sub">5 次普通试穿</text>
    </view>
    <text class="pr-num">¥9.9</text>
  </view>
  <view class="buy-btn" bindtap="buyPackage" data-id="tryon_first_9_9">购买 ¥9.9</view>

  <view class="price-row gold" bindtap="buyPackage" data-id="tryon_normal_month_99">
    <view>
      <text class="pr-title">普通月卡</text>
      <text class="pr-sub">30 天 100 次普通试穿</text>
    </view>
    <text class="pr-num">¥99</text>
  </view>
  <view class="buy-btn gold" bindtap="buyPackage" data-id="tryon_normal_month_99">购买 ¥99</view>
</view>
