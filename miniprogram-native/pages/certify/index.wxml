<view class="page">

  <!-- ═══ Step 1: 开场 ═══ -->
  <block wx:if="{{step==='intro'}}">
    <view class="hero">
      <text class="hero-badge">{{pageCopy.intro.badge}}</text>
      <text class="hero-title">{{pageCopy.intro.title}}</text>
      <view class="hero-line"></view>
      <view class="benefit-card">
        <view class="bc-head">
          <text class="bc-gold">{{pageCopy.intro.benefitTitle}}</text>
        </view>
        <view class="bc-row">
          <view class="bc-item">
            <text class="bc-icon">{{pageCopy.intro.benefits[0].icon}}</text>
            <view class="bc-body">
              <text class="bc-name">{{pageCopy.intro.benefits[0].name}}</text>
              <text class="bc-desc">{{pageCopy.intro.benefits[0].desc}}</text>
            </view>
          </view>
          <view class="bc-item">
            <text class="bc-icon">{{pageCopy.intro.benefits[1].icon}}</text>
            <view class="bc-body">
              <text class="bc-name">{{pageCopy.intro.benefits[1].name}}</text>
              <text class="bc-desc">{{pageCopy.intro.benefits[1].desc}}</text>
            </view>
          </view>
        </view>
        <view class="bc-row">
          <view class="bc-item">
            <text class="bc-icon">{{pageCopy.intro.benefits[2].icon}}</text>
            <view class="bc-body">
              <text class="bc-name">{{pageCopy.intro.benefits[2].name}}</text>
              <text class="bc-desc">{{pageCopy.intro.benefits[2].desc}}</text>
            </view>
          </view>
          <view class="bc-item">
            <text class="bc-icon">{{pageCopy.intro.benefits[3].icon}}</text>
            <view class="bc-body">
              <text class="bc-name">{{pageCopy.intro.benefits[3].name}}</text>
              <text class="bc-desc">{{pageCopy.intro.benefits[3].desc}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    <button class="btn-hero" bindtap="goIdentity">{{pageCopy.intro.btn}}</button>
  </block>

  <!-- ═══ Step 2: 店铺身份（全必填 *） ═══ -->
  <block wx:if="{{step==='identity'}}">
    <view class="nav-bar"><text bindtap="goBackStep" class="back-btn">← 上一步</text><text class="nav-title">{{pageCopy.steps.identity}}</text><text></text></view>
    <scroll-view scroll-y class="form-scroll">
      <view class="sec-card">
        <view class="sec-head"><text class="sec-icon">{{pageCopy.sections.basic.icon}}</text><text class="sec-title">{{pageCopy.sections.basic.title}}</text><text class="sec-hint req">{{pageCopy.sections.basic.hint}}</text></view>

        <view class="f-grid2">
          <view class="f-cell full"><text class="flabel req">店铺名称</text><input class="finput" value="{{name}}" placeholder="请输入店铺名称" bindinput="onName"/></view>
          <view class="f-cell"><text class="flabel req">联系人</text><input class="finput" value="{{contact}}" placeholder="请输入联系人姓名" bindinput="onContact"/></view>
          <view class="f-cell"><text class="flabel req">联系电话</text><input class="finput" type="number" value="{{phone}}" placeholder="请输入手机号码" bindinput="onPhone"/></view>
          <view class="f-cell"><text class="flabel req">微信号</text><input class="finput" value="{{wechat}}" placeholder="请输入微信号" bindinput="onWechat"/></view>
          <view class="f-cell"><text class="flabel req">所在城市</text><input class="finput" value="{{city}}" placeholder="请输入城市，如：杭州" bindinput="onCity"/></view>
          <view class="f-cell"><text class="flabel req">商圈/地段</text><input class="finput" value="{{district}}" placeholder="请输入商圈，如：四季青" bindinput="onDistrict"/></view>
        </view>

        <view class="f-row"><text class="flabel req">经营模式</text>
          <picker mode="selector" range="{{shopTypes}}" value="{{shopTypeIndex}}" bindchange="onShopType">
            <view class="fpick">{{shopTypeIndex<0?'请选择 ▾':shopTypes[shopTypeIndex]+' ▾'}}</view>
          </picker>
        </view>

        <view class="f-row"><text class="flabel req">店铺面积</text>
          <picker mode="selector" range="{{shopSizes}}" value="{{shopSizeIndex}}" bindchange="onShopSize">
            <view class="fpick">{{shopSizeIndex<0?'请选择 ▾':shopSizes[shopSizeIndex]+' ▾'}}</view>
          </picker>
        </view>
      </view>
      <button class="btn-primary" bindtap="goProfile">{{pageCopy.btns.nextIdentity}}</button>
    </scroll-view>
  </block>

  <!-- ═══ Step 3: 经营画像（全必填 *） ═══ -->
  <block wx:if="{{step==='profile'}}">
    <view class="nav-bar"><text bindtap="goBackStep" class="back-btn">← 上一步</text><text class="nav-title">{{pageCopy.steps.profile}}</text><text></text></view>
    <scroll-view scroll-y class="form-scroll">
      <!-- 采购渠道 -->
      <view class="sec-card">
        <view class="sec-head"><text class="sec-icon">{{pageCopy.sections.market.icon}}</text><text class="sec-title">{{pageCopy.sections.market.title}}</text><text class="sec-hint req">{{pageCopy.sections.market.hint}}</text></view>
        <view class="tag-wrap">
          <view class="chk {{marketCheck[0]?'chk-on':''}}" data-idx="0" bindtap="toggleMarket">广州</view>
          <view class="chk {{marketCheck[1]?'chk-on':''}}" data-idx="1" bindtap="toggleMarket">杭州</view>
          <view class="chk {{marketCheck[2]?'chk-on':''}}" data-idx="2" bindtap="toggleMarket">深圳</view>
          <view class="chk {{marketCheck[3]?'chk-on':''}}" data-idx="3" bindtap="toggleMarket">上海</view>
          <view class="chk {{marketCheck[4]?'chk-on':''}}" data-idx="4" bindtap="toggleMarket">常熟</view>
          <view class="chk {{marketCheck[5]?'chk-on':''}}" data-idx="5" bindtap="toggleMarket">其他</view>
        </view>
      </view>

      <!-- 采购频次 -->
      <view class="sec-card">
        <view class="sec-head"><text class="sec-icon">{{pageCopy.sections.freq.icon}}</text><text class="sec-title">{{pageCopy.sections.freq.title}}</text><text class="sec-hint req">{{pageCopy.sections.freq.hint}}</text></view>
        <picker mode="selector" range="{{freqOptions}}" value="{{freqIndex}}" bindchange="onFreq">
          <view class="fpick-big">{{freqIndex<0?'请选择 ▾':freqOptions[freqIndex]+' ▾'}}</view>
        </picker>
      </view>

      <!-- 主营品类 -->
      <view class="sec-card">
        <view class="sec-head"><text class="sec-icon">{{pageCopy.sections.category.icon}}</text><text class="sec-title">{{pageCopy.sections.category.title}}</text><text class="sec-hint req">{{pageCopy.sections.category.hint}}</text></view>
        <view class="tag-wrap">
          <view class="chk {{categoryCheck[0]?'chk-on':''}}" data-idx="0" bindtap="toggleCat">女装</view>
          <view class="chk {{categoryCheck[1]?'chk-on':''}}" data-idx="1" bindtap="toggleCat">男装</view>
          <view class="chk {{categoryCheck[2]?'chk-on':''}}" data-idx="2" bindtap="toggleCat">童装</view>
          <view class="chk {{categoryCheck[3]?'chk-on':''}}" data-idx="3" bindtap="toggleCat">配饰</view>
          <view class="chk {{categoryCheck[4]?'chk-on':''}}" data-idx="4" bindtap="toggleCat">内衣/家居服</view>
        </view>
      </view>

      <!-- 风格偏好 -->
      <view class="sec-card">
        <view class="sec-head"><text class="sec-icon">{{pageCopy.sections.style.icon}}</text><text class="sec-title">{{pageCopy.sections.style.title}}</text><text class="sec-hint req">{{pageCopy.sections.style.hint}}</text></view>
        <view class="tag-wrap">
          <view class="chk {{styleCheck[0]?'chk-on':''}}" data-idx="0" bindtap="toggleStyle">淑女风</view>
          <view class="chk {{styleCheck[1]?'chk-on':''}}" data-idx="1" bindtap="toggleStyle">知性风</view>
          <view class="chk {{styleCheck[2]?'chk-on':''}}" data-idx="2" bindtap="toggleStyle">名媛风</view>
          <view class="chk {{styleCheck[3]?'chk-on':''}}" data-idx="3" bindtap="toggleStyle">中性风</view>
          <view class="chk {{styleCheck[4]?'chk-on':''}}" data-idx="4" bindtap="toggleStyle">潮牌风</view>
          <view class="chk {{styleCheck[5]?'chk-on':''}}" data-idx="5" bindtap="toggleStyle">职业风</view>
          <view class="chk {{styleCheck[6]?'chk-on':''}}" data-idx="6" bindtap="toggleStyle">休闲风</view>
          <view class="chk {{styleCheck[7]?'chk-on':''}}" data-idx="7" bindtap="toggleStyle">大牌风</view>
        </view>
      </view>

      <!-- 年龄 + 价格带 -->
      <view class="sec-card">
        <view class="sec-head"><text class="sec-icon">{{pageCopy.sections.target.icon}}</text><text class="sec-title">{{pageCopy.sections.target.title}}</text><text class="sec-hint req">{{pageCopy.sections.target.hint}}</text></view>
        <view class="f-row"><text class="flabel req">目标年龄层</text>
          <picker mode="selector" range="{{ages}}" value="{{ageIndex}}" bindchange="onAge">
            <view class="fpick">{{ageIndex<0?'请选择 ▾':ages[ageIndex]+' ▾'}}</view>
          </picker>
        </view>
        <view class="f-row"><text class="flabel req">价格带</text>
          <picker mode="selector" range="{{prices}}" value="{{priceIndex}}" bindchange="onPrice">
            <view class="fpick">{{priceIndex<0?'请选择 ▾':prices[priceIndex]+' ▾'}}</view>
          </picker>
        </view>
      </view>

      <button class="btn-primary" bindtap="goExtra">{{pageCopy.btns.nextProfile}}</button>
    </scroll-view>
  </block>

  <!-- ═══ Step 4: 补充信息（全必填 *） ═══ -->
  <block wx:if="{{step==='extra'}}">
    <view class="nav-bar"><text bindtap="goBackStep" class="back-btn">← 上一步</text><text class="nav-title">{{pageCopy.steps.extra}}</text><text></text></view>
    <scroll-view scroll-y class="form-scroll">

      <!-- 地址 + 色系 -->
      <view class="sec-card">
        <view class="sec-head"><text class="sec-icon">{{pageCopy.sections.location.icon}}</text><text class="sec-title">{{pageCopy.sections.location.title}}</text><text class="sec-hint req">{{pageCopy.sections.location.hint}}</text></view>
        <view class="f-row full"><text class="flabel req">详细地址</text><input class="finput" value="{{address}}" placeholder="请输入详细地址" bindinput="onAddress"/></view>

        <view class="f-row"><text class="flabel req">当前店铺主要色系</text>
          <picker mode="selector" range="{{colors}}" value="{{colorIndex}}" bindchange="onColor">
            <view class="fpick">{{colorIndex<0?'请选择 ▾':colors[colorIndex]+' ▾'}}</view>
          </picker>
        </view>
      </view>

      <!-- 照片上传 -->
      <view class="sec-card">
        <view class="sec-head"><text class="sec-icon">{{pageCopy.sections.photos.icon}}</text><text class="sec-title">{{pageCopy.sections.photos.title}}</text><text class="sec-hint req">{{pageCopy.sections.photos.hint}}</text></view>

        <view class="photo-area" bindtap="chooseFrontPhoto">
          <image wx:if="{{frontPhotoPath}}" src="{{frontPhotoPath}}" mode="aspectFill" class="photo-img"></image>
          <view wx:else class="photo-placeholder">
            <text class="photo-icon">📸</text>
            <text class="photo-txt">{{pageCopy.photos.frontTitle}}</text>
            <text class="photo-tip">{{pageCopy.photos.frontTip}}</text>
          </view>
          <text class="photo-label req">{{pageCopy.photos.frontLabel}}</text>
        </view>

        <view class="photo-area" bindtap="chooseInteriorPhoto">
          <image wx:if="{{interiorPhotoPath}}" src="{{interiorPhotoPath}}" mode="aspectFill" class="photo-img"></image>
          <view wx:else class="photo-placeholder">
            <text class="photo-icon">🏪</text>
            <text class="photo-txt">{{pageCopy.photos.interiorTitle}}</text>
            <text class="photo-tip">{{pageCopy.photos.interiorTip}}</text>
          </view>
          <text class="photo-label req">{{pageCopy.photos.interiorLabel}}</text>
        </view>
      </view>

      <!-- 购物凭证上传（必填） -->
      <view class="sec-card">
        <view class="sec-head"><text class="sec-icon">{{pageCopy.sections.proof.icon}}</text><text class="sec-title">{{pageCopy.sections.proof.title}}</text><text class="sec-hint req">{{pageCopy.sections.proof.hint}}</text></view>

        <view class="photo-area" bindtap="choosePurchaseOrder">
          <image wx:if="{{purchaseOrderPath}}" src="{{purchaseOrderPath}}" mode="aspectFill" class="photo-img"></image>
          <view wx:else class="photo-placeholder">
            <text class="photo-icon">🧾</text>
            <text class="photo-txt">{{pageCopy.photos.proofTitle}}</text>
            <text class="photo-tip">{{pageCopy.photos.proofTip}}</text>
          </view>
          <text class="photo-label req">{{pageCopy.photos.proofLabel}}</text>
        </view>
      </view>

      <!-- 经营数据（选填） -->
      <view class="sec-card">
        <view class="sec-head"><text class="sec-icon">{{pageCopy.sections.bizData.icon}}</text><text class="sec-title">{{pageCopy.sections.bizData.title}}</text><text class="sec-hint opt">{{pageCopy.sections.bizData.hint}}</text></view>

        <view class="biz-grid">
          <view class="biz-cell"><text class="flabel">月租金（元）</text><input class="finput finput-sm" type="digit" value="{{monthlyRent}}" placeholder="如：8000" bindinput="onMonthlyRent"/></view>
          <view class="biz-cell"><text class="flabel">保本点（元/月）</text><input class="finput finput-sm" type="digit" value="{{breakEven}}" placeholder="如：30000" bindinput="onBreakEven"/></view>
          <view class="biz-cell"><text class="flabel">毛利率</text><input class="finput finput-sm" type="digit" value="{{grossMargin}}" placeholder="0.55 即 55%" bindinput="onGrossMargin"/></view>
          <view class="biz-cell"><text class="flabel">净利率</text><input class="finput finput-sm" type="digit" value="{{netMargin}}" placeholder="0.55 即 55%" bindinput="onNetMargin"/></view>
          <view class="biz-cell"><text class="flabel">线上曝光人数/月</text><input class="finput finput-sm" type="number" value="{{onlineExposure}}" placeholder="如：5000" bindinput="onOnlineExposure"/></view>
          <view class="biz-cell"><text class="flabel">月进店数</text><input class="finput finput-sm" type="number" value="{{footTraffic}}" placeholder="如：300" bindinput="onFootTraffic"/></view>
          <view class="biz-cell"><text class="flabel">成交率</text><input class="finput finput-sm" type="digit" value="{{conversionRate}}" placeholder="0.55 即 55%" bindinput="onConversionRate"/></view>
          <view class="biz-cell"><text class="flabel">连带率</text><input class="finput finput-sm" type="digit" value="{{attachRate}}" placeholder="如：2.5" bindinput="onAttachRate"/></view>
          <view class="biz-cell"><text class="flabel">均件单价（元）</text><input class="finput finput-sm" type="digit" value="{{avgItemPrice}}" placeholder="如：280" bindinput="onAvgItemPrice"/></view>
        </view>
        <view class="f-row full mt-2"><text class="flabel">月营业额（元）</text><input class="finput" type="digit" value="{{monthlyRevenue}}" placeholder="如：50000" bindinput="onMonthlyRevenue"/></view>
        <view class="f-row full mt-2"><text class="flabel">流量渠道（逗号分隔）</text><input class="finput" value="{{trafficChannels}}" placeholder="微信、抖音、小红书" bindinput="onTrafficChannels"/></view>
      </view>

      <!-- 备注 -->
      <view class="sec-card">
        <view class="sec-head"><text class="sec-icon">{{pageCopy.sections.notes.icon}}</text><text class="sec-title">{{pageCopy.sections.notes.title}}</text><text class="sec-hint opt">{{pageCopy.sections.notes.hint}}</text></view>
        <textarea class="ftextarea" value="{{notes}}" placeholder="选填，可补充特殊需求，如：主营客群、选购偏好" bindinput="onNotes"/>
      </view>

      <button class="btn-primary btn-lg {{submitting?'submitting':''}}" bindtap="submitCertify" disabled="{{submitting}}">
        {{submitting?pageCopy.btns.submitting:pageCopy.btns.submit}}
      </button>
      <text wx:if="{{submitError}}" class="err-text">{{submitError}}</text>
    </scroll-view>
  </block>

  <!-- ═══ Step 5: 成功 ═══ -->
  <block wx:if="{{step==='done'}}">
    <view class="done-wrap">
      <view class="done-crown">{{pageCopy.done.crown}}</view>
      <text class="done-tit">{{pageCopy.done.tit}}</text>
      <text class="done-sub">{{pageCopy.done.sub}}</text>
      <view class="done-list">
        <view class="done-it"><view class="di-ico ok">✓</view><text class="di-txt"><text class="di-b">{{pageCopy.done.items[0].b}}</text> · {{pageCopy.done.items[0].t}}</text></view>
        <view class="done-it"><view class="di-ico">✓</view><text class="di-txt"><text class="di-b">{{pageCopy.done.items[1].b}}</text> · {{pageCopy.done.items[1].t}}</text></view>
        <view class="done-it"><view class="di-ico">✓</view><text class="di-txt"><text class="di-b">{{pageCopy.done.items[2].b}}</text> · {{pageCopy.done.items[2].t}}</text></view>
        <view class="done-it"><view class="di-ico">✓</view><text class="di-txt"><text class="di-b">{{pageCopy.done.items[3].b}}</text> · {{pageCopy.done.items[3].t}}</text></view>
      </view>
      <button class="btn-accent" bindtap="goBuyer">{{pageCopy.btns.goBuyer}}</button>
      <button class="btn-outline" bindtap="goMy">{{pageCopy.btns.goMy}}</button>
    </view>
  </block>
</view>

<!-- 未登录引导层 -->
<view wx:if="{{needLogin}}" class="login-mask">
  <view class="login-box">
    <text class="login-tit">{{pageCopy.login.tit}}</text>
    <text class="login-dsc">{{pageCopy.login.dsc}}</text>
    <button class="btn-primary login-btn" bindtap="goLogin">{{pageCopy.login.btn}}</button>
    <text class="login-x" bindtap="goHome">{{pageCopy.login.back}}</text>
  </view>
</view>
