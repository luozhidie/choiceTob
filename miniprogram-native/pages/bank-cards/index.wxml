<view class="wrap">
  <view class="card-list" wx:if="{{!loading && cards.length>0}}">
    <view wx:for="{{cards}}" wx:key="id" class="bank-card">
      <view class="bc-info">
        <text class="bc-name">{{item.bankName}}</text>
        <text class="bc-no">{{item.accountName}} · 尾号{{item.last4}}</text>
      </view>
      <text class="bc-unbind" bindtap="unbind" data-id="{{item.id}}">解绑</text>
    </view>
  </view>
  <view wx:elif="{{!loading}}" class="empty">
    <text class="empty-title">暂无绑定银行卡</text>
    <text class="empty-desc">佣金提现可打到本人银行卡</text>
  </view>

  <view class="add-btn" bindtap="openForm">＋ 添加银行卡</view>

  <!-- 添加弹窗 -->
  <view wx:if="{{showForm}}" class="mask" bindtap="closeForm">
    <view class="sheet" catchtap="noop">
      <text class="sheet-title">添加银行卡</text>
      <input class="sheet-input" value="{{bankName}}" bindinput="onBankName" placeholder="开户行（如：工商银行）"/>
      <input class="sheet-input" value="{{accountName}}" bindinput="onAccountName" placeholder="持卡人姓名"/>
      <input class="sheet-input" type="number" value="{{cardNo}}" bindinput="onCardNo" placeholder="银行卡号（16-19位）"/>
      <view class="sheet-btns">
        <view class="sheet-cancel" bindtap="closeForm">取消</view>
        <view class="sheet-save" bindtap="saveCard">{{saving?'保存中…':'保存'}}</view>
      </view>
    </view>
  </view>
</view>
