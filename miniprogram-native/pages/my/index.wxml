<view class="page">
  <!-- ====== 头部：头像+用户信息+操作图标 ====== -->
  <view class="header" style="{{myHeaderStyle}}">
    <image wx:if="{{myHeaderImage}}" src="{{myHeaderImage}}" mode="aspectFill" class="hdr-bg"/>
    <view wx:if="{{myHeaderImage}}" class="hdr-mask"/>
    <view class="header-left" bindtap="{{isLoggedIn?'goSettings':'goLogin'}}">
      <image class="avatar" src="{{avatarUrl||'/assets/avatar-ph.png'}}" mode="aspectFill"/>
      <view class="user-meta">
        <text class="uid">{{isLoggedIn?(userId||'用户'):'登录/注册'}}</text>
        <text class="role">{{roleText}}</text>
      </view>
    </view>
    <view class="header-icons">
      <view class="hi" bindtap="goContact"><text>🎧</text></view>
      <view class="hi" bindtap="goSettings"><text>⚙</text></view>
      <view class="hi"><text>🔔</text></view>
    </view>
  </view>

  <!-- ═══════ 未认证（不管是否登录）：金色左右对比引导卡（同行截图1）═══════ -->
  <view wx:if="{{!isCertified}}" class="cert-guide-card">
    <view class="cg-body">
      <!-- 左侧：当前受限状态 -->
      <view class="cg-left">
        <text class="cg-status">您暂未认证</text>
        <text class="cg-hint">仅能</text>
        <text class="cg-restrict">零售价购买</text>
      </view>

      <!-- 右侧：认证会员权益 -->
      <view class="cg-right">
        <view class="cg-title-row">
          <text class="cg-shield">🛡</text>
          <text class="cg-cert-title">认证会员</text>
        </view>
        <!-- 4个权益图标 -->
        <view class="cg-icons">
          <block wx:for="{{certBenefits}}" wx:key="title">
            <view class="cgi-item">
              <view class="cgi-circle"><text>{{item.icon}}</text></view>
              <text class="cgi-label">{{item.title}}</text>
            </view>
          </block>
        </view>
        <!-- 一键认证按钮 -->
        <view class="cg-btn" bindtap="{{isLoggedIn?'goCertify':'goLogin'}}">{{isLoggedIn?'一键认证 解锁权益':'登录后一键认证'}}</view>
      </view>
    </view>
  </view>

  <!-- ═══════ 已登录 + 已认证：批发价 + 充值享折扣退换（深色等级卡·旧版视觉）═══════ -->
  <view wx:if="{{isLoggedIn && isCertified}}" class="tier-card-dark">
    <!-- 标题行 -->
    <view class="tcd-header">
      <text class="tcd-level">认证会员<text class="tcd-badge">已认证</text></text>
      <view class="tcd-view-btn" bindtap="goVip"><text>查看权益</text></view>
    </view>
    <!-- 说明 -->
    <text class="tcd-desc">认证即享会员价，购买专业版 ¥998 解锁更高会员折扣</text>

    <!-- 进度条 -->
    <view class="tcd-bar-wrap">
      <view class="tcd-bar-track">
        <view class="tcd-bar-fill" style="width:{{depositProgress}}%"></view>
      </view>
    </view>
    <text class="tcd-spent-text">已充值货款 <text class="tcd-spent-num">¥{{depositAmountStr}}</text>，{{nextTierText}}</text>

    <!-- 4个权益图标 -->
    <view class="tcd-benefits">
      <view class="tcdb-item">
        <view class="tcdb-circle"><text>🏷️</text></view>
        <text class="tcdb-label">会员价</text>
      </view>
      <view class="tcdb-item">
        <view class="tcdb-circle"><text>🔄</text></view>
        <text class="tcdb-label">会员折扣</text>
      </view>
      <view class="tcdb-item">
        <view class="tcdb-circle"><text>🎟️</text></view>
        <text class="tcdb-label">新款抢先</text>
      </view>
      <view class="tcdb-item">
        <view class="tcdb-circle"><text>⚡</text></view>
        <text class="tcdb-label">精准推荐</text>
      </view>
    </view>
    <text class="tcd-foot">专业版 ¥998 · 单件 3.3 折 · 满 5 件 2.8 折</text>

    <!-- 代理中心入口：998 做代理 -->
    <view class="tcd-agent-entry" bindtap="goAgentCenter">
      <text class="tcd-agent-txt">¥998 开通专业版 · 单件 3.3 折 · 满 5 件 2.8 折 →</text>
    </view>

    <!-- 充值入口 -->
    <view class="tcd-price-entry" bindtap="goVipDeposit">
      <text class="tcd-price-txt">充值解锁退换额度 + 更高会员折扣 →</text>
    </view>
  </view>

  <!-- ═══════ 未登录后：正常显示下方内容 ═══════ -->

  <!-- ========== 快捷数据（3格）========== -->
  <view class="stats-row">
    <view class="stat-card" bindtap="goSubscribedStalls">
      <text class="sc-icon">🏪</text>
      <text class="sc-num">{{subCount}}</text>
      <text class="sc-label">订阅风格</text>
    </view>
    <view class="stat-card" bindtap="goFavorites">
      <text class="sc-icon">⭐</text>
      <text class="sc-num">{{favCount}}</text>
      <text class="sc-label">收藏商品</text>
    </view>
    <view class="stat-card" bindtap="goHistory">
      <text class="sc-icon">👣</text>
      <text class="sc-num">{{historyCount}}</text>
      <text class="sc-label">足迹</text>
    </view>
  </view>

  <!-- ========== 我的订单 ========== -->
  <view class="section">
    <view class="sec-header">
      <text class="sec-title">我的订单</text>
      <text class="sec-more" bindtap="goOrders">查看全部 ›</text>
    </view>
    <view class="order-row">
      <view class="oi" bindtap="goOrders" data-status="unpaid">
        <text class="oi-icon">💰</text><text class="oi-label">待付款</text>
      </view>
      <view class="oi" bindtap="goOrders" data-status="toship">
        <text class="oi-icon">🚚</text><text class="oi-label">待发货</text>
      </view>
      <view class="oi" bindtap="goOrders" data-status="toreceive">
        <text class="oi-icon">📦</text><text class="oi-label">待收货</text>
      </view>
      <view class="oi" bindtap="goOrders" data-status="aftersale">
        <text class="oi-icon">↩️</text><text class="oi-label">售后进度</text>
      </view>
    </view>
  </view>

  <!-- ========== 活动横幅（首单 4 重福利 · 限时） ========== -->
  <view class="promo-banner" bindtap="goPromo">
    <view class="pb-deco pb-deco-1"></view>
    <view class="pb-deco pb-deco-2"></view>
    <view class="pb-header">
      <view class="pb-tag-wrap">
        <text class="pb-tag">HOT</text>
        <text class="pb-tag-sub">限时</text>
      </view>
      <view class="pb-go">GO →</view>
    </view>
    <view class="pb-title">首单 4 重福利</view>
    <view class="pb-chips">
      <view class="pb-chip"><text class="pb-chip-ic">📦</text><text>169包邮</text></view>
      <view class="pb-chip"><text class="pb-chip-ic">🔄</text><text>免费退货</text></view>
      <view class="pb-chip"><text class="pb-chip-ic">🧧</text><text>新人红包</text></view>
      <view class="pb-chip"><text class="pb-chip-ic">⚡</text><text>优先发货</text></view>
    </view>
  </view>

  <!-- ========== 我的资产 ========== -->
  <view class="section">
    <text class="sec-title">我的资产</text>
    <view class="asset-row">
      <view class="asset-item" bindtap="goSettings">
        <text class="asset-num">{{walletBalance}}</text><text class="asset-label">钱包</text>
      </view>
      <view class="asset-divider"></view>
      <view class="asset-item" bindtap="goCoupons">
        <text class="asset-num">{{couponCount}}</text><text class="asset-label">卡券</text>
      </view>
      <view class="asset-divider"></view>
      <view class="asset-item" bindtap="goRedPackets">
        <text class="asset-num">{{redPackCount}}</text><text class="asset-label">红包</text>
      </view>
    </view>
  </view>

  <!-- ========== 我的活动（2x2 网格：每卡专属视觉主题）========== -->
  <view class="section" wx:if="{{isLoggedIn}}">
    <text class="sec-title">我的活动</text>
    <view class="activity-grid">
      <!-- 卡 1：发现宝藏搭配（紫调主理人） -->
      <view class="ac-item ac-theme-styles" bindtap="goMarkets">
        <view class="ac-deco ac-deco-circle"></view>
        <text class="ac-title">发现宝藏搭配</text>
        <text class="ac-desc">2026 全国精选风格</text>
        <view class="ac-emoji">✨</view>
      </view>
      <!-- 卡 2：会员福利社群（暖金会员） -->
      <view class="ac-item ac-theme-owner" bindtap="goGroupBuy">
        <view class="ac-deco ac-deco-gift"></view>
        <text class="ac-title">会员福利社群</text>
        <text class="ac-desc">运费券 / 红包活动</text>
        <view class="ac-emoji">🎁</view>
      </view>
      <!-- 卡 3：集财运（朱红福运） -->
      <view class="ac-item ac-theme-luck" bindtap="goLuckDraw">
        <view class="ac-deco ac-deco-luck"></view>
        <view class="ac-badge ac-badge-luck">🔥 热门</view>
        <text class="ac-title">集财运</text>
        <text class="ac-desc">攒福气 享福利</text>
        <view class="ac-emoji">🧧</view>
      </view>
    </view>

    <!-- 权益入口：仅已是代理/管理员可见（普通账号不展示，避免审核暴露 B2B 属性） -->
    <view wx:if="{{isAgent || isAdmin}}" class="agent-center-banner" bindtap="goAgentCenter">
      <view class="acb-left">
        <text class="acb-badge">VIP</text>
        <text class="acb-title">权益中心</text>
        <text class="acb-desc">看业绩 · 提现收益</text>
      </view>
      <view class="acb-btn">进入 ›</view>
    </view>
    <view wx:if="{{(isCertified || isAgent || isAdmin) && !isAgent}}" class="agent-recruit-banner" bindtap="goAgentRecruit">
      <view class="arb-left">
        <text class="arb-badge">JOIN VIP</text>
        <text class="arb-title">升级会员权益</text>
        <text class="arb-desc">预存货款享会员价 · 邀好友再得返利</text>
      </view>
      <view class="arb-btn">立即加入 ›</view>
    </view>
  </view>

  <!-- ========== VIP形象服务（认证会员/代理/管理员可见） ========== -->
  <view class="section" wx:if="{{isLoggedIn && (isCertified || isAgent || isAdmin)}}">
    <view class="sec-header">
      <text class="sec-title">VIP形象服务</text>
    </view>

    <!-- 更多服务：4 图标网格（AI试衣有下方独立大入口，不重复放） -->
    <view class="service-grid">
      <view class="sg-item" bindtap="goWardrobe">
        <view class="sg-icon"><text>🚪</text></view>
        <text class="sg-label">VIP衣橱</text>
      </view>
      <view class="sg-item" bindtap="goStyleProfile">
        <view class="sg-icon"><text>🪞</text></view>
        <text class="sg-label">形象档案</text>
      </view>
      <view class="sg-item" bindtap="goStyleTest">
        <view class="sg-icon"><text>📤</text></view>
        <text class="sg-label">资料上传</text>
      </view>
      <view class="sg-item" bindtap="goBooking">
        <view class="sg-icon"><text>⏰</text></view>
        <text class="sg-label">预约陪购</text>
      </view>
    </view>

    <!-- VIP形象诊断 banner -->
    <view class="image-diag-card" bindtap="goPersonalImage">
      <view class="idc-body">
        <text class="idc-title">VIP形象诊断</text>
        <text class="idc-desc">请仔细填写诊断信息，龙虾按<text class="idc-highlight">喜欢+适合+需要</text>的规则为您选款搭配</text>
        <view class="idc-btn">立即诊断 ›</view>
      </view>
    </view>
  </view>

  <!-- ========== AI 虚拟试衣：独立大入口 ========== -->
  <view class="section" bindtap="goLookStudio">
    <view class="tryon-entry">
      <view class="te-left">
        <text class="te-title">云衣橱•AI虚拟试衣</text>
        <text class="te-desc">上传照片 · 先试再买 · 新人首单 ¥9.9</text>
      </view>
      <view class="te-btn">去试衣 ›</view>
    </view>
  </view>

  <!-- ========== 会员服务（仅认证会员/管理员可见） ========== -->
  <view class="section" wx:if="{{isLoggedIn && (isCertified || isAgent || isAdmin)}}">
    <view class="sec-header">
      <text class="sec-title">会员服务</text>
    </view>
    <text class="sec-sub">AI 只是辅助工具，核心是完整的专业服务体系与培训课</text>
    <view class="service-grid">
      <view class="sg-item" bindtap="goBuyerService" data-service="buyer_group">
        <view class="sg-icon"><text>🛒</text></view>
        <text class="sg-label">买手选品</text>
      </view>
      <view class="sg-item" bindtap="goBuyerService" data-service="plan">
        <view class="sg-icon"><text>📋</text></view>
        <text class="sg-label">商品企划</text>
      </view>
      <view class="sg-item" bindtap="goBuyerService" data-service="display">
        <view class="sg-icon"><text>🪟</text></view>
        <text class="sg-label">陈列搭配</text>
      </view>
      <view class="sg-item" bindtap="goBuyerService" data-service="marketing">
        <view class="sg-icon"><text>📣</text></view>
        <text class="sg-label">营销策划</text>
      </view>
      <view class="sg-item" bindtap="goBuyerService" data-service="sales">
        <view class="sg-icon"><text>💡</text></view>
        <text class="sg-label">销售服务</text>
      </view>
      <view class="sg-item" bindtap="goBuyerService" data-service="vip">
        <view class="sg-icon"><text>⭐</text></view>
        <text class="sg-label">VIP管理</text>
      </view>
      <view class="sg-item" bindtap="goBuyerService" data-service="design">
        <view class="sg-icon"><text>✏️</text></view>
        <text class="sg-label">服装设计</text>
      </view>
    </view>

    <!-- AI 辅助工具 -->
    <view class="ai-tool-bar" bindtap="goFashionStylist">
      <view class="ai-tool-left">
        <text class="ai-tool-icon">🤖</text>
        <text class="ai-tool-text">AI 智能辅助：生成初步方案</text>
      </view>
      <text class="ai-tool-arrow">›</text>
    </view>
  </view>

  <!-- ========== 我的服务（保留原功能入口） ========== -->
  <view class="section">
    <text class="sec-title">我的服务</text>

    <!-- 专属搭配咨询：所有登录用户可见 -->
    <view wx:if="{{isLoggedIn}}" class="buyer-request-bar" bindtap="goBuyerRequest">
      <view class="br-left">
        <text class="br-icon">💬</text>
        <view class="br-text">
          <text class="br-title">专属搭配咨询</text>
          <text class="br-desc">告诉我你想要的风格 / 色系 / 场合，一对一给你方案</text>
        </view>
      </view>
      <text class="br-arrow">›</text>
    </view>

    <view class="service-list">
      <view wx:if="{{isLoggedIn}}" class="sv-item" bindtap="goImport">
        <text class="sv-icon-text">📦</text>
        <text class="sv-label">一键导入</text>
      </view>
      <view wx:if="{{isLoggedIn}}" class="sv-item" bindtap="goAlbumGrab">
        <text class="sv-icon-text">🖼️</text>
        <text class="sv-label">相册采集</text>
      </view>
      <view wx:if="{{isLoggedIn}}" class="sv-item" bindtap="goAddress">
        <text class="sv-icon-text">📍</text>
        <text class="sv-label">地址管理</text>
      </view>
      <view wx:if="{{isLoggedIn}}" class="sv-item" bindtap="goWishlist">
        <text class="sv-icon-text">♡</text>
        <text class="sv-label">心愿单</text>
      </view>
      <view wx:if="{{isLoggedIn}}" class="sv-item" bindtap="goFeedback">
        <text class="sv-icon-text">✉️</text>
        <text class="sv-label">投诉建议</text>
      </view>
      <view class="sv-item" bindtap="goOneKeyImport">
        <text class="sv-icon-text">📥</text>
        <text class="sv-label">一键入库</text>
      </view>
    </view>
  </view>

  <!-- ========== 退出登录（仅登录时显示）========== -->
  <view wx:if="{{isLoggedIn}}" class="logout-wrap">
    <button class="btn-logout" bindtap="goLogout">退出登录</button>
  </view>

  <view class="sbtm"></view>
</view>

<!-- 营销弹窗 -->
<popup cfg="{{popupCfg}}" visible="{{popupVisible}}" bind:close="onPopupClose" bind:buttonTap="onPopupButtonTap" />
