<wxs module="f">
module.exports = {
  yuan: function (c) { if (c == null) return '0'; var y = Math.round(c) / 100; return y % 1 === 0 ? '' + y : y.toFixed(2); },
  discount: function (r) { if (!r || r >= 1) return '零售价'; var z = Math.round(r * 1000) / 100; return (z % 1 === 0 ? z.toFixed(0) : z.toFixed(1)) + '折'; },
  rate: function (r) { if (!r) return '0%'; return Math.round(r * 100) + '%'; },
  first: function (s) { if (!s) return '代'; s = '' + s; return s.charAt(0); },
  date: function (s) { if (!s) return ''; var d = getDate(s); return (d.getMonth()+1) + '-' + d.getDate(); },
  status: function (s) { var map={'pending':'待结算','settled':'已结算','failed':'失败'}; return map[s]||s; }
};
</wxs>

<view class="page">

  <!-- 未登录 -->
  <view wx:if="{{notLogin}}" class="empty">
    <text class="empty-emoji">🔐</text>
    <text class="empty-title">请先登录</text>
    <text class="empty-desc">登录后即可使用权益工作台</text>
    <view class="btn-primary" bindtap="goLogin">去登录</view>
  </view>

  <!-- 严格拦截：非管理员且非充值会员，整页拦截，不渲染任何代理功能 -->
  <view wx:elif="{{notAgent}}" class="empty">
    <text class="empty-emoji">🔒</text>
    <text class="empty-title">权益中心暂未开放</text>
    <text class="empty-desc">本平台为会员制严选平台，预存货款享一手会员价、分享好物赚差价。请先充值预存货款开通权益。</text>
    <view class="btn-primary" bindtap="goVipDeposit">去充值预存货款开通</view>
  </view>

  <block wx:else>
    <!-- Tab 导航 -->
    <view class="tabbar">
      <view class="tab {{tab==='home'?'active':''}}" data-tab="home" bindtap="switchTab">工作台</view>
      <view class="tab {{tab==='customers'?'active':''}}" data-tab="customers" bindtap="switchTab">会员</view>
      <view class="tab {{tab==='vip'?'active':''}}" data-tab="vip" bindtap="switchTab">VIP</view>
      <view class="tab {{tab==='sales'?'active':''}}" data-tab="sales" bindtap="switchTab">收益</view>
      <view class="tab {{tab==='orders'?'active':''}}" data-tab="orders" bindtap="switchTab">订单</view>
      <view class="tab {{tab==='material'?'active':''}}" data-tab="material" bindtap="switchTab">素材</view>
    </view>

    <!-- ========== 工作台 ========== -->
    <view wx:if="{{tab==='home'}}">
      <!-- 身份卡 -->
      <view class="hero">
      <view class="hero-top">
        <image wx:if="{{avatarUrl}}" class="hero-avatar-img" src="{{avatarUrl}}" mode="aspectFill" bindtap="openProfileEdit"/>
        <view wx:else class="hero-avatar" bindtap="openProfileEdit">{{f.first(nickname || agentStoreName || storeName || fullName)}}</view>
        <view class="hero-meta">
          <text class="hero-name">{{nickname || agentStoreName || storeName || fullName || '会员'}}</text>
          <view class="hero-edit" bindtap="openProfileEdit">编辑资料 ›</view>
          <view class="hero-tags">
              <text wx:if="{{isCertified}}" class="tag tag-gold">认证会员</text>
              <text wx:if="{{isDepositAgent}}" class="tag tag-gold">预存货款会员</text>
              <text wx:if="{{isAdmin}}" class="tag tag-admin">管理员</text>
            </view>
          </view>
        </view>
        <view class="hero-stats">
          <view class="hs"><text class="hs-num">{{f.discount(discountRate)}}</text><text class="hs-label">会员折扣</text></view>
          <view class="hs"><text class="hs-num">{{f.rate(returnRate)}}</text><text class="hs-label">退换额度</text></view>
          <view class="hs"><text class="hs-num">¥{{f.yuan(depositAmount)}}</text><text class="hs-label">预存货款</text></view>
        </view>
      </view>

      <!-- 邀请码 + 核心动作 -->
      <view class="card">
        <view class="card-title">我的专属邀请码</view>
        <view class="code-row">
          <text class="code-text">{{inviteCode || '—'}}</text>
          <view class="code-copy" bindtap="copyCode">复制</view>
        </view>
        <button class="btn-share btn-share-main" open-type="share">分享好物给好友</button>
        <view class="code-actions">
          <view class="btn-ghost" bindtap="previewShop">预览店铺 ›</view>
          <button class="btn-share btn-tryon" open-type="share" data-share="tryon">分享试衣</button>
        </view>
        <text class="code-tip">好友通过你的邀请码进入，按会员价直接下单，你的差价自动入账</text>
      </view>

      <!-- 业绩 -->
      <view class="card">
        <view class="card-title">分享业绩</view>
        <view class="perf-row">
          <view class="perf"><text class="perf-num">{{customerCount}}</text><text class="perf-label">合作会员</text></view>
          <view class="perf"><text class="perf-num">{{orderCount}}</text><text class="perf-label">分享订单</text></view>
          <view class="perf"><text class="perf-num">¥{{f.yuan(gmv)}}</text><text class="perf-label">会员GMV</text></view>
        </view>
        <!-- 0 业绩时给明确行动路径 -->
        <view wx:if="{{customerCount===0 && orderCount===0 && gmv===0}}" class="steps">
          <view class="step">
            <text class="step-num">1</text>
            <view>
              <text class="step-t">去「素材」选品入库</text>
              <text class="step-d">按会员色彩季型，把商品加入自己的素材库</text>
            </view>
          </view>
          <view class="step">
            <text class="step-num">2</text>
            <view>
              <text class="step-t">点「发商品给会员」</text>
              <text class="step-d">把对应色彩季型的商品转发给微信好友，会员直接下单</text>
            </view>
          </view>
          <view class="step">
            <text class="step-num">3</text>
            <view>
              <text class="step-t">差价自动入账</text>
              <text class="step-d">会员付款后，你的差价进入可提现余额</text>
            </view>
          </view>
          <view class="btn-ghost" style="margin-top:20rpx;" bindtap="switchTab" data-tab="material">去挑素材 ›</view>
        </view>
      </view>

      <!-- 今日可推：工作台直接给转发抓手 -->
      <view class="card" wx:if="{{homeQuickPicks.length>0}}">
        <view class="card-title">
          今日可推
          <text class="card-sub">点卡片直接发给会员</text>
        </view>
        <view class="quick-grid">
          <view wx:for="{{homeQuickPicks}}" wx:key="product_id" class="quick-item">
            <image class="quick-img" src="{{item.cover_image}}" mode="aspectFill"/>
            <text class="quick-title">{{item.title}}</text>
            <text class="quick-price">{{item.custom_price ? '¥'+f.yuan(item.custom_price) : '卖价未设'}}</text>
            <button class="quick-share" open-type="share" data-product-id="{{item.product_id}}" data-title="{{item.title}}" data-cover="{{item.cover_image}}">发会员</button>
          </view>
        </view>
        <view class="quick-more" bindtap="switchTab" data-tab="material">查看更多商品 ›</view>
      </view>

      <!-- 色彩季型选品：我的素材库按十二季型归类（可折叠，同素材 tab） -->
      <view class="card" wx:if="{{seasonList.length>0 || myMaterials.length>0}}">
        <view class="card-title">我的素材库<text class="card-sub">按会员色彩季型 / 风格归类</text></view>
        <text class="style-tip">一件衣服可同时匹配多个色彩季型、多个风格。多选标签入库后，既能按季型找款，也能按风格找款，未来实现 96 型智能匹配。</text>
        <view class="mat-parent-bar workshop-parent-bar">
          <view wx:for="{{colorGroups}}" wx:key="*this" class="mat-parent {{expandedWorkshopGroup===item?'on':''}}" bindtap="expandWorkshopGroup" data-group="{{item}}">{{item}}</view>
        </view>
        <view wx:if="{{expandedWorkshopGroup}}" class="workshop-subtree">
          <view class="style-group-label">{{expandedWorkshopGroup}}色组 · {{expandedWorkshopGroup==='深'||expandedWorkshopGroup==='浅'? '明度' : (expandedWorkshopGroup==='冷'||expandedWorkshopGroup==='暖' ? '色温' : '纯度')}} · {{groupLabels[expandedWorkshopGroup]}}</view>
          <view class="style-grid">
            <view wx:for="{{seasonList}}" wx:for-item="s" wx:key="token" wx:if="{{s.group===expandedWorkshopGroup}}" class="style-tile" bindtap="setMaterialColor" data-token="{{s.token}}">
              <text class="style-name">{{s.token}}</text>
              <text class="style-num">{{s.count}} 款</text>
            </view>
          </view>
        </view>
        <view class="quick-more" bindtap="enterWarehouse">去选品入库 ›</view>
      </view>

      <!-- 十二位核心会员：按色彩季型分组，每季型可挂任意多个客户 -->
      <view class="card">
        <view class="card-title">我的十二位核心会员<text class="card-sub">十二季型 · 每型不限人数</text></view>
        <text class="style-tip">每个客户都有「色彩季型 + 风格」两个结论，挑衣要同时满足才好看。按季型归类客户，每个季型可开发多位作为兜底。</text>
        <view class="core-grid core-grid-flat">
          <view wx:for="{{seasonList}}" wx:for-item="s" wx:key="token" class="core-slot {{coreClients[s.token] && coreClients[s.token].length ? 'filled':''}}" bindtap="toggleCoreSeason" data-season="{{s.token}}">
            <text class="core-style">{{s.token}}</text>
            <text class="core-num">{{coreClients[s.token] ? coreClients[s.token].length : 0}} 人</text>
            <text wx:if="{{expandedCoreSeason !== s.token}}" class="core-empty">＋ 展开</text>
          </view>
        </view>
        <view wx:if="{{expandedCoreSeason}}" class="core-subtree">
          <view class="style-group-label">{{expandedCoreSeason}} · {{coreClients[expandedCoreSeason] ? coreClients[expandedCoreSeason].length : 0}} 位客户</view>
          <view class="client-list">
            <view wx:for="{{coreClients[expandedCoreSeason]}}" wx:for-item="c" wx:key="id" class="client-chip" bindtap="openClientCard" data-season="{{expandedCoreSeason}}" data-index="{{index}}">
              <view class="client-main">
                <text class="client-name">{{c.name}}</text>
                <text wx:if="{{c.contact}}" class="client-contact">{{c.contact}}</text>
              </view>
              <text class="client-share" catchtap="coreShare" data-token="{{expandedCoreSeason}}">分享</text>
            </view>
            <view wx:if="{{!coreClients[expandedCoreSeason] || coreClients[expandedCoreSeason].length===0}}" class="list-empty-sm">该季型还没有客户，点击下方添加</view>
            <view class="client-add" bindtap="openClientForm" data-season="{{expandedCoreSeason}}">＋ 添加客户</view>
          </view>
        </view>
      </view>

      <!-- 女士风格会员盘：8 主风格 × 8 偏风格 = 64（可折叠，每风格不限人数） -->
      <view class="card">
        <view class="card-title">女士风格会员盘<text class="card-sub">64 种风格组合 · 每型不限人数</text></view>
        <text class="style-tip">维护 64 种女士穿衣风格组合会员，点击主风格展开所有偏风格组合，再点风格卡展开其客户列表。</text>
        <view class="mat-parent-bar style-parent-bar">
          <view wx:for="{{ladyMainStyles}}" wx:key="*this" class="mat-parent {{expandedLadyStyle===item?'on':''}}" bindtap="expandLadyStyle" data-main="{{item}}">{{item}}</view>
        </view>
        <view wx:if="{{expandedLadyStyle}}" class="core-subtree">
          <view class="style-group-label">{{expandedLadyStyle}}的偏风格（曲直 / 冷暖微调）· 8 种组合</view>
          <view class="core-grid style-core-grid">
            <view wx:for="{{ladyStyleCombos}}" wx:for-item="s" wx:key="token" wx:if="{{s.main===expandedLadyStyle}}" class="core-slot {{styleClients[s.gkey] && styleClients[s.gkey].length ? 'filled':''}}" bindtap="toggleStyleList" data-gkey="{{s.gkey}}" data-gender="lady" data-season="{{s.token}}">
              <text class="core-style">{{s.token}}</text>
              <text class="core-num">{{styleClients[s.gkey] ? styleClients[s.gkey].length : 0}} 人</text>
              <text wx:if="{{expandedStyleKey !== s.gkey}}" class="core-empty">＋ 展开</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 女士风格客户列表（展开某一风格时显示） -->
      <view wx:if="{{expandedStyleKey && expandedStyleGender==='lady'}}" class="card client-card">
        <view class="card-title">{{expandedStyleSeason}} · {{styleClients[expandedStyleKey] ? styleClients[expandedStyleKey].length : 0}} 位客户</view>
        <view class="client-list">
          <view wx:for="{{styleClients[expandedStyleKey]}}" wx:for-item="c" wx:key="id" class="client-chip" bindtap="openClientCard" data-gender="{{expandedStyleGender}}" data-season="{{expandedStyleSeason}}" data-index="{{index}}">
            <view class="client-main">
              <text class="client-name">{{c.name}}</text>
              <text wx:if="{{c.contact}}" class="client-contact">{{c.contact}}</text>
            </view>
            <text class="client-share" catchtap="coreShare" data-token="{{expandedStyleSeason}}">分享</text>
          </view>
          <view wx:if="{{!styleClients[expandedStyleKey] || styleClients[expandedStyleKey].length===0}}" class="list-empty-sm">该风格还没有客户，点击下方添加</view>
          <view class="client-add" bindtap="openClientForm" data-gender="{{expandedStyleGender}}" data-season="{{expandedStyleSeason}}">＋ 添加客户</view>
        </view>
      </view>

      <!-- 男士风格会员盘：5 主风格 × 5 偏风格 = 25（可折叠，每风格不限人数） -->
      <view class="card">
        <view class="card-title">男士风格会员盘<text class="card-sub">25 种风格组合 · 每型不限人数</text></view>
        <text class="style-tip">维护 25 种男士穿衣风格组合会员，点击主风格展开所有偏风格组合，再点风格卡展开其客户列表。</text>
        <view class="mat-parent-bar style-parent-bar">
          <view wx:for="{{manMainStyles}}" wx:key="*this" class="mat-parent {{expandedManStyle===item?'on':''}}" bindtap="expandManStyle" data-main="{{item}}">{{item}}</view>
        </view>
        <view wx:if="{{expandedManStyle}}" class="core-subtree">
          <view class="style-group-label">{{expandedManStyle}}的偏风格（可多选叠加）· 5 种组合</view>
          <view class="core-grid style-core-grid">
            <view wx:for="{{manStyleCombos}}" wx:for-item="s" wx:key="token" wx:if="{{s.main===expandedManStyle}}" class="core-slot {{styleClients[s.gkey] && styleClients[s.gkey].length ? 'filled':''}}" bindtap="toggleStyleList" data-gkey="{{s.gkey}}" data-gender="man" data-season="{{s.token}}">
              <text class="core-style">{{s.token}}</text>
              <text class="core-num">{{styleClients[s.gkey] ? styleClients[s.gkey].length : 0}} 人</text>
              <text wx:if="{{expandedStyleKey !== s.gkey}}" class="core-empty">＋ 展开</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 男士风格客户列表（展开某一风格时显示） -->
      <view wx:if="{{expandedStyleKey && expandedStyleGender==='man'}}" class="card client-card">
        <view class="card-title">{{expandedStyleSeason}} · {{styleClients[expandedStyleKey] ? styleClients[expandedStyleKey].length : 0}} 位客户</view>
        <view class="client-list">
          <view wx:for="{{styleClients[expandedStyleKey]}}" wx:for-item="c" wx:key="id" class="client-chip" bindtap="openClientCard" data-gender="{{expandedStyleGender}}" data-season="{{expandedStyleSeason}}" data-index="{{index}}">
            <view class="client-main">
              <text class="client-name">{{c.name}}</text>
              <text wx:if="{{c.contact}}" class="client-contact">{{c.contact}}</text>
            </view>
            <text class="client-share" catchtap="coreShare" data-token="{{expandedStyleSeason}}">分享</text>
          </view>
          <view wx:if="{{!styleClients[expandedStyleKey] || styleClients[expandedStyleKey].length===0}}" class="list-empty-sm">该风格还没有客户，点击下方添加</view>
          <view class="client-add" bindtap="openClientForm" data-gender="{{expandedStyleGender}}" data-season="{{expandedStyleSeason}}">＋ 添加客户</view>
        </view>
      </view>

      <!-- 收益 -->
      <view class="card card-profit">
        <view class="profit-head">
          <view>
            <text class="profit-label">可提现收益（佣金）</text>
            <text class="profit-num">¥{{f.yuan(walletBalance)}}</text>
          </view>
          <view class="btn-withdraw" bindtap="openWithdraw">申请提现</view>
        </view>
        <view class="profit-sub">
          <text class="ps-item">冻结中：¥{{f.yuan(frozenBalance)}}</text>
          <text class="ps-item ps-tip">发货后转可提现</text>
        </view>
        <text class="profit-tip">佣金 = 会员付款 − 你的成本，仅佣金可提现，预存货款不可提现</text>
      </view>

      <!-- 资金概览 -->
      <view class="card">
        <view class="card-title">资金概览</view>
        <view class="overview-grid">
          <view class="ov-item">
            <text class="ov-num">¥{{f.yuan(depositAmount)}}</text>
            <text class="ov-label">预存货款</text>
          </view>
          <view class="ov-item">
            <text class="ov-num">¥{{f.yuan(walletBalance)}}</text>
            <text class="ov-label">可提现佣金</text>
          </view>
          <view class="ov-item">
            <text class="ov-num">¥{{f.yuan(frozenBalance)}}</text>
            <text class="ov-label">冻结中佣金</text>
          </view>
          <view class="ov-item">
            <text class="ov-num">{{tryon.proLeft}}次</text>
            <text class="ov-label">专业试衣剩</text>
          </view>
        </view>
      </view>

      <!-- 自定义卖价 -->
      <view class="card">
        <view class="card-title">商品对客卖价<text class="card-sub">会员看不到会员价</text></view>
        <view wx:if="{{priceList.length===0}}" class="list-empty">暂无商品</view>
        <view wx:for="{{priceList}}" wx:key="product_id" class="price-item">
          <image class="pi-img" src="{{item.cover_image}}" mode="aspectFill" wx:if="{{item.cover_image}}"/>
          <view class="pi-img pi-img-ph" wx:else>👗</view>
          <view class="pi-info">
            <text class="pi-title">{{item.title}}</text>
            <view class="pi-prices">
              <text class="pi-retail">零售 ¥{{f.yuan(item.retail_price)}}</text>
              <text class="pi-custom">卖价 ¥{{item.custom_price ? f.yuan(item.custom_price) : '未设'}}</text>
            </view>
          </view>
          <view class="pi-edit" bindtap="openEdit" data-index="{{index}}">设价</view>
        </view>
      </view>

      <!-- 提现记录 -->
      <view wx:if="{{withdrawals.length>0}}" class="card">
        <view class="card-title">提现记录</view>
        <view wx:for="{{withdrawals}}" wx:key="created_at" class="wd-item">
          <view>
            <text class="wd-amt">¥{{f.yuan(item.amount)}}</text>
            <text class="wd-method">{{item.method === 'wechat' ? '微信' : item.method}}</text>
          </view>
          <text class="wd-status wd-{{item.status}}">{{item.status === 'paid' ? '已打款' : (item.status === 'pending' ? '处理中' : '已拒绝')}}</text>
        </view>
      </view>

      <view class="consult" bindtap="callConsult">📞 专属顾问 13925997776</view>
      <view class="sec-link" bindtap="goRecruit">了解升级方式 ›</view>
    </view>

    <!-- ========== 会员管理 ========== -->
    <view wx:if="{{tab==='customers'}}" class="tab-page">
      <view wx:if="{{customers.length===0}}" class="list-empty-box">
        <text class="list-empty">暂无会员</text>
        <text class="list-empty-desc">把商品或试衣发给会员，他们首次访问后会出现在这里</text>
        <button class="btn-primary" open-type="share">去发商品</button>
      </view>
      <view wx:for="{{customers}}" wx:key="userId" class="cus-card">
        <view class="cus-head">
          <view class="cus-avatar">{{f.first(item.name)}}</view>
          <view>
            <text class="cus-name">{{item.name}}</text>
            <text wx:if="{{item.phone}}" class="cus-phone">{{item.phone}}</text>
          </view>
        </view>
        <view class="cus-stats">
          <view class="cs"><text class="cs-num">{{item.orderCount}}</text><text class="cs-label">订单</text></view>
          <view class="cs"><text class="cs-num">¥{{f.yuan(item.gmv)}}</text><text class="cs-label">GMV</text></view>
          <view class="cs"><text class="cs-num">{{f.date(item.lastOrderAt)}}</text><text class="cs-label">最近下单</text></view>
        </view>
        <view wx:if="{{item.lastTryon}}" class="cus-tryon">
          <image class="ct-img" src="{{item.lastTryon.result_image_url}}" mode="aspectFill"/>
          <text class="ct-text">{{item.lastTryon.product_title || 'AI试衣'}} · {{f.date(item.lastTryon.created_at)}}</text>
        </view>
      </view>
    </view>

    <!-- ========== VIP会员资料管理（连接后台 vip_customers，按代理隔离；UI 不暴露"同步后台"） ========== -->
    <view wx:if="{{tab==='vip'}}" class="tab-page">
      <view class="vip-head">
        <view class="vip-head-l">
          <text class="vip-title">VIP会员档案</text>
          <text class="vip-sub">维护高价值会员资料，按色彩季型与风格精准配货</text>
        </view>
        <view class="vip-new" bindtap="openVipForm">＋ 新建</view>
      </view>

      <view wx:if="{{vipCustomers.length===0 && !loading}}" class="list-empty-box">
        <text class="list-empty">还没有VIP会员档案</text>
        <text class="list-empty-desc">把核心会员的姓名、用色季型、风格与跟进记录建在这里，方便精准选品与配货</text>
        <view class="btn-primary" bindtap="openVipForm">＋ 新建VIP会员</view>
      </view>

      <view wx:for="{{vipCustomers}}" wx:key="id" class="vip-card">
        <view class="vip-card-top">
          <view class="vip-avatar">{{item.initial}}</view>
          <view class="vip-info">
            <text class="vip-name">{{item.name}}</text>
            <text class="vip-meta">{{item.gender || '未填性别'}} · {{item.vip_level || 'V1'}}</text>
          </view>
          <view class="vip-actions">
            <text class="vip-act" bindtap="editVip" data-id="{{item.id}}">编辑</text>
            <text class="vip-act vip-match" bindtap="openVipDetail" data-id="{{item.id}}">专属素材</text>
            <text class="vip-act vip-del" bindtap="deleteVip" data-id="{{item.id}}">删除</text>
          </view>
        </view>
        <view class="vip-tags" wx:if="{{item.color_season || item.main_style || item.sub_style}}">
          <text class="vtag" wx:if="{{item.color_season}}">{{item.color_season}}</text>
          <text class="vtag" wx:if="{{item.main_style}}">{{item.main_style}}</text>
          <text class="vtag" wx:if="{{item.sub_style}}">{{item.sub_style}}</text>
        </view>
        <view class="vip-row" wx:if="{{item.phone}}"><text class="vip-k">手机</text>{{item.phone}}</view>
        <view class="vip-row" wx:if="{{item.wechat}}"><text class="vip-k">微信</text>{{item.wechat}}</view>
        <view class="vip-row" wx:if="{{item.company}}"><text class="vip-k">店铺</text>{{item.company}}</view>
        <view class="vip-row vip-note" wx:if="{{item.notes}}"><text class="vip-k">备注</text>{{item.notes}}</view>
      </view>

      <view wx:if="{{vipCustomers.length>0 && vipMore}}" class="vip-more" bindtap="loadVipCustomers">加载更多</view>
    </view>

    <!-- ========== 收益明细 ========== -->
    <view wx:if="{{tab==='sales'}}" class="tab-page">
      <view class="filterbar">
        <view class="filter {{salesFilter==='all'?'active':''}}" data-f="all" bindtap="setSalesFilter">全部</view>
        <view class="filter {{salesFilter==='settled'?'active':''}}" data-f="settled" bindtap="setSalesFilter">已结算</view>
        <view class="filter {{salesFilter==='pending'?'active':''}}" data-f="pending" bindtap="setSalesFilter">待结算</view>
      </view>
      <view class="sum-card">
        <view class="sum"><text class="sum-num">¥{{f.yuan(profitSummary.totalProfit)}}</text><text class="sum-label">累计差价</text></view>
        <view class="sum"><text class="sum-num">¥{{f.yuan(profitSummary.settledProfit)}}</text><text class="sum-label">已结算</text></view>
        <view class="sum"><text class="sum-num">¥{{f.yuan(profitSummary.pendingProfit)}}</text><text class="sum-label">待结算</text></view>
      </view>
      <view wx:if="{{salesList.length===0}}" class="list-empty-box">
        <text class="list-empty">暂无收益明细</text>
        <text class="list-empty-desc">会员付款后，你的差价会在这里显示</text>
        <view class="btn-ghost" bindtap="enterWarehouse">去选品发给会员 ›</view>
      </view>
      <view wx:for="{{salesList}}" wx:key="order_no" class="sale-card">
        <view class="sale-row">
          <text class="sale-no">{{item.order_no}}</text>
          <text class="sale-status sale-{{item.settlement_status}}">{{f.status(item.settlement_status)}}</text>
        </view>
        <text class="sale-title">{{item.product_title}}</text>
        <view class="sale-amounts">
          <text>实付 ¥{{f.yuan(item.total_amount)}}</text>
          <text>成本 ¥{{f.yuan(item.agent_cost)}}</text>
          <text class="sale-profit">利润 ¥{{f.yuan(item.agent_profit)}}</text>
        </view>
        <text class="sale-date">{{item.customer_name}} · {{f.date(item.paid_at || item.created_at)}}</text>
      </view>
    </view>

    <!-- ========== 订单物流 ========== -->
    <view wx:if="{{tab==='orders'}}" class="tab-page">
      <!-- 订单状态汇总 -->
      <view class="order-summary" wx:if="{{orderList.length>0}}">
        <view class="os-item">
          <text class="os-num">{{orderStats.paid}}</text>
          <text class="os-label">待发货</text>
        </view>
        <view class="os-item">
          <text class="os-num">{{orderStats.shipped}}</text>
          <text class="os-label">已发货</text>
        </view>
        <view class="os-item">
          <text class="os-num">{{orderStats.delivered}}</text>
          <text class="os-label">已签收</text>
        </view>
        <view class="os-item">
          <text class="os-num">{{orderStats.aftersale}}</text>
          <text class="os-label">售后中</text>
        </view>
      </view>
      <view wx:if="{{orderList.length===0}}" class="list-empty-box">
        <text class="list-empty">暂无分享订单</text>
        <text class="list-empty-desc">会员通过你的邀请码下单后，订单会同步到这里</text>
        <view class="btn-ghost" bindtap="enterWarehouse">去选品发给会员 ›</view>
      </view>
      <view wx:for="{{orderList}}" wx:key="order_no" class="order-card">
        <view class="order-head">
          <text class="order-no">{{item.order_no}}</text>
          <text class="order-status">{{item.status==='paid'?'已付款':(item.status==='shipped'?'已发货':(item.status==='delivered'?'已签收':item.status))}}</text>
        </view>
        <view class="order-product">
          <image class="op-img" src="{{item.product_image}}" mode="aspectFill" wx:if="{{item.product_image}}"/>
          <view class="op-info">
            <text class="op-title">{{item.product_title}}</text>
            <text class="op-price">¥{{f.yuan(item.total_amount)}} × {{item.quantity}}</text>
          </view>
        </view>
        <view wx:if="{{item.express_company}}" class="order-logistics">
          <text>{{item.express_company}} {{item.tracking_no}}</text>
        </view>
        <view class="order-actions">
          <view class="oa-btn" bindtap="applyAfterSale" data-id="{{item.id}}">申请售后</view>
        </view>
      </view>
    </view>

    <!-- ========== 商品素材（我的素材库 / 选品入库） ========== -->
    <view wx:if="{{tab==='material'}}" class="tab-page">
      <!-- 模式标题 -->
      <view class="mat-header">
        <view>
          <text class="mat-header-title">{{warehouseMode ? '选品入库' : '我的素材库'}}</text>
          <text class="mat-header-sub">{{warehouseMode ? '从全店商品挑选加入你的素材库' : '共 ' + myMaterials.length + ' 款 · 按会员色彩季型 / 风格归类'}}</text>
        </view>
        <view wx:if="{{warehouseMode}}" class="mat-header-btn" bindtap="exitWarehouse">返回素材库</view>
        <view wx:else class="mat-header-btn" bindtap="enterWarehouse">去选品入库</view>
      </view>

      <!-- 色彩季型分类树：六大固有色 -> 十二季型（可折叠） -->
      <view wx:if="{{!warehouseMode && seasonList.length>0}}" class="mat-season-tree">
        <text class="style-tip">六大固有色特征：深、浅、冷、暖、净、柔 → 十二个色彩季型，按会员肤色/用色归类选品</text>
        <view class="mat-tree-all {{colorFilter===''?'on':''}}" bindtap="clearMaterialColor">全部 · {{myMaterials.length}} 款</view>
        <!-- 父级栏：点击展开对应子季型 -->
        <view class="mat-parent-bar">
          <view wx:for="{{colorGroups}}" wx:key="*this" class="mat-parent {{expandedGroup===item?'on':''}}" bindtap="expandGroup" data-group="{{item}}">{{item}}</view>
        </view>
        <!-- 子级展开区 -->
        <view wx:if="{{expandedGroup}}" class="mat-subtree">
          <view class="style-group-label">{{expandedGroup}}：{{groupLabels[expandedGroup]}}</view>
          <view class="style-grid">
            <view wx:for="{{seasonList}}" wx:for-item="s" wx:key="token" wx:if="{{s.group===expandedGroup}}" class="style-tile {{colorFilter===s.token?'on':''}}" bindtap="setMaterialColor" data-token="{{s.token}}">
              <text class="style-name">{{s.token}}</text>
              <text class="style-num">{{s.count}} 款</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 风格快捷筛选 -->
      <view wx:if="{{!warehouseMode && styleFilterList.length>0}}" class="mat-stylebar">
        <scroll-view scroll-x class="sb-scroll">
          <text class="sb-chip {{colorFilter===''?'on':''}}" bindtap="clearMaterialColor">全部</text>
          <text wx:for="{{styleFilterList}}" wx:key="gkey" class="sb-chip {{colorFilter===item.gkey?'on':''}}" bindtap="setMaterialColor" data-token="{{item.gkey}}">{{item.label}}</text>
        </scroll-view>
      </view>

      <!-- 工具栏 -->
      <view class="mat-toolbar" wx:if="{{filteredMaterial.length>0 && !warehouseMode}}">
        <text class="mat-count">{{colorFilter ? colorFilter + ' · ' : ''}}共 {{filteredMaterial.length}} 款商品素材</text>
        <view class="mat-batch {{batchDownloading?'mat-batch-loading':''}}" bindtap="downloadAllImages">
          {{batchDownloading ? '下载中 ' + batchDone + '/' + filteredMaterial.length : '一键下载全部图片'}}
        </view>
      </view>
      <view class="mat-toolbar" wx:if="{{warehouseMode}}">
        <text class="mat-count">仓库共 {{filteredMaterial.length}} 款未入库商品</text>
      </view>

      <!-- 空状态 -->
      <view wx:if="{{filteredMaterial.length===0}}" class="list-empty-box">
        <text class="list-empty">{{warehouseMode ? '仓库暂时没有更多商品' : '素材库还是空的'}}</text>
        <text class="list-empty-desc">{{warehouseMode ? '可以先去上传商品，再回来挑选' : '去选品入库，按你的会员群体色彩季型添加商品'}}</text>
        <view wx:if="{{!warehouseMode}}" class="btn-ghost" bindtap="enterWarehouse">去选品入库 ›</view>
      </view>

      <!-- 商品列表 -->
      <view wx:for="{{filteredMaterial}}" wx:key="product_id" class="mat-card">
        <view class="mat-top" bindtap="goDetail" data-id="{{item.product_id}}">
          <image class="mat-img" src="{{item.cover_image}}" mode="aspectFill" catchtap="goDetail" data-id="{{item.product_id}}"/>
          <view class="mat-info" catchtap="goDetail" data-id="{{item.product_id}}">
            <text class="mat-title">{{item.title}}</text>
            <view class="mat-price-row">
              <text class="mat-price-retail">零售 ¥{{f.yuan(item.retail_price)}}</text>
              <text class="mat-price-custom">{{item.custom_price ? '卖价 ¥' + f.yuan(item.custom_price) : '卖价未设'}}</text>
            </view>
            <view wx:if="{{!warehouseMode && (item._libSeasons.length + item._libStyles.length > 0)}}" class="mat-tags">
              <text wx:for="{{item._libSeasons}}" wx:key="*this" class="mat-tag mat-tag-season">{{item}}</text>
              <text wx:for="{{item._libStyleLabels}}" wx:key="*this" class="mat-tag mat-tag-style">{{item}}</text>
            </view>
          </view>
        </view>
        <view class="mat-actions" catchtap="noop">
          <!-- 我的素材库操作 -->
          <block wx:if="{{!warehouseMode}}">
            <view class="mat-btn" bindtap="copyMaterial" data-index="{{index}}">复制文案</view>
            <view class="mat-btn mat-btn-gold" bindtap="saveImage" data-url="{{item.cover_image}}">下载图片</view>
            <view class="mat-btn" bindtap="goDetail" data-id="{{item.product_id}}">查看详情</view>
            <view class="mat-btn mat-btn-gold" bindtap="goDetail" data-id="{{item.product_id}}">去下单</view>
            <button class="mat-btn mat-share" open-type="share" data-product-id="{{item.product_id}}" data-title="{{item.title}}" data-cover="{{item.cover_image}}">分享</button>
            <view class="mat-btn mat-btn-remove" bindtap="removeFromLibrary" data-pid="{{item.product_id}}">移出</view>
          </block>
          <!-- 仓库选品操作 -->
          <block wx:else>
            <view class="mat-btn" bindtap="goDetail" data-id="{{item.product_id}}">查看详情</view>
            <view class="mat-btn mat-btn-gold" bindtap="openColorPicker" data-pid="{{item.product_id}}">加入素材库</view>
          </block>
        </view>
      </view>
    </view>

    <view class="sbtm"></view>
  </block>

  <!-- 编辑卖价弹窗 -->
  <view wx:if="{{showEdit}}" class="mask" bindtap="closeEdit">
    <view class="sheet" catchtap="noop">
      <text class="sheet-title">设置对客卖价</text>
      <text class="sheet-sub">{{editItem.title}}</text>
      <text class="sheet-retail">平台零售价：¥{{f.yuan(editItem.retail_price)}}</text>
      <input class="sheet-input" type="digit" value="{{editPrice}}" bindinput="onEditPrice" placeholder="输入你给会员的卖价（元）"/>
      <view class="sheet-btns">
        <view class="sheet-cancel" bindtap="closeEdit">取消</view>
        <view class="sheet-save" bindtap="savePrice">{{savingPrice ? '保存中…' : '保存'}}</view>
      </view>
    </view>
  </view>

  <!-- 提现弹窗 -->
  <view wx:if="{{showWithdraw}}" class="mask" bindtap="closeWithdraw">
    <view class="sheet" catchtap="noop">
      <text class="sheet-title">申请提现（仅佣金）</text>
      <text class="sheet-retail">可提现佣金：¥{{f.yuan(walletBalance)}}</text>

      <!-- 方式选择 -->
      <view class="wd-methods">
        <view class="wd-m {{withdrawMethod==='wechat'?'on':''}}" bindtap="setWdMethod" data-m="wechat">微信</view>
        <view class="wd-m {{withdrawMethod==='bank'?'on':''}}" bindtap="setWdMethod" data-m="bank">银行卡</view>
      </view>

      <!-- 银行卡选择 -->
      <view wx:if="{{withdrawMethod==='bank'}}" class="wd-bank" bindtap="goBindBank">
        <text wx:if="{{bankCards.length===0}}" class="wd-bank-empty">＋ 绑定银行卡</text>
        <text wx:else>{{bankCards[selectedBankIndex].bankName}}（{{bankCards[selectedBankIndex].last4}}）</text>
      </view>

      <input class="sheet-input" type="digit" value="{{withdrawAmt}}" bindinput="onWithdrawAmt" placeholder="输入提现金额（元）"/>

      <!-- 个税预览 -->
      <view wx:if="{{withdrawAmt>0}}" class="wd-tax">
        <text class="wt-row">应扣个税（估算）：¥{{wdTaxText}}</text>
        <text class="wt-row wt-strong">实际到账：¥{{wdActualText}}</text>
        <text class="wt-tip">佣金属劳务所得，平台将依法提示个税；实际代缴线下完成</text>
      </view>

      <text class="wd-arrival">预计到账：1-7 个工作日（当天提最快隔日，周五提最快下周一）</text>

      <view class="sheet-btns">
        <view class="sheet-cancel" bindtap="closeWithdraw">取消</view>
        <view class="sheet-save" bindtap="submitWithdraw">{{submittingWithdraw ? '提交中…' : '提交申请'}}</view>
      </view>
    </view>
  </view>

  <!-- 加入素材库：多选标签弹窗（色彩季型 + 女士/男士风格） -->
  <view wx:if="{{showColorPicker}}" class="mask" bindtap="closeColorPicker">
    <view class="sheet sheet-tall" catchtap="noop">
      <text class="sheet-title">加入素材库</text>
      <text class="sheet-sub">{{pickerProduct.title}}</text>
      <text class="sheet-retail">为该商品选择适配会员标签，可多选，后期实现 96 型智能匹配</text>

      <!-- 已选标签 -->
      <view class="picker-tags" wx:if="{{pickerSeasons.length + pickerStyles.length > 0}}">
        <view wx:for="{{pickerSeasons}}" wx:key="*this" class="picker-tag" bindtap="removePickerTag" data-type="season" data-value="{{item}}">{{item}} ✕</view>
        <view wx:for="{{pickerStyles}}" wx:key="*this" class="picker-tag picker-tag-style" bindtap="removePickerTag" data-type="style" data-value="{{item}}">{{item.replace('lady:','').replace('man:','')}} ✕</view>
      </view>

      <!-- Tab -->
      <view class="picker-tabs">
        <view class="picker-tab {{pickerTab==='season'?'on':''}}" bindtap="onPickerTab" data-tab="season">色彩季型</view>
        <view class="picker-tab {{pickerTab==='lady'?'on':''}}" bindtap="onPickerTab" data-tab="lady">女士风格</view>
        <view class="picker-tab {{pickerTab==='man'?'on':''}}" bindtap="onPickerTab" data-tab="man">男士风格</view>
      </view>

      <scroll-view scroll-y class="picker-body">
        <!-- 季型 -->
        <block wx:if="{{pickerTab==='season'}}">
          <view class="picker-all-row"><text class="picker-all-text" bindtap="onPickerSelectAllSeasons">{{pickerSeasons.length===allSeasons.length?'取消全选':'全选 12 季型'}}</text></view>
          <block wx:for="{{colorGroups}}" wx:key="*this">
            <view class="picker-section">{{item}}色组</view>
            <view class="picker-grid">
              <view wx:for="{{allSeasons}}" wx:for-item="s" wx:key="token" wx:if="{{s.group===item}}" class="picker-tile {{pickerSeasons.indexOf(s.token)>=0?'on':''}}" bindtap="onPickerSeason" data-token="{{s.token}}">{{s.token}}</view>
            </view>
          </block>
        </block>

        <!-- 女士风格 -->
        <block wx:if="{{pickerTab==='lady'}}">
          <text class="picker-hint">选择女士 64 种风格组合，可多选</text>
          <view class="mat-parent-bar style-parent-bar">
            <view wx:for="{{ladyMainStyles}}" wx:key="*this" class="mat-parent {{pickerExpandedLadyStyle===item?'on':''}}" bindtap="expandPickerLadyStyle" data-main="{{item}}">{{item}}</view>
          </view>
          <view wx:if="{{pickerExpandedLadyStyle}}" class="core-subtree">
            <view class="style-group-label">{{pickerExpandedLadyStyle}}风格组合 · 点击多选</view>
            <view class="picker-all-row"><text class="picker-all-text" bindtap="onPickerSelectAllStyleGroup" data-gender="lady">全选本组</text></view>
            <view class="picker-grid picker-grid-4">
              <view wx:for="{{ladyStyleCombos}}" wx:for-item="s" wx:key="token" wx:if="{{s.main===pickerExpandedLadyStyle}}" class="picker-tile {{pickerStyles.indexOf(s.gkey)>=0?'on':''}}" bindtap="onPickerStyle" data-gkey="{{s.gkey}}">{{s.token}}</view>
            </view>
          </view>
        </block>

        <!-- 男士风格 -->
        <block wx:if="{{pickerTab==='man'}}">
          <text class="picker-hint">选择男士 25 种风格组合，可多选</text>
          <view class="mat-parent-bar style-parent-bar">
            <view wx:for="{{manMainStyles}}" wx:key="*this" class="mat-parent {{pickerExpandedManStyle===item?'on':''}}" bindtap="expandPickerManStyle" data-main="{{item}}">{{item}}</view>
          </view>
          <view wx:if="{{pickerExpandedManStyle}}" class="core-subtree">
            <view class="style-group-label">{{pickerExpandedManStyle}}风格组合 · 点击多选</view>
            <view class="picker-all-row"><text class="picker-all-text" bindtap="onPickerSelectAllStyleGroup" data-gender="man">全选本组</text></view>
            <view class="picker-grid picker-grid-4">
              <view wx:for="{{manStyleCombos}}" wx:for-item="s" wx:key="token" wx:if="{{s.main===pickerExpandedManStyle}}" class="picker-tile {{pickerStyles.indexOf(s.gkey)>=0?'on':''}}" bindtap="onPickerStyle" data-gkey="{{s.gkey}}">{{s.token}}</view>
            </view>
          </view>
        </block>
      </scroll-view>

      <view class="sheet-btns">
        <view class="sheet-cancel" bindtap="closeColorPicker">取消</view>
        <view class="sheet-save" bindtap="confirmAddToLibrary">确定加入</view>
      </view>
    </view>
  </view>

  <!-- 客户添加/编辑弹窗 -->
  <view wx:if="{{showClientForm}}" class="mask" bindtap="closeClientForm">
    <view class="sheet" catchtap="noop">
      <text class="sheet-title">{{clientEditId ? '编辑客户' : '添加客户'}} · {{clientFormSeason}}</text>
      <text class="sheet-sub">{{clientFormGender === 'lady' ? '女士风格' : (clientFormGender === 'man' ? '男士风格' : '色彩季型')}}客户</text>
      <input class="sheet-input" value="{{clientForm.name}}" bindinput="onClientName" placeholder="会员称呼（如：李姐）"/>
      <input class="sheet-input" value="{{clientForm.contact}}" bindinput="onClientContact" placeholder="微信 / 电话"/>
      <input class="sheet-input" value="{{clientForm.note}}" bindinput="onClientNote" placeholder="备注（体型 / 喜好 / 尺码等）"/>
      <view class="sheet-btns">
        <view wx:if="{{clientEditId}}" class="sheet-delete" bindtap="deleteClient">删除</view>
        <view class="sheet-cancel" bindtap="closeClientForm">取消</view>
        <view class="sheet-save" bindtap="saveClient">保存</view>
      </view>
    </view>
  </view>

  <!-- VIP会员资料：新建 / 编辑 表单弹窗 -->
  <view wx:if="{{showVipForm}}" class="mask" bindtap="closeVipForm">
    <view class="sheet vip-sheet" catchtap="noop">
      <text class="sheet-title">{{editingVipId ? '编辑VIP会员' : '新建VIP会员'}}</text>
      <text class="sheet-sub">{{editingVipId ? '修改会员资料并保存' : '填写会员资料，建立你的VIP档案'}}</text>
      <scroll-view scroll-y class="vip-form">
        <view class="vfield"><text class="vlabel">姓名 <text class="vreq">*</text></text><input class="vinput" value="{{vipForm.name}}" bindinput="onVipInput" data-field="name" placeholder="会员称呼 / 姓名"/></view>
        <view class="vfield"><text class="vlabel">手机号</text><input class="vinput" value="{{vipForm.phone}}" bindinput="onVipInput" data-field="phone" placeholder="11 位手机号"/></view>
        <view class="vfield"><text class="vlabel">微信号</text><input class="vinput" value="{{vipForm.wechat}}" bindinput="onVipInput" data-field="wechat" placeholder="选填"/></view>
        <view class="vfield"><text class="vlabel">店铺 / 公司</text><input class="vinput" value="{{vipForm.company}}" bindinput="onVipInput" data-field="company" placeholder="选填"/></view>
        <view class="vfield">
          <text class="vlabel">性别</text>
          <view class="seg">
            <view class="seg-i {{vipForm.gender==='女'?'on':''}}" bindtap="setVipGender" data-g="女">女</view>
            <view class="seg-i {{vipForm.gender==='男'?'on':''}}" bindtap="setVipGender" data-g="男">男</view>
          </view>
        </view>
        <view class="vfield">
          <text class="vlabel">色彩季型</text>
          <view class="vinput vpick {{vipForm.color_season?'':'vph'}}" bindtap="openVipSeasonPicker">{{vipForm.color_season || '选择六大固有色 → 十二季型'}}</view>
        </view>
        <view class="vfield"><text class="vlabel">主风格</text><input class="vinput" value="{{vipForm.main_style}}" bindinput="onVipInput" data-field="main_style" placeholder="如：优雅型 / 戏剧型"/></view>
        <view class="vfield"><text class="vlabel">副风格</text><input class="vinput" value="{{vipForm.sub_style}}" bindinput="onVipInput" data-field="sub_style" placeholder="选填"/></view>
        <view class="vfield">
          <text class="vlabel">VIP等级</text>
          <view class="seg">
            <view class="seg-i {{vipForm.vip_level==='V1'?'on':''}}" bindtap="setVipLevel" data-l="V1">V1</view>
            <view class="seg-i {{vipForm.vip_level==='V2'?'on':''}}" bindtap="setVipLevel" data-l="V2">V2</view>
            <view class="seg-i {{vipForm.vip_level==='V3'?'on':''}}" bindtap="setVipLevel" data-l="V3">V3</view>
          </view>
        </view>
        <view class="vfield">
          <text class="vlabel">客户形象照</text>
          <view class="vphoto-row">
            <image wx:if="{{vipForm.image_url}}" class="vphoto" src="{{vipForm.image_url}}" mode="aspectFill"/>
            <view wx:else class="vphoto vphoto-empty">未上传</view>
            <view class="vphoto-btn" bindtap="chooseVipFormPhoto">{{vipForm.image_url ? '重新上传' : '上传形象照'}}</view>
          </view>
        </view>
        <view class="vfield">
          <text class="vlabel">备注</text>
          <textarea class="varea" value="{{vipForm.notes}}" bindinput="onVipInput" data-field="notes" placeholder="体型 / 偏好 / 尺码 / 跟进记录等"/>
        </view>
      </scroll-view>
      <view class="sheet-btns">
        <view class="sheet-cancel" bindtap="closeVipForm">取消</view>
        <view class="sheet-save" bindtap="submitVip">{{savingVip ? '保存中…' : '保存'}}</view>
      </view>
    </view>
  </view>

  <!-- VIP资料：色彩季型选择弹窗 -->
  <view wx:if="{{showVipSeason}}" class="mask" bindtap="closeVipSeason">
    <view class="sheet" catchtap="noop">
      <text class="sheet-title">选择色彩季型</text>
      <text class="sheet-sub">六大固有色特征 → 十二个色彩季型</text>
      <block wx:for="{{colorGroups}}" wx:key="*this">
        <view class="picker-section">{{item}}色组</view>
        <view class="picker-grid">
          <view wx:for="{{allSeasons}}" wx:for-item="s" wx:key="token" wx:if="{{s.group===item}}" class="picker-tile {{vipForm.color_season===s.token?'on':''}}" bindtap="pickVipSeason" data-token="{{s.token}}">{{s.token}}</view>
        </view>
      </block>
      <view class="sheet-btns">
        <view class="sheet-cancel" bindtap="closeVipSeason">取消</view>
        <view class="sheet-save" bindtap="closeVipSeason">确定</view>
      </view>
    </view>
  </view>

  <!-- VIP客户详情：形象照 + 专属匹配素材（按季型+风格同步） -->
  <view wx:if="{{showVipDetail}}" class="mask" bindtap="closeVipDetail">
    <view class="sheet sheet-tall vip-detail" catchtap="noop">
      <text class="sheet-title">{{vipDetail.name || '客户详情'}}</text>
      <view class="vip-detail-head">
        <image wx:if="{{vipDetail.image_url}}" class="vip-detail-photo" src="{{vipDetail.image_url}}" mode="aspectFill"/>
        <view wx:else class="vip-detail-photo vip-detail-photo-empty" bindtap="chooseVipPhoto">＋ 上传形象照</view>
        <view class="vip-detail-meta">
          <text class="vip-detail-line">{{vipDetail.gender || '未填性别'}} · {{vipDetail.vip_level || 'V1'}}</text>
          <view class="vip-detail-tags">
            <text wx:if="{{vipDetail.color_season}}" class="vtag">{{vipDetail.color_season}}</text>
            <text wx:if="{{vipDetail.main_style}}" class="vtag">{{vipDetail.main_style}}</text>
            <text wx:if="{{vipDetail.sub_style}}" class="vtag">{{vipDetail.sub_style}}</text>
          </view>
          <text wx:if="{{!vipDetail.image_url}}" class="vip-detail-tip" bindtap="chooseVipPhoto">上传形象照后可用虚拟试衣 ›</text>
        </view>
      </view>

      <view class="vip-detail-section">
        <view class="vip-detail-sec-title">专属匹配素材<text class="vip-detail-sec-sub">按「{{vipDetail.color_season || '季型'}} + {{vipDetail.main_style || '风格'}}」同步</text></view>
        <view wx:if="{{vipMatched.length===0}}" class="vip-detail-empty">还没有符合该客户季型 / 风格的素材，去素材库入库并打标签吧</view>
        <view wx:for="{{vipMatched}}" wx:key="product_id" class="vip-mat-card">
          <image class="vip-mat-img" src="{{item.cover_image}}" mode="aspectFill"/>
          <view class="vip-mat-info">
            <text class="vip-mat-title">{{item.title}}</text>
            <view class="vip-mat-tags">
              <text wx:for="{{item._libSeasons}}" wx:for-item="s" wx:key="*this" class="mat-tag mat-tag-season">{{s}}</text>
              <text wx:for="{{item._libStyleLabels}}" wx:for-item="sl" wx:key="*this" class="mat-tag mat-tag-style">{{sl}}</text>
            </view>
          </view>
          <view class="vip-mat-tryon" catchtap="vipTryon" data-pid="{{item.product_id}}">试衣</view>
        </view>
      </view>

      <view class="sheet-btns">
        <view class="sheet-cancel" bindtap="closeVipDetail">关闭</view>
        <view wx:if="{{vipDetail._workbench}}" class="sheet-delete" bindtap="deleteLocalClient">删除</view>
        <view wx:if="{{vipDetail._workbench}}" class="sheet-edit" bindtap="editLocalClient">编辑资料</view>
        <view wx:if="{{!vipDetail._workbench}}" class="sheet-delete" bindtap="deleteVip" data-id="{{vipDetail.id}}">删除</view>
        <view wx:if="{{!vipDetail._workbench}}" class="sheet-edit" bindtap="editVip" data-id="{{vipDetail.id}}">编辑资料</view>
        <view class="sheet-save" wx:if="{{vipDetail.image_url}}" bindtap="vipTryon" data-pid="">一键虚拟试衣</view>
      </view>
    </view>
  </view>

  <!-- 代理人资料编辑弹窗 -->
  <view wx:if="{{showProfileEdit}}" class="mask" bindtap="closeProfileEdit">
    <view class="sheet profile-sheet" catchtap="noop">
      <text class="sheet-title">编辑我的资料</text>
      <view class="avatar-edit" bindtap="chooseAvatar">
        <image wx:if="{{profileForm.avatarUrl}}" src="{{profileForm.avatarUrl}}" mode="aspectFill" class="avatar-edit-img"/>
        <view wx:else class="avatar-edit-ph">＋ 头像</view>
      </view>
      <input class="sheet-input" value="{{profileForm.nickname}}" bindinput="onProfileInput" data-field="nickname" placeholder="昵称（必填，展示用）"/>
      <input class="sheet-input" value="{{profileForm.agentStoreName}}" bindinput="onProfileInput" data-field="agentStoreName" placeholder="店铺名"/>
      <input class="sheet-input" value="{{profileForm.phone}}" bindinput="onProfileInput" data-field="phone" placeholder="手机号" type="number"/>
      <input class="sheet-input" value="{{profileForm.wechat}}" bindinput="onProfileInput" data-field="wechat" placeholder="微信号"/>
      <textarea class="varea" value="{{profileForm.bio}}" bindinput="onProfileInput" data-field="bio" placeholder="简介（选填）"/>
      <view class="sheet-btns">
        <view class="sheet-cancel" bindtap="closeProfileEdit">取消</view>
        <view class="sheet-save" bindtap="saveProfile">{{profileSaving ? '保存中…' : '保存'}}</view>
      </view>
    </view>
  </view>

</view>
