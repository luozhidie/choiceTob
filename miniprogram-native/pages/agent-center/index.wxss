.page { min-height: 100vh; background: #faf8f6; padding: 0 24rpx 40rpx; box-sizing: border-box; }

/* 未登录 */
.empty { display: flex; flex-direction: column; align-items: center; padding: 160rpx 40rpx; }
.empty-emoji { font-size: 96rpx; }
.empty-title { font-size: 36rpx; font-weight: 700; color: #2d1b2e; margin-top: 24rpx; }
.empty-desc { font-size: 26rpx; color: #9a8f8a; margin-top: 12rpx; margin-bottom: 40rpx; }
.btn-primary { background: #C9A24B; color: #2d1b2e; font-weight: 700; padding: 20rpx 64rpx; border-radius: 999rpx; font-size: 28rpx; }

/* 身份卡 */
.hero { margin-top: 24rpx; background: linear-gradient(135deg, #2d1b2e, #4a3a4b); border-radius: 28rpx; padding: 36rpx 32rpx; color: #fff; }
.hero-top { display: flex; align-items: center; }
.hero-avatar { width: 96rpx; height: 96rpx; border-radius: 50%; background: rgba(201,162,75,0.18); color: #C9A24B; font-size: 44rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; }
.hero-meta { margin-left: 24rpx; flex: 1; }
.hero-name { font-size: 34rpx; font-weight: 700; display: block; }
.hero-tags { margin-top: 12rpx; }
.tag { font-size: 20rpx; padding: 4rpx 14rpx; border-radius: 999rpx; margin-right: 12rpx; }
.tag-gold { background: rgba(201,162,75,0.2); color: #C9A24B; border: 1rpx solid rgba(201,162,75,0.5); }
.hero-stats { display: flex; margin-top: 36rpx; border-top: 1rpx solid rgba(255,255,255,0.12); padding-top: 28rpx; }
.hs { flex: 1; text-align: center; }
.hs-num { display: block; font-size: 32rpx; font-weight: 700; color: #C9A24B; }
.hs-label { font-size: 22rpx; color: rgba(255,255,255,0.65); margin-top: 8rpx; display: block; }

/* 通用卡片 */
.card { background: #fff; border-radius: 24rpx; padding: 32rpx; margin-top: 24rpx; box-shadow: 0 4rpx 20rpx rgba(45,27,46,0.05); }
.card-title { font-size: 30rpx; font-weight: 700; color: #2d1b2e; display: flex; align-items: baseline; }
.card-sub { font-size: 22rpx; color: #b09a6a; font-weight: 400; margin-left: 14rpx; }

/* 推广码 */
.code-row { display: flex; align-items: center; justify-content: space-between; margin-top: 24rpx; background: #faf6ee; border-radius: 16rpx; padding: 24rpx 28rpx; }
.code-text { font-size: 40rpx; font-weight: 800; letter-spacing: 4rpx; color: #2d1b2e; }
.code-copy { font-size: 24rpx; color: #C9A24B; font-weight: 700; padding: 8rpx 24rpx; border: 1rpx solid #C9A24B; border-radius: 999rpx; }
.code-actions { display: flex; gap: 20rpx; margin-top: 16rpx; }
.btn-ghost, .btn-share { flex: 1; text-align: center; font-size: 28rpx; padding: 20rpx 0; border-radius: 14rpx; }
.btn-ghost { background: #f3eee7; color: #2d1b2e; }
.btn-share { background: #C9A24B; color: #2d1b2e; font-weight: 700; }
.btn-share::after { border: none; }
.btn-share-main { display: block; width: 100%; margin: 24rpx 0 0; font-size: 30rpx; padding: 26rpx 0; border-radius: 16rpx; }
.btn-tryon { background: #f3eee7; color: #2d1b2e; font-weight: 600; }
.tag-admin { background: rgba(255,255,255,0.15); color: #fff; border: 1rpx solid rgba(255,255,255,0.3); }
.code-tip { display: block; font-size: 22rpx; color: #9a8f8a; margin-top: 18rpx; line-height: 1.5; }

/* Tab */
.tabbar { display: flex; background: #fff; border-radius: 0 0 24rpx 24rpx; margin: 0 -24rpx; padding: 0 24rpx; box-shadow: 0 4rpx 20rpx rgba(45,27,46,0.05); position: sticky; top: 0; z-index: 10; }
.tab { flex: 1; text-align: center; font-size: 26rpx; color: #8a807a; padding: 24rpx 0; position: relative; }
.tab.active { color: #2d1b2e; font-weight: 700; }
.tab.active::after { content: ''; position: absolute; bottom: 8rpx; left: 50%; transform: translateX(-50%); width: 40rpx; height: 4rpx; background: #C9A24B; border-radius: 4rpx; }
.tab-page { padding-top: 8rpx; }

/* 客户管理 */
.cus-card { background: #fff; border-radius: 24rpx; padding: 28rpx; margin-top: 24rpx; box-shadow: 0 4rpx 20rpx rgba(45,27,46,0.05); }
.cus-head { display: flex; align-items: center; }
.cus-avatar { width: 72rpx; height: 72rpx; border-radius: 50%; background: #f3eee7; color: #C9A24B; font-size: 30rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; }
.cus-name { display: block; margin-left: 20rpx; font-size: 28rpx; font-weight: 700; color: #2d1b2e; }
.cus-phone { display: block; margin-left: 20rpx; font-size: 22rpx; color: #9a8f8a; margin-top: 4rpx; }
.cus-stats { display: flex; margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid #f1ece6; }
.cs { flex: 1; text-align: center; }
.cs-num { display: block; font-size: 30rpx; font-weight: 700; color: #2d1b2e; }
.cs-label { display: block; font-size: 22rpx; color: #9a8f8a; margin-top: 6rpx; }
.cus-tryon { display: flex; align-items: center; margin-top: 20rpx; background: #faf8f6; border-radius: 16rpx; padding: 16rpx; }
.ct-img { width: 80rpx; height: 80rpx; border-radius: 10rpx; }
.ct-text { margin-left: 16rpx; font-size: 24rpx; color: #6b625c; }

/* 收益 */
.filterbar { display: flex; gap: 16rpx; margin-top: 24rpx; }
.filter { flex: 1; text-align: center; background: #fff; color: #6b625c; font-size: 26rpx; padding: 18rpx 0; border-radius: 14rpx; }
.filter.active { background: #2d1b2e; color: #C9A24B; font-weight: 700; }
.sum-card { display: flex; background: linear-gradient(135deg, #2d1b2e, #3d243d); border-radius: 24rpx; padding: 32rpx 0; margin-top: 24rpx; color: #fff; }
.sum { flex: 1; text-align: center; }
.sum-num { display: block; font-size: 32rpx; font-weight: 800; color: #C9A24B; }
.sum-label { display: block; font-size: 22rpx; color: rgba(255,255,255,0.65); margin-top: 8rpx; }
.sale-card { background: #fff; border-radius: 24rpx; padding: 28rpx; margin-top: 24rpx; }
.sale-row { display: flex; justify-content: space-between; }
.sale-no { font-size: 22rpx; color: #9a8f8a; }
.sale-status { font-size: 24rpx; }
.sale-settled { color: #2e9e5b; }
.sale-pending { color: #C9A24B; }
.sale-title { display: block; font-size: 28rpx; color: #2d1b2e; font-weight: 700; margin-top: 12rpx; }
.sale-amounts { display: flex; gap: 24rpx; margin-top: 16rpx; font-size: 24rpx; color: #6b625c; }
.sale-profit { color: #C9A24B; font-weight: 700; }
.sale-date { display: block; font-size: 22rpx; color: #b8ada8; margin-top: 12rpx; }

/* 订单 */
.order-card { background: #fff; border-radius: 24rpx; padding: 28rpx; margin-top: 24rpx; }
.order-head { display: flex; justify-content: space-between; }
.order-no { font-size: 22rpx; color: #9a8f8a; }
.order-status { font-size: 24rpx; color: #C9A24B; }
.order-product { display: flex; margin-top: 20rpx; }
.op-img { width: 120rpx; height: 120rpx; border-radius: 14rpx; background: #f3eee7; }
.op-info { margin-left: 20rpx; flex: 1; }
.op-title { display: block; font-size: 27rpx; color: #2d1b2e; font-weight: 600; }
.op-price { display: block; font-size: 24rpx; color: #C9A24B; margin-top: 10rpx; }
.order-logistics { margin-top: 16rpx; background: #faf8f6; border-radius: 12rpx; padding: 16rpx; font-size: 24rpx; color: #6b625c; }
.order-actions { display: flex; justify-content: flex-end; margin-top: 20rpx; }
.oa-btn { font-size: 24rpx; color: #2d1b2e; background: #f3eee7; padding: 12rpx 28rpx; border-radius: 999rpx; }

/* 素材 */
.mat-toolbar { display: flex; align-items: center; justify-content: space-between; margin-top: 24rpx; }
.mat-count { font-size: 24rpx; color: #9a8f8a; }
.mat-batch { font-size: 24rpx; color: #2d1b2e; background: #C9A24B; font-weight: 700; padding: 14rpx 26rpx; border-radius: 999rpx; }
.mat-batch-loading { opacity: 0.7; }
.mat-card { background: #fff; border-radius: 24rpx; padding: 24rpx; margin-top: 24rpx; }
.mat-top { display: flex; align-items: center; }
.mat-img { width: 140rpx; height: 140rpx; border-radius: 16rpx; background: #f3eee7; }
.mat-info { flex: 1; margin-left: 24rpx; overflow: hidden; }
.mat-title { display: block; font-size: 28rpx; color: #2d1b2e; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.mat-price-row { display: flex; align-items: center; margin-top: 10rpx; flex-wrap: wrap; }
.mat-price-retail { display: inline-block; font-size: 22rpx; color: #b8ada8; text-decoration: line-through; margin-right: 16rpx; }
.mat-price-custom { display: inline-block; font-size: 26rpx; color: #C9A24B; font-weight: 700; }
.mat-actions { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 20rpx; }
.mat-btn { font-size: 22rpx; color: #2d1b2e; background: #f3eee7; padding: 12rpx 22rpx; border-radius: 999rpx; text-align: center; }
.mat-btn-gold { background: #C9A24B; color: #2d1b2e; font-weight: 700; }
.mat-share { margin: 0; padding: 12rpx 22rpx; line-height: normal; display: inline-block; }
.mat-share::after { border: none; }

/* 业绩 */
.perf-row { display: flex; margin-top: 24rpx; }
.perf { flex: 1; text-align: center; }
.perf-num { display: block; font-size: 34rpx; font-weight: 800; color: #2d1b2e; }
.perf-label { font-size: 22rpx; color: #9a8f8a; margin-top: 8rpx; display: block; }

/* 0 业绩引导步骤 */
.steps { margin-top: 28rpx; padding-top: 28rpx; border-top: 1rpx dashed #f1ece6; }
.step { display: flex; align-items: flex-start; margin-bottom: 20rpx; }
.step-num { width: 40rpx; height: 40rpx; border-radius: 50%; background: #C9A24B; color: #2d1b2e; font-size: 22rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; margin-right: 18rpx; flex-shrink: 0; }
.step-t { display: block; font-size: 26rpx; color: #2d1b2e; font-weight: 700; }
.step-d { display: block; font-size: 22rpx; color: #9a8f8a; margin-top: 4rpx; }

/* 收益 */
.card-profit { background: linear-gradient(135deg, #2d1b2e, #3d243d); color: #fff; }
.profit-head { display: flex; align-items: center; justify-content: space-between; }
.profit-label { font-size: 24rpx; color: rgba(255,255,255,0.7); display: block; }
.profit-num { font-size: 48rpx; font-weight: 800; color: #C9A24B; display: block; margin-top: 6rpx; }
.btn-withdraw { background: #C9A24B; color: #2d1b2e; font-weight: 700; font-size: 26rpx; padding: 16rpx 36rpx; border-radius: 999rpx; }
.profit-tip { display: block; font-size: 22rpx; color: rgba(255,255,255,0.6); margin-top: 20rpx; line-height: 1.5; }

/* 今日可推 */
.quick-grid { display: flex; flex-wrap: wrap; gap: 20rpx; margin-top: 24rpx; }
.quick-item { width: calc(33.333% - 14rpx); background: #faf8f6; border-radius: 16rpx; overflow: hidden; padding-bottom: 16rpx; }
.quick-img { width: 100%; height: 180rpx; background: #f3eee7; }
.quick-title { display: block; font-size: 22rpx; color: #2d1b2e; font-weight: 600; margin: 12rpx 12rpx 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.quick-price { display: block; font-size: 22rpx; color: #C9A24B; font-weight: 700; margin: 6rpx 12rpx 0; }
.quick-share { width: calc(100% - 24rpx); margin: 12rpx 12rpx 0; background: #C9A24B; color: #2d1b2e; font-size: 22rpx; font-weight: 700; padding: 10rpx 0; border-radius: 999rpx; }
.quick-share::after { border: none; }
.quick-more { text-align: center; font-size: 24rpx; color: #9a8f8a; margin-top: 24rpx; }

/* 空状态 */
.list-empty { text-align: center; color: #b8ada8; font-size: 26rpx; padding: 40rpx 0; }
.list-empty-box { display: flex; flex-direction: column; align-items: center; padding: 120rpx 40rpx; }
.list-empty-desc { font-size: 24rpx; color: #9a8f8a; margin-top: 12rpx; margin-bottom: 36rpx; text-align: center; line-height: 1.5; }

/* 订单状态汇总 */
.order-summary { display: flex; background: #fff; border-radius: 24rpx; padding: 28rpx 0; margin-top: 24rpx; box-shadow: 0 4rpx 20rpx rgba(45,27,46,0.05); }
.os-item { flex: 1; text-align: center; }
.os-num { display: block; font-size: 34rpx; font-weight: 800; color: #2d1b2e; }
.os-label { display: block; font-size: 22rpx; color: #9a8f8a; margin-top: 8rpx; }
.price-item { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #f1ece6; }
.price-item:last-child { border-bottom: none; }
.pi-img { width: 96rpx; height: 96rpx; border-radius: 12rpx; background: #f3eee7; }
.pi-img-ph { display: flex; align-items: center; justify-content: center; font-size: 44rpx; }
.pi-info { flex: 1; margin-left: 20rpx; overflow: hidden; }
.pi-title { font-size: 26rpx; color: #2d1b2e; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.pi-prices { margin-top: 10rpx; }
.pi-retail { font-size: 22rpx; color: #b8ada8; margin-right: 18rpx; text-decoration: line-through; }
.pi-custom { font-size: 24rpx; color: #C9A24B; font-weight: 700; }
.pi-edit { font-size: 24rpx; color: #2d1b2e; background: #f3eee7; padding: 12rpx 26rpx; border-radius: 999rpx; font-weight: 600; }

/* 提现记录 */
.wd-item { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 0; border-bottom: 1rpx solid #f1ece6; }
.wd-item:last-child { border-bottom: none; }
.wd-amt { font-size: 28rpx; font-weight: 700; color: #2d1b2e; margin-right: 14rpx; }
.wd-method { font-size: 22rpx; color: #9a8f8a; }
.wd-status { font-size: 24rpx; }
.wd-paid { color: #2e9e5b; }
.wd-pending { color: #C9A24B; }

/* 底部 */
.consult { text-align: center; color: #C9A24B; font-size: 26rpx; margin-top: 32rpx; font-weight: 600; }
.sec-link { text-align: center; color: #9a8f8a; font-size: 24rpx; margin-top: 16rpx; }
.sbtm { height: 40rpx; }

/* 色彩季型选品 */
.style-tip { font-size: 22rpx; color: #9a8f8a; line-height: 1.5; margin-top: 12rpx; }
.style-group-label { font-size: 24rpx; color: #2d1b2e; font-weight: 700; margin-top: 28rpx; margin-bottom: 16rpx; }
.style-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.style-tile { width: calc((100% - 48rpx) / 4); box-sizing: border-box; background: #faf6ee; border: 1rpx solid #f0e6d2; border-radius: 16rpx; padding: 20rpx 0; text-align: center; }
.style-name { display: block; font-size: 26rpx; font-weight: 700; color: #2d1b2e; }
.style-num { display: block; font-size: 20rpx; color: #b09a6a; margin-top: 6rpx; }

/* 十二位核心客户 */
.core-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 20rpx; }
.core-slot { width: calc((100% - 48rpx) / 4); box-sizing: border-box; background: #f7f4f9; border: 1rpx dashed #ddd0e0; border-radius: 16rpx; padding: 18rpx 10rpx; display: flex; flex-direction: column; align-items: center; min-height: 120rpx; justify-content: center; }
.core-slot.filled { background: #fff; border: 1rpx solid #C9A24B; box-shadow: 0 4rpx 16rpx rgba(201,162,75,0.12); }
.core-style { font-size: 26rpx; font-weight: 800; color: #2d1b2e; }
.core-name { font-size: 24rpx; color: #2d1b2e; margin-top: 8rpx; font-weight: 600; }
.core-sub { font-size: 20rpx; color: #9a8f8a; margin-top: 2rpx; }
.core-share { font-size: 22rpx; color: #C9A24B; font-weight: 700; margin-top: 12rpx; }
.core-empty { font-size: 22rpx; color: #b8ada8; margin-top: 6rpx; }

/* 素材页头部 */
.mat-header { display: flex; align-items: center; justify-content: space-between; background: #fff; border-radius: 24rpx; padding: 28rpx 32rpx; margin-top: 24rpx; box-shadow: 0 4rpx 20rpx rgba(45,27,46,0.05); }
.mat-header-title { display: block; font-size: 30rpx; font-weight: 700; color: #2d1b2e; }
.mat-header-sub { display: block; font-size: 22rpx; color: #9a8f8a; margin-top: 6rpx; }
.mat-header-btn { font-size: 24rpx; color: #2d1b2e; background: #C9A24B; font-weight: 700; padding: 14rpx 28rpx; border-radius: 999rpx; }
.mat-section-label { font-size: 24rpx; color: #2d1b2e; font-weight: 700; margin-top: 28rpx; margin-bottom: 16rpx; }

/* 素材风格筛选条 */
.mat-stylebar { margin-top: 24rpx; }
.sb-scroll { white-space: nowrap; }
.sb-chip { display: inline-block; font-size: 24rpx; color: #6b5e58; background: #f3eee7; border-radius: 999rpx; padding: 12rpx 26rpx; margin-right: 14rpx; }
.sb-chip.on { background: #2d1b2e; color: #C9A24B; font-weight: 700; }

/* 素材库标签 */
.mat-lib-tag { display: inline-block; font-size: 20rpx; color: #C9A24B; background: rgba(201,162,75,0.12); border: 1rpx solid rgba(201,162,75,0.3); border-radius: 999rpx; padding: 4rpx 14rpx; margin-top: 10rpx; }
.mat-btn-remove { color: #b8ada8; background: #f7f4f1; }

/* 风格选择弹窗 */
.picker-section { font-size: 24rpx; color: #2d1b2e; font-weight: 700; margin-top: 28rpx; margin-bottom: 16rpx; }
.picker-grid { display: flex; flex-wrap: wrap; gap: 18rpx; }
.picker-tile { width: calc((100% - 36rpx) / 3); box-sizing: border-box; background: #faf6ee; border: 1rpx solid #f0e6d2; border-radius: 16rpx; padding: 22rpx 0; text-align: center; font-size: 26rpx; color: #2d1b2e; }
.picker-tile.on { background: #2d1b2e; color: #C9A24B; font-weight: 700; border-color: #2d1b2e; }

/* 弹窗 */
.mask { position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: flex; align-items: flex-end; z-index: 100; }
.sheet { width: 100%; background: #fff; border-radius: 28rpx 28rpx 0 0; padding: 40rpx 36rpx 60rpx; box-sizing: border-box; }
.sheet-title { font-size: 32rpx; font-weight: 700; color: #2d1b2e; display: block; }
.sheet-sub { font-size: 26rpx; color: #6b625c; display: block; margin-top: 12rpx; }
.sheet-retail { font-size: 24rpx; color: #9a8f8a; display: block; margin-top: 16rpx; }
.sheet-input { margin-top: 24rpx; background: #f7f4f1; border-radius: 14rpx; padding: 24rpx; font-size: 30rpx; }
.sheet-btns { display: flex; gap: 20rpx; margin-top: 32rpx; }
.sheet-cancel, .sheet-save { flex: 1; text-align: center; padding: 24rpx 0; border-radius: 14rpx; font-size: 30rpx; font-weight: 700; }
.sheet-cancel { background: #f3eee7; color: #6b625c; }
.sheet-save { background: #C9A24B; color: #2d1b2e; }

/* ========== VIP客户资料管理 ========== */
.vip-head { display: flex; align-items: center; justify-content: space-between; padding: 8rpx 4rpx 12rpx; }
.vip-head-l { display: flex; flex-direction: column; }
.vip-title { font-size: 32rpx; font-weight: 800; color: #2d1b2e; }
.vip-sub { font-size: 23rpx; color: #9a8f8a; margin-top: 6rpx; }
.vip-new { background: #2d1b2e; color: #C9A24B; font-size: 28rpx; font-weight: 700; padding: 16rpx 30rpx; border-radius: 999rpx; }
.vip-card { background: #fff; border-radius: 24rpx; padding: 28rpx; margin-top: 22rpx; box-shadow: 0 4rpx 20rpx rgba(45,27,46,0.05); }
.vip-card-top { display: flex; align-items: center; }
.vip-avatar { width: 76rpx; height: 76rpx; border-radius: 50%; background: #2d1b2e; color: #C9A24B; font-size: 32rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; }
.vip-info { flex: 1; margin-left: 20rpx; display: flex; flex-direction: column; }
.vip-name { font-size: 30rpx; font-weight: 800; color: #2d1b2e; }
.vip-meta { font-size: 23rpx; color: #9a8f8a; margin-top: 4rpx; }
.vip-actions { display: flex; align-items: center; gap: 24rpx; }
.vip-act { font-size: 26rpx; color: #C9A24B; font-weight: 700; }
.vip-act.vip-del { color: #c0392b; }
.vip-tags { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 18rpx; }
.vtag { font-size: 22rpx; color: #2d1b2e; background: #faf6ee; border: 1rpx solid #f0e6d2; border-radius: 999rpx; padding: 8rpx 18rpx; }
.vip-row { font-size: 26rpx; color: #4a423d; margin-top: 12rpx; display: flex; }
.vip-k { color: #9a8f8a; width: 88rpx; flex-shrink: 0; }
.vip-note { line-height: 1.5; }
.vip-more { text-align: center; color: #C9A24B; font-size: 26rpx; padding: 28rpx 0; font-weight: 700; }

/* VIP 表单 */
.vip-sheet { max-height: 86vh; display: flex; flex-direction: column; }
.vip-form { margin-top: 24rpx; max-height: 56vh; }
.vfield { margin-bottom: 22rpx; }
.vlabel { font-size: 25rpx; color: #6b625c; display: block; margin-bottom: 12rpx; font-weight: 600; }
.vreq { color: #c0392b; }
.vinput { background: #f7f4f1; border-radius: 14rpx; padding: 22rpx 24rpx; font-size: 30rpx; color: #2d1b2e; }
.vpick { display: flex; align-items: center; }
.vph { color: #b8ada8; }
.varea { background: #f7f4f1; border-radius: 14rpx; padding: 22rpx 24rpx; font-size: 28rpx; color: #2d1b2e; width: 100%; box-sizing: border-box; height: 150rpx; }
.seg { display: flex; gap: 16rpx; }
.seg-i { flex: 1; text-align: center; padding: 18rpx 0; background: #f7f4f1; border-radius: 14rpx; font-size: 28rpx; color: #6b625c; }
.seg-i.on { background: #2d1b2e; color: #C9A24B; font-weight: 700; }

/* 素材库色彩季型分类树 */
.mat-season-tree { background: #fff; border-radius: 24rpx; padding: 28rpx; margin-top: 24rpx; box-shadow: 0 4rpx 20rpx rgba(45,27,46,0.05); }
.mat-season-tree .style-group-label { margin-top: 24rpx; }
.mat-season-tree .style-group-label:first-of-type { margin-top: 18rpx; }
.mat-season-tree .style-tile { width: calc((100% - 16rpx) / 2); padding: 26rpx 0; }
.mat-tree-all { display: inline-block; font-size: 26rpx; color: #6b5e58; background: #f3eee7; border-radius: 999rpx; padding: 14rpx 32rpx; margin-top: 16rpx; }
.mat-tree-all.on { background: #2d1b2e; color: #C9A24B; font-weight: 700; }
.style-tile.on { background: #2d1b2e; border-color: #2d1b2e; }
.style-tile.on .style-name { color: #C9A24B; }
.style-tile.on .style-num { color: rgba(201,162,75,0.85); }
