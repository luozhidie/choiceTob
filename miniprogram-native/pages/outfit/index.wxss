.page { padding: 20rpx 24rpx 60rpx; background: #16100f; min-height: 100vh; }
.title { font-size: 36rpx; font-weight: 800; color: #C9A24B; margin: 8rpx 0 8rpx; }
.sub { font-size: 22rpx; color: #8a7580; line-height: 1.6; margin-bottom: 24rpx; }
.card { background: #1f141c; border: 1rpx solid #3a2832; border-radius: 16rpx; padding: 22rpx; margin-bottom: 18rpx; }
.ct { font-size: 26rpx; font-weight: 700; color: #fff; margin-bottom: 16rpx; }
.row { display: flex; gap: 18rpx; align-items: center; }
.pick { width: 150rpx; height: 200rpx; border: 2rpx dashed #6b5560; border-radius: 12rpx; display: flex; align-items: center; justify-content: center; color: #b9a7ad; font-size: 24rpx; text-align: center; overflow: hidden; background: #241620; flex-shrink: 0; }
.pick image { width: 100%; height: 100%; }
.tip { font-size: 20rpx; color: #8a7580; line-height: 1.5; flex: 1; }
.auth { display: flex; align-items: center; gap: 12rpx; margin: 4rpx 0 20rpx; }
.auth text { font-size: 22rpx; color: #b9a7ad; line-height: 1.4; }
.btn { width: 100%; padding: 26rpx 0; border-radius: 12rpx; background: #C9A24B; color: #1c111d; font-weight: 800; font-size: 30rpx; border: none; }
.btn[disabled] { opacity: 0.6; }
.btn.ghost { margin-top: 16rpx; background: #2d1b2e; color: #C9A24B; border: 1rpx solid #C9A24B; }
.err { color: #e88; font-size: 24rpx; margin: 16rpx 0; line-height: 1.5; }
.result { margin-top: 24rpx; }
.result image { width: 100%; border-radius: 12rpx; border: 1rpx solid #4a3840; }
.hint { font-size: 20rpx; color: #999; margin-top: 12rpx; }
