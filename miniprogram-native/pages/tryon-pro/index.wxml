<view class="page">
  <view class="head">
    <text class="h-title">专业版</text>
    <text class="h-sub">诊断 + 搭配</text>
  </view>
  <view class="sub">在普通版基础上，加 21 题风格诊断与 AI 智能搭配，买手还帮你挑。</view>

  <view class="pro-card">
    <text class="pro-tag">专业版</text>
    <view class="feat" wx:for="{{include}}" wx:key="*this">✓ {{item}}</view>
  </view>

  <view class="price-row" bindtap="buyPackage" data-id="tryon_pro_monthly_199">
    <view>
      <text class="pr-title">专业月卡</text>
      <text class="pr-sub">30 天 200 次专业诊断</text>
    </view>
    <text class="pr-num">¥199</text>
  </view>
  <view class="buy-btn" bindtap="buyPackage" data-id="tryon_pro_monthly_199">购买 ¥199</view>

  <view class="price-row gold" bindtap="buyPackage" data-id="tryon_pro_year_999">
    <view>
      <text class="pr-title">专业年卡</text>
      <text class="pr-sub">365 天 1000 次专业诊断</text>
    </view>
    <text class="pr-num">¥999</text>
  </view>
  <view class="buy-btn gold" bindtap="buyPackage" data-id="tryon_pro_year_999">购买 ¥999</view>
</view>
