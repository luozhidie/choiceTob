<view class="page">
  <!-- AI生成显著标识（合规：深度合成-AI创作类目要求） -->
  <view class="ai-gen-bar">
    <text class="ai-gen-tag">{{tryon.aiTag}}</text>
    <text class="ai-gen-txt">{{tryon.aiText}}</text>
  </view>
  <view class="head">
    <text class="h-title">{{tryon.pro.title}}</text>
    <text class="h-sub">{{tryon.pro.sub}}</text>
  </view>
  <view class="sub">{{tryon.pro.sub2}}</view>

  <view class="pro-card">
    <text class="pro-tag">{{tryon.pro.title}}</text>
    <view class="feat" wx:for="{{tryon.pro.features}}" wx:key="*this">✓ {{item}}</view>
  </view>

  <view class="price-row gold" bindtap="buyPackage" data-id="tryon_pro_998">
    <view>
      <text class="pr-title">{{tryon.pro.pkgTitle}}</text>
      <text class="pr-sub">{{tryon.pro.pkgSub}}</text>
      <text wx:if="{{tryon.pro.bonusText}}" class="pr-bonus">{{tryon.pro.bonusText}}</text>
    </view>
    <text class="pr-num">{{tryon.pro.pkgPriceLabel}}</text>
  </view>
  <view class="buy-btn gold" bindtap="buyPackage" data-id="tryon_pro_998">{{tryon.pro.pkgBtn}}</view>
</view>
