.page { padding: 20rpx; background: #f7f7f7; min-height: 100vh; }
.tip { font-size: 20rpx; color: #999; margin-bottom: 16rpx; }
.empty { color: #aaa; font-size: 24rpx; text-align: center; padding: 60rpx 20rpx; }
.record { background: #fff; border-radius: 18rpx; padding: 18rpx; margin-bottom: 16rpx; }
.r-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.r-mode { font-size: 22rpx; font-weight: 700; color: #2d1b2e; background: #f0f0f0; padding: 4rpx 12rpx; border-radius: 8rpx; }
.r-mode.pro { background: #2d1b2e; color: #C9A24B; }
.r-date { font-size: 20rpx; color: #999; }
.r-imgs { display: flex; gap: 8rpx; flex-wrap: wrap; margin-bottom: 12rpx; }
.c-img { width: 120rpx; height: 150rpx; border-radius: 10rpx; background: #f5f5f5; }
.result-img { width: 100%; border-radius: 14rpx; display: block; }
