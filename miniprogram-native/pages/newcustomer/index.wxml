<view class="page">
  <!-- Hero -->
  <view class="hero">
    <view class="hero-deco hero-deco-1"></view>
    <view class="hero-deco hero-deco-2"></view>
    <view class="hero-tag">{{pageCopy.heroTag}}</view>
    <view class="hero-title">{{pageCopy.heroTitle}}</view>
    <view class="hero-sub">{{pageCopy.heroSub}}</view>
  </view>

  <!-- 福利列表 -->
  <view class="benefit-list">
    <view class="benefit-card" wx:for="{{pageCopy.benefits}}" wx:key="title">
      <view class="b-icon">{{item.icon}}</view>
      <view class="b-body">
        <view class="b-title">{{item.title}}</view>
        <view class="b-desc">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <!-- 如何领取 -->
  <view class="section">
    <view class="sec-title">{{pageCopy.stepsTitle}}</view>
    <view class="step-list">
      <view class="step" wx:for="{{pageCopy.steps}}" wx:key="*this">
        <view class="step-num">{{index + 1}}</view>
        <view class="step-text">{{item}}</view>
      </view>
    </view>
  </view>

  <!-- 领取按钮 -->
  <view class="cta-wrap">
    <view class="cta-btn" bindtap="claimRedPacket">{{pageCopy.cta}}</view>
  </view>

  <!-- 新客货架 -->
  <view class="section shelf-section">
    <view class="sec-title">
      <text class="shelf-tag">{{pageCopy.shelf.title}}</text>
      <text class="shelf-sub">{{pageCopy.shelf.sub}}</text>
    </view>
    <view class="shelf-hint">{{pageCopy.shelf.hint}}</view>
    <view class="shelf-btn" bindtap="goHome">{{pageCopy.shelf.btn}}</view>
  </view>
</view>
