.page {
  min-height: 100vh;
  background: #f8f5f2;
  padding-bottom: 48rpx;
}

/* ===== Hero ===== */
.hero {
  position: relative;
  background: linear-gradient(135deg, #2d1b2e 0%, #4a2e4b 100%);
  padding: 56rpx 40rpx 72rpx;
  overflow: hidden;
}
.hero-deco {
  position: absolute;
  border-radius: 50%;
  background: rgba(201, 162, 75, 0.12);
}
.hero-deco-1 {
  width: 300rpx;
  height: 300rpx;
  top: -80rpx;
  right: -60rpx;
}
.hero-deco-2 {
  width: 180rpx;
  height: 180rpx;
  bottom: -40rpx;
  left: -40rpx;
}
.hero-tag {
  display: inline-block;
  background: rgba(255, 255, 255, 0.12);
  color: #C9A24B;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}
.hero-title {
  font-size: 52rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 16rpx;
}
.hero-sub {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* ===== 福利列表 ===== */
.benefit-list {
  margin: -36rpx 32rpx 32rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(45, 27, 46, 0.06);
}
.benefit-card {
  display: flex;
  align-items: center;
  padding: 28rpx 16rpx;
  border-bottom: 1rpx solid #f4f1ee;
}
.benefit-card:last-child {
  border-bottom: none;
}
.b-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #faf6f2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.b-body {
  flex: 1;
}
.b-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2d1b2e;
  margin-bottom: 8rpx;
}
.b-desc {
  font-size: 24rpx;
  color: #888;
}

/* ===== 公共 section ===== */
.section {
  margin: 32rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
}
.sec-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #2d1b2e;
  margin-bottom: 24rpx;
}

/* ===== 步骤 ===== */
.step-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.step {
  display: flex;
  align-items: flex-start;
}
.step-num {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #2d1b2e;
  color: #C9A24B;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  flex-shrink: 0;
}
.step-text {
  flex: 1;
  font-size: 28rpx;
  color: #555;
  line-height: 1.5;
}

/* ===== CTA ===== */
.cta-wrap {
  margin: 0 32rpx 32rpx;
}
.cta-btn {
  background: #2d1b2e;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
  padding: 28rpx 0;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(45, 27, 46, 0.18);
}

/* ===== 货架 ===== */
.shelf-section {
  padding-bottom: 40rpx;
}
.shelf-tag {
  display: inline;
  border-left: 6rpx solid #C9A24B;
  padding-left: 16rpx;
}
.shelf-sub {
  font-size: 24rpx;
  color: #888;
  font-weight: 400;
  margin-left: 16rpx;
}
.shelf-hint {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 24rpx;
}
.shelf-btn {
  display: inline-block;
  background: #C9A24B;
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  padding: 18rpx 32rpx;
  border-radius: 32rpx;
}
