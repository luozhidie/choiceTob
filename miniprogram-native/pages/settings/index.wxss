.page{background:#f5f5f7;min-height:100vh;padding-bottom:60rpx;}
.topbar{background:#fff;padding:24rpx 32rpx;border-bottom:1rpx solid #eee;}
.nav-title{font-size:34rpx;font-weight:700;color:#111;}
.group-title{font-size:26rpx;color:#999;padding:32rpx 32rpx 12rpx;}
.card{background:#fff;border-radius:24rpx;margin:0 24rpx;overflow:hidden;box-shadow:0 4rpx 16rpx rgba(0,0,0,0.04);}
.row{display:flex;align-items:center;justify-content:space-between;padding:32rpx;border-bottom:1rpx solid #f2f2f2;}
.row:last-child{border-bottom:none;}
.row-label{font-size:29rpx;color:#222;}
.row-arrow{font-size:36rpx;color:#ccc;line-height:1;}
.logout-btn{background:#fff;color:#e11d48;font-size:30rpx;text-align:center;padding:32rpx;margin:40rpx 24rpx 0;border-radius:24rpx;box-shadow:0 4rpx 16rpx rgba(0,0,0,0.04);}
.login-btn{background:#c9a24b;color:#fff;font-size:30rpx;font-weight:600;text-align:center;padding:32rpx;margin:40rpx 24rpx 0;border-radius:24rpx;}
.agree{text-align:center;font-size:22rpx;color:#aaa;margin-top:32rpx;line-height:1.6;padding:0 40rpx;}
