<view class="page">
  <view class="head">
    <text class="h-title">怎么用 · 4 步穿上身</text>
    <text class="h-sub">不用学，跟着走一遍就会。整个过程约 1 分钟。</text>
  </view>
  <view class="steps-list">
    <view class="gstep" wx:for="{{steps}}" wx:key="n">
      <view class="g-num">{{item.n}}</view>
      <view class="g-body">
        <text class="g-t">{{item.t}}</text>
        <text class="g-d">{{item.d}}</text>
        <text class="g-tip">💡 {{item.tip}}</text>
      </view>
    </view>
  </view>
  <view class="cta-box">
    <text class="cta-tip">看懂了？去试一件看看</text>
    <view class="cta-btn" bindtap="goLookStudio">进入试衣台</view>
  </view>
</view>
