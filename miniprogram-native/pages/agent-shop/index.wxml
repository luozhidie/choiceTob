<wxs module="f">
module.exports = {
  yuan: function (c) { if (c == null) return '0'; var y = Math.round(c) / 100; return y % 1 === 0 ? '' + y : y.toFixed(2); }
};
</wxs>

<view class="page">

  <!-- 加载 -->
  <view wx:if="{{loading}}" class="loading">{{pageCopy.loading}}</view>

  <!-- 无效码 -->
  <view wx:elif="{{!valid}}" class="empty">
    <text class="empty-emoji">{{pageCopy.empty.emoji}}</text>
    <text class="empty-title">{{pageCopy.empty.title}}</text>
    <text class="empty-desc">{{ref ? pageCopy.empty.desc : '分享链接缺少推广码，请通过好友分享的小程序卡片进入'}}</text>
    <view class="btn-primary" bindtap="goHome">{{pageCopy.empty.btn}}</view>
  </view>

  <block wx:else>
    <!-- 专属店铺头 -->
    <view class="shop-head">
      <view class="sh-badge">{{pageCopy.shopHead.badge}}</view>
      <text class="sh-name">{{shopTitle}}</text>
      <text class="sh-desc">{{pageCopy.shopHead.desc}}</text>
    </view>

    <!-- 虚拟试衣 CTA -->
    <view class="try-bar" bindtap="goTry">
      <view class="tb-left">
        <text class="tb-title">{{pageCopy.tryBar.emoji}} {{pageCopy.tryBar.title}}</text>
        <text class="tb-desc">{{pageCopy.tryBar.desc}}</text>
      </view>
      <view class="tb-btn">{{pageCopy.tryBar.btn}}</view>
    </view>

    <!-- 商品橱窗 -->
    <view class="grid">
      <view wx:for="{{products}}" wx:key="product_id" class="card">
        <image class="c-img" src="{{item.cover_image}}" mode="aspectFill" wx:if="{{item.cover_image}}"/>
        <view class="c-img c-img-ph" wx:else>👗</view>
        <text class="c-title">{{item.title}}</text>
        <view class="c-bottom">
          <text class="c-price">¥{{f.yuan(item.price)}}</text>
          <view class="c-buy" bindtap="buy" data-index="{{index}}">{{pageCopy.product.buyBtn}}</view>
        </view>
        <view class="c-try" bindtap="goTry">{{pageCopy.product.tryBtn}}</view>
      </view>
    </view>

    <view class="tip">{{pageCopy.tip}}</view>
    <view class="sbtm"></view>
  </block>

  <!-- 购买弹窗 -->
  <view wx:if="{{showPay}}" class="mask" bindtap="closePay">
    <view class="sheet" catchtap="noop">
      <view class="pay-goods">
        <image class="pg-img" src="{{payItem.cover_image}}" mode="aspectFill" wx:if="{{payItem.cover_image}}"/>
        <view class="pg-img pg-img-ph" wx:else>👗</view>
        <view class="pg-info">
          <text class="pg-title">{{payItem.title}}</text>
          <text class="pg-price">¥{{f.yuan(payItem.price)}}</text>
        </view>
      </view>
      <view class="addr" bindtap="chooseAddr">
        <text wx:if="{{address}}" class="addr-has">{{address.name}} {{address.phone}}\n{{address.province}}{{address.city}}{{address.district}}{{address.detail}}</text>
        <text wx:else class="addr-empty">{{pageCopy.paySheet.addrEmpty}}</text>
      </view>
      <view class="sheet-save" bindtap="submitOrder">{{paying ? '支付中…' : pageCopy.paySheet.payPrefix + f.yuan(payItem.price)}}</view>
    </view>
  </view>

</view>
