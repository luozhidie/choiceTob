.page { min-height: 100vh; background: #faf8f6; padding: 0 24rpx 40rpx; box-sizing: border-box; }

.loading, .empty { text-align: center; padding: 160rpx 40rpx; color: #9a8f8a; font-size: 28rpx; }
.empty-emoji { font-size: 96rpx; display: block; }
.empty-title { font-size: 34rpx; font-weight: 700; color: #2d1b2e; margin-top: 24rpx; display: block; }
.empty-desc { font-size: 24rpx; margin-top: 12rpx; margin-bottom: 40rpx; display: block; }
.btn-primary { background: #C9A24B; color: #2d1b2e; font-weight: 700; padding: 20rpx 64rpx; border-radius: 999rpx; font-size: 28rpx; display: inline-block; }

/* 店铺头 */
.shop-head { background: linear-gradient(135deg, #2d1b2e, #4a3a4b); border-radius: 28rpx; padding: 40rpx 32rpx; color: #fff; margin-top: 24rpx; }
.sh-badge { display: inline-block; font-size: 20rpx; color: #C9A24B; border: 1rpx solid rgba(201,162,75,0.5); border-radius: 999rpx; padding: 4rpx 16rpx; }
.sh-name { display: block; font-size: 38rpx; font-weight: 800; margin-top: 18rpx; }
.sh-desc { display: block; font-size: 24rpx; color: rgba(255,255,255,0.7); margin-top: 10rpx; }

/* 试衣条 */
.try-bar { display: flex; align-items: center; justify-content: space-between; background: #fff; border-radius: 20rpx; padding: 28rpx 28rpx; margin-top: 24rpx; box-shadow: 0 4rpx 20rpx rgba(45,27,46,0.05); }
.tb-left { flex: 1; }
.tb-title { font-size: 28rpx; font-weight: 700; color: #2d1b2e; display: block; }
.tb-desc { font-size: 22rpx; color: #9a8f8a; margin-top: 8rpx; display: block; }
.tb-btn { background: #C9A24B; color: #2d1b2e; font-weight: 700; font-size: 26rpx; padding: 14rpx 30rpx; border-radius: 999rpx; }

/* 商品橱窗 */
.grid { display: flex; flex-wrap: wrap; justify-content: space-between; margin-top: 24rpx; }
.card { width: 48.5%; background: #fff; border-radius: 20rpx; padding: 16rpx; margin-bottom: 24rpx; box-shadow: 0 4rpx 16rpx rgba(45,27,46,0.05); box-sizing: border-box; }
.c-img { width: 100%; height: 320rpx; border-radius: 14rpx; background: #f3eee7; display: block; }
.c-img-ph { display: flex; align-items: center; justify-content: center; font-size: 80rpx; }
.c-title { font-size: 26rpx; color: #2d1b2e; display: block; margin-top: 14rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.c-bottom { display: flex; align-items: center; justify-content: space-between; margin-top: 14rpx; }
.c-price { font-size: 32rpx; font-weight: 800; color: #C9A24B; }
.c-buy { background: #2d1b2e; color: #fff; font-size: 24rpx; padding: 12rpx 26rpx; border-radius: 999rpx; font-weight: 600; }
.c-try { text-align: center; font-size: 22rpx; color: #9a8f8a; margin-top: 14rpx; }

.tip { text-align: center; font-size: 22rpx; color: #b8ada8; margin-top: 16rpx; }
.sbtm { height: 40rpx; }

/* 购买弹窗 */
.mask { position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: flex; align-items: flex-end; z-index: 100; }
.sheet { width: 100%; background: #fff; border-radius: 28rpx 28rpx 0 0; padding: 40rpx 36rpx 60rpx; box-sizing: border-box; }
.pay-goods { display: flex; align-items: center; }
.pg-img { width: 120rpx; height: 120rpx; border-radius: 14rpx; background: #f3eee7; }
.pg-img-ph { display: flex; align-items: center; justify-content: center; font-size: 56rpx; }
.pg-info { margin-left: 24rpx; flex: 1; }
.pg-title { font-size: 28rpx; color: #2d1b2e; display: block; }
.pg-price { font-size: 34rpx; font-weight: 800; color: #C9A24B; margin-top: 10rpx; display: block; }
.addr { margin-top: 28rpx; background: #f7f4f1; border-radius: 14rpx; padding: 24rpx; }
.addr-empty { font-size: 26rpx; color: #9a8f8a; }
.addr-has { font-size: 26rpx; color: #2d1b2e; white-space: pre-wrap; line-height: 1.5; }
.sheet-save { margin-top: 32rpx; background: #C9A24B; color: #2d1b2e; font-weight: 700; text-align: center; padding: 26rpx 0; border-radius: 14rpx; font-size: 30rpx; }
