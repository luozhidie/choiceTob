<view class="page">
  <view class="head">
    <text class="h-title">常见问题</text>
    <text class="h-sub">还有疑问？这里先答。</text>
  </view>
  <view class="faq-list">
    <view class="faq-item" wx:for="{{faqs}}" wx:key="q" bindtap="toggle" data-i="{{index}}">
      <view class="fq">
        <text class="fqt">{{item.q}}</text>
        <text class="arrow">{{item.open ? '−' : '+'}}</text>
      </view>
      <view class="fa" wx:if="{{item.open}}">{{item.a}}</view>
    </view>
  </view>
</view>
