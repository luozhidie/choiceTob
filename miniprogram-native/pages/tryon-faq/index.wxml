<view class="page">
  <view class="head">
    <text class="h-title">{{tryon.faq.title}}</text>
    <text class="h-sub">{{tryon.faq.sub}}</text>
  </view>
  <view class="faq-list">
    <view class="faq-item" wx:for="{{tryon.faq.faqs}}" wx:key="q" bindtap="toggle" data-i="{{index}}">
      <view class="fq">
        <text class="fqt">{{item.q}}</text>
        <text class="arrow">{{item.open ? '−' : '+'}}</text>
      </view>
      <view class="fa" wx:if="{{item.open}}">{{item.a}}</view>
    </view>
  </view>
</view>
