<view class="page">
  <!-- 成功态 -->
  <view class="done" wx:if="{{submitted}}">
    <view class="done-icon">✅</view>
    <view class="done-title">{{pageCopy.done.title}}</view>
    <view class="done-desc">{{pageCopy.done.desc}}</view>
    <view class="done-btn" bindtap="goHome">{{pageCopy.done.btn}}</view>
  </view>

  <block wx:else>
    <!-- Hero -->
    <view class="hero">
      <view class="hero-badge">{{pageCopy.hero.badge}}</view>
      <view class="hero-title">{{pageCopy.hero.title}}</view>
      <view class="hero-desc">{{pageCopy.hero.desc}}</view>
    </view>

    <!-- 权益优势 -->
    <view class="sec">
      <view class="sec-head"><text class="sec-label">{{pageCopy.advantages.label}}</text><text class="sec-title">{{pageCopy.advantages.title}}</text></view>
      <view class="adv-grid">
        <view class="adv-card" wx:for="{{pageCopy.advantages.cards}}" wx:key="title"><text class="adv-icon">{{item.icon}}</text><text class="adv-title">{{item.title}}</text><text class="adv-desc">{{item.desc}}</text></view>
      </view>
    </view>

    <!-- 升级条件 -->
    <view class="sec">
      <view class="sec-head"><text class="sec-label">{{pageCopy.conditions.label}}</text><text class="sec-title">{{pageCopy.conditions.title}}</text></view>
      <view class="cond-list">
        <view class="cond-item" wx:for="{{pageCopy.conditions.items}}" wx:key="*this"><text class="cond-check">✅</text><text class="cond-text">{{item}}</text></view>
      </view>
    </view>

    <!-- 报名表单 -->
    <view class="sec">
      <view class="sec-head"><text class="sec-label">{{pageCopy.apply.label}}</text><text class="sec-title">{{pageCopy.apply.title}}</text></view>
      <view class="form-card">
        <view class="form-item">
          <text class="form-label">姓名 <text class="req">*</text></text>
          <input class="form-input" placeholder="请输入您的姓名" value="{{form.name}}" bindinput="onName" />
        </view>
        <view class="form-item">
          <text class="form-label">电话 <text class="req">*</text></text>
          <input class="form-input" type="number" placeholder="请输入联系电话" value="{{form.phone}}" bindinput="onPhone" />
        </view>
        <view class="form-item">
          <text class="form-label">邮箱</text>
          <input class="form-input" placeholder="选填" value="{{form.email}}" bindinput="onEmail" />
        </view>
        <view class="form-item">
          <text class="form-label">公司 / 店铺名</text>
          <input class="form-input" placeholder="选填" value="{{form.company}}" bindinput="onCompany" />
        </view>
        <view class="form-item">
          <text class="form-label">微信号</text>
          <input class="form-input" placeholder="选填" value="{{form.wechat}}" bindinput="onWechat" />
        </view>
        <view class="form-item">
          <text class="form-label">从业经验</text>
          <picker mode="selector" range="{{experienceOptions}}" value="{{form.experience}}" bindchange="onExperience">
            <view class="form-picker"><text class="picker-text">{{experienceOptions[form.experience]}}</text><text class="picker-arrow">▼</text></view>
          </picker>
        </view>
        <view class="form-item">
          <text class="form-label">预计渠道数</text>
          <picker mode="selector" range="{{storeCountOptions}}" value="{{form.storeCount}}" bindchange="onStoreCount">
            <view class="form-picker"><text class="picker-text">{{storeCountOptions[form.storeCount]}}</text><text class="picker-arrow">▼</text></view>
          </picker>
        </view>
        <view class="form-item">
          <text class="form-label">留言</text>
          <textarea class="form-textarea" placeholder="请输入您的留言或问题（选填）" value="{{form.message}}" bindinput="onMessage" maxlength="500" />
        </view>

        <view class="form-submit {{submitting?'disabled':''}}" bindtap="{{submitting?'noop':'submit'}}">
          <text>{{submitting ? pageCopy.apply.submittingText : pageCopy.apply.submitText}}</text>
        </view>
        <view class="form-tip">{{pageCopy.apply.tip}}</view>
      </view>
    </view>
  </block>
</view>
