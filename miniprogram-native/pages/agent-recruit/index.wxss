.page{background:#f7f4f2;min-height:100vh;padding-bottom:40rpx;}

/* 成功态 */
.done{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:160rpx 60rpx;text-align:center;}
.done-icon{font-size:96rpx;}
.done-title{font-size:38rpx;font-weight:800;color:#2d1b2e;margin-top:24rpx;}
.done-desc{font-size:25rpx;color:#888;margin-top:16rpx;line-height:1.6;}
.done-btn{margin-top:48rpx;background:linear-gradient(135deg,#2d1b2e,#4a3a4b);color:#fff;padding:22rpx 80rpx;border-radius:40rpx;font-size:28rpx;font-weight:600;}

/* 标题 */
.page-head{background:linear-gradient(135deg,#2d1b2e 0%,#4a3a4b 100%);padding:56rpx 40rpx 48rpx;}
.page-title{display:block;font-size:44rpx;font-weight:800;color:#fff;}
.page-sub{display:block;font-size:25rpx;color:#d8cdd2;margin-top:14rpx;line-height:1.6;}

/* 表单 */
.form-card{background:#fff;border-radius:18rpx;padding:32rpx 28rpx;margin:24rpx 28rpx;}
.form-item{margin-bottom:26rpx;}
.form-label{display:block;font-size:26rpx;color:#555;font-weight:600;margin-bottom:12rpx;}
.req{color:#e0533d;}
.form-input{background:#f7f4f2;border:1rpx solid #eee;border-radius:12rpx;padding:20rpx 22rpx;font-size:27rpx;color:#333;}
.form-picker{background:#f7f4f2;border:1rpx solid #eee;border-radius:12rpx;padding:20rpx 22rpx;font-size:27rpx;color:#333;display:flex;justify-content:space-between;align-items:center;}
.picker-text{color:#333;}
.picker-arrow{color:#bbb;font-size:20rpx;}
.form-textarea{background:#f7f4f2;border:1rpx solid #eee;border-radius:12rpx;padding:20rpx 22rpx;font-size:27rpx;color:#333;width:100%;box-sizing:border-box;height:160rpx;}
.form-submit{background:linear-gradient(135deg,#2d1b2e,#4a3a4b);color:#fff;text-align:center;padding:26rpx 0;border-radius:14rpx;font-size:30rpx;font-weight:700;margin-top:8rpx;}
.form-submit.disabled{opacity:.6;}
.form-tip{font-size:21rpx;color:#bbb;text-align:center;margin-top:18rpx;line-height:1.5;}
