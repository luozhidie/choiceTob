<view class="page">
  <!-- 顶部标题 -->
  <view class="topbar">
    <text class="tb-title">销售代理中心</text>
    <text class="tb-sub">充值即开店 · 批发价转售</text>
  </view>

  <!-- 加载 -->
  <view wx:if="{{loading}}" class="loading">加载中…</view>

  <!-- 未登录 -->
  <view wx:elif="{{!loggedIn}}" class="empty">
    <text class="empty-emoji">🔑</text>
    <text class="empty-txt">请先登录后查看代理中心</text>
    <view class="btn-gold" bindtap="goLogin">去登录</view>
  </view>

  <!-- 非代理：引导充值 -->
  <view wx:elif="{{!isAgent}}" class="hero">
    <view class="hero-card">
      <text class="hero-title">成为销售代理</text>
      <text class="hero-desc">充值 5 / 10 / 30 万即自动开店，无需认证</text>
      <view class="hero-benefits">
        <view class="hb"><text class="hb-ic">💰</text><text>批发价拿货</text></view>
        <view class="hb"><text class="hb-ic">🔄</text><text>退换额度 5%~20%</text></view>
        <view class="hb"><text class="hb-ic">🪞</text><text>虚拟试衣帮卖</text></view>
      </view>
      <view class="btn-gold" bindtap="goDeposit">立即充值成为代理</view>
    </view>
  </view>

  <!-- 代理主页 -->
  <view wx:else class="agent">
    <!-- 身份卡 -->
    <view class="id-card">
      <view class="id-row">
        <text class="id-badge">{{tierLabel || '代理'}}</text>
        <text class="id-wholesale">{{wholesaleVisible ? '批发价已开启 ✓' : '批发价未开启'}}</text>
      </view>
      <text class="id-store" wx:if="{{storeName}}">🏪 {{storeName}}</text>
      <view class="id-stats">
        <view class="ids"><text class="ids-num">{{returnRate}}%</text><text class="ids-lab">退换额度</text></view>
        <view class="ids"><text class="ids-num">{{effectiveDiscount}}</text><text class="ids-lab">进货折扣</text></view>
        <view class="ids"><text class="ids-num">{{tryonCredits}}</text><text class="ids-lab">试衣次数</text></view>
      </view>
    </view>

    <!-- 成长等级 -->
    <view class="level-card">
      <view class="lc-head">
        <text class="lc-level">{{agentLevel}}</text>
        <text class="lc-tag">成长等级</text>
      </view>
      <view class="lc-bar"><view class="lc-fill" style="width:{{progress}}%"></view></view>
      <text class="lc-desc" wx:if="{{nextLevel}}">已累计 {{cumYuan}} 元，再 {{nextDiff}} 元升至 {{nextLevel}}（{{nextDiscount}}）</text>
      <text class="lc-desc" wx:else>已达最高等级，感谢同行 🎉</text>
    </view>

    <!-- 操作 -->
    <view class="actions">
      <view class="act" bindtap="goTryonCard">
        <text class="act-ic">🪞</text>
        <text class="act-t">虚拟试衣月卡</text>
        <text class="act-s">{{subTier !== 'none' ? '已订阅' : '¥99 起'}}</text>
      </view>
      <view class="act" bindtap="goDeposit">
        <text class="act-ic">💰</text>
        <text class="act-t">充值升级</text>
        <text class="act-s">5/10/30万</text>
      </view>
    </view>
  </view>

  <view class="sbtm"></view>
</view>
