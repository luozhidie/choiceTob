<view class="page">
  <!-- Hero -->
  <view class="hero">
    <view class="h-badge"><text>{{pageCopy.badge}}</text></view>
    <text class="ht">{{pageCopy.title}}</text>
    <text class="hs">{{pageCopy.subtitle}}</text>

    <!-- 用户卡 -->
    <view class="ucard">
      <view class="uav">
        <image wx:if="{{userInfo.avatarUrl}}" src="{{userInfo.avatarUrl}}" class="uai" mode="aspectFill"/>
        <view wx:else class="uap"><text>👤</text></view>
      </view>
      <view class="uinfo">
        <text class="uname">{{userInfo.nickName||pageCopy.userCard.defaultName}}</text>
        <text class="ustatus" wx:if="{{isVip}}">{{pageCopy.userCard.vipActive}}</text>
        <text class="ustatus off" wx:else>{{pageCopy.userCard.vipInactive}}</text>
      </view>
      <view class="ugobtn" bindtap="goVip" wx:if="{{!isVip}}"><text>{{pageCopy.userCard.openBtn}}</text></view>
    </view>
  </view>

  <!-- 功能区标题 -->
  <view class="sect-title"><text class="st-icon">☆</text><text>{{pageCopy.sectionTitle}}</text></view>

  <!-- 4个功能卡片 -->
  <view class="cards">
    <view class="card card-hot" bindtap="goVip">
      <view class="ctag ctag-hot">{{pageCopy.cards[0].tag}}</view>
      <view class="cicon"><text>{{pageCopy.cards[0].icon}}</text></view>
      <text class="cname">{{pageCopy.cards[0].name}}</text>
      <text class="cdesc">{{pageCopy.cards[0].desc}}</text>
      <view class="cbtn"><text>{{pageCopy.cards[0].btn}}</text></view>
    </view>

    <view class="card card-ai" bindtap="goPlan">
      <view class="ctag ctag-ai">{{pageCopy.cards[1].tag}}</view>
      <view class="cicon"><text>{{pageCopy.cards[1].icon}}</text></view>
      <text class="cname">{{pageCopy.cards[1].name}}</text>
      <text class="cdesc">{{pageCopy.cards[1].desc}}</text>
      <view class="cbtn"><text>{{pageCopy.cards[1].btn}}</text></view>
    </view>

    <view class="card card-hot-item" bindtap="goBuyer">
      <view class="ctag ctag-excl">{{pageCopy.cards[2].tag}}</view>
      <view class="cicon"><text>{{pageCopy.cards[2].icon}}</text></view>
      <text class="cname">{{pageCopy.cards[2].name}}</text>
      <text class="cdesc">{{pageCopy.cards[2].desc}}</text>
      <view class="cbtn"><text>{{pageCopy.cards[2].btn}}</text></view>
    </view>

    <view class="card card-marketing" bindtap="goMarketing">
      <view class="ctag ctag-smart">{{pageCopy.cards[3].tag}}</view>
      <view class="cicon"><text>{{pageCopy.cards[3].icon}}</text></view>
      <text class="cname">{{pageCopy.cards[3].name}}</text>
      <text class="cdesc">{{pageCopy.cards[3].desc}}</text>
      <view class="cbtn"><text>{{pageCopy.cards[3].btn}}</text></view>
    </view>
  </view>

  <view class="sbtm"></view>
</view>
