.page { min-height: 100vh; background: #f7f5f2; font-family: system-ui, -apple-system, sans-serif; }

/* ---------- Hero ---------- */
.hero { background: linear-gradient(160deg, #2d1b2e 0%, #1a0f1a 100%); padding: 64rpx 36rpx 52rpx; color: #fff; position: relative; overflow: hidden; }
.hero::after { content: ''; position: absolute; top: -90rpx; right: -90rpx; width: 320rpx; height: 320rpx; background: radial-gradient(circle, rgba(201,162,75,.28) 0%, transparent 70%); border-radius: 50%; }
.hero-tag { display: inline-block; font-size: 20rpx; color: #C9A24B; border: 1rpx solid rgba(201,162,75,.5); padding: 6rpx 18rpx; border-radius: 30rpx; position: relative; z-index: 1; }
.hero-title { font-size: 56rpx; font-weight: 800; line-height: 1.18; display: block; letter-spacing: 2rpx; margin-top: 22rpx; white-space: pre-line; position: relative; z-index: 1; }
.hero-sub { font-size: 26rpx; color: #d8d0d8; line-height: 1.65; display: block; margin-top: 22rpx; position: relative; z-index: 1; }
.hero-badges { display: flex; gap: 14rpx; margin-top: 30rpx; position: relative; z-index: 1; }
.badge { font-size: 20rpx; color: #fcefe9; background: rgba(255,255,255,.12); padding: 8rpx 18rpx; border-radius: 30rpx; }
.hero-cta { margin-top: 42rpx; background: linear-gradient(90deg, #C9A24B, #dab860); border-radius: 20rpx; padding: 30rpx 0; text-align: center; box-shadow: 0 14rpx 34rpx rgba(201,162,75,.4); position: relative; z-index: 1; }
.cta-main { display: block; font-size: 34rpx; font-weight: 800; color: #2d1b2e; }
.cta-sub { display: block; font-size: 22rpx; color: #5a4723; margin-top: 8rpx; }

/* ---------- Section ---------- */
.section { padding: 40rpx 30rpx; }
.card-section { padding-top: 0; padding-bottom: 0; margin-bottom: 28rpx; }
.sec-title { font-size: 34rpx; font-weight: 800; color: #2d1b2e; display: block; margin-bottom: 28rpx; }

/* ---------- Steps ---------- */
.steps { display: flex; align-items: flex-start; justify-content: space-between; background: #fff; border-radius: 24rpx; padding: 36rpx 24rpx; box-shadow: 0 4rpx 20rpx rgba(0,0,0,.04); }
.step { flex: 1; text-align: center; padding: 0 6rpx; }
.step-num { width: 60rpx; height: 60rpx; line-height: 60rpx; border-radius: 50%; background: #2d1b2e; color: #C9A24B; font-weight: 800; font-size: 28rpx; margin: 0 auto 16rpx; }
.step-t { display: block; font-size: 28rpx; font-weight: 700; color: #2d1b2e; }
.step-d { display: block; font-size: 20rpx; color: #999; margin-top: 8rpx; line-height: 1.45; }
.step-arrow { font-size: 34rpx; color: #C9A24B; font-weight: 700; margin-top: 18rpx; flex-shrink: 0; }

/* ---------- Version cards ---------- */
.vcard { background: #fff; border-radius: 26rpx; padding: 34rpx; box-shadow: 0 6rpx 22rpx rgba(0,0,0,.05); position: relative; }
.vcard.pro { border: 2rpx solid #C9A24B; }
.v-badge { position: absolute; top: -2rpx; right: 30rpx; background: linear-gradient(90deg, #C9A24B, #dab860); color: #2d1b2e; font-size: 20rpx; font-weight: 800; padding: 10rpx 22rpx; border-radius: 0 0 14rpx 14rpx; }
.v-head { display: flex; justify-content: space-between; align-items: baseline; }
.v-name { font-size: 36rpx; font-weight: 800; color: #2d1b2e; display: block; }
.v-price { font-size: 44rpx; font-weight: 800; color: #C9A24B; }
.v-unit { font-size: 22rpx; color: #aaa; font-weight: 600; }
.v-desc { font-size: 23rpx; color: #888; display: block; margin: 14rpx 0 24rpx; line-height: 1.6; }
.v-feat { display: block; margin-bottom: 26rpx; }
.v-feat .ok, .v-feat .no { display: block; font-size: 25rpx; line-height: 1.95; }
.v-feat .ok { color: #2d1b2e; }
.v-feat .no { color: #bbb; }

/* 价格行（普通月卡 / 专业年卡） */
.price-row { display: flex; align-items: center; justify-content: space-between; background: #f7f5f2; border-radius: 14rpx; padding: 18rpx 22rpx; }
.price-row-title { display: block; font-size: 28rpx; font-weight: 700; color: #2d1b2e; }
.price-row-sub { display: block; font-size: 20rpx; color: #888; margin-top: 4rpx; }
.price-row-num { font-size: 44rpx; font-weight: 800; color: #C9A24B; }

/* 年卡 */
.year-card { padding-bottom: 30rpx; }
.year-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 22rpx; }
.year-sub { display: block; font-size: 23rpx; color: #888; margin-top: 6rpx; }

/* 按钮 */
.v-btn { text-align: center; border-radius: 16rpx; padding: 26rpx 0; font-size: 30rpx; font-weight: 800; }
.pro-btn { background: #2d1b2e; color: #C9A24B; }
.year-btn { border: 2rpx solid #C9A24B; color: #C9A24B; background: transparent; }

/* ---------- FAQ ---------- */
.faq-item { background: #fff; border-radius: 18rpx; padding: 24rpx 26rpx; margin-bottom: 18rpx; box-shadow: 0 3rpx 14rpx rgba(0,0,0,.03); }
.faq-q { display: block; font-size: 27rpx; font-weight: 700; color: #2d1b2e; margin-bottom: 10rpx; }
.faq-a { display: block; font-size: 23rpx; color: #777; line-height: 1.6; }

/* ---------- Bottom bar ---------- */
.bottom-pad { height: 170rpx; }
.bottom-bar { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; border-top: 1rpx solid #eee; padding: 20rpx 30rpx; padding-bottom: calc(20rpx + constant(safe-area-inset-bottom)); padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); display: flex; align-items: center; justify-content: space-between; z-index: 20; box-shadow: 0 -4rpx 20rpx rgba(0,0,0,.06); }
.bottom-info { display: flex; flex-direction: column; }
.bottom-price { font-size: 38rpx; font-weight: 800; color: #C9A24B; }
.bottom-tip { font-size: 20rpx; color: #999; }
.bottom-btn { background: #2d1b2e; color: #C9A24B; font-size: 32rpx; font-weight: 800; padding: 24rpx 60rpx; border-radius: 16rpx; }

/* ---------- Toast ---------- */
.toast { position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); background: rgba(0,0,0,.78); color: #fff; font-size: 26rpx; padding: 20rpx 36rpx; border-radius: 12rpx; z-index: 100; }
