.page { min-height: 100vh; background: #f7f5f2; font-family: system-ui, -apple-system, sans-serif; padding-bottom: constant(safe-area-inset-bottom); padding-bottom: env(safe-area-inset-bottom); }

/* Hero */
.hero { background: linear-gradient(160deg, #2d1b2e 0%, #1a0f1a 100%); padding: 60rpx 32rpx 50rpx; color: #fff; position: relative; overflow: hidden; }
.hero::after { content: ''; position: absolute; top: -80rpx; right: -80rpx; width: 300rpx; height: 300rpx; background: radial-gradient(circle, rgba(201,162,75,.25) 0%, transparent 70%); border-radius: 50%; }
.hero-tag { display: inline-block; font-size: 20rpx; color: #C9A24B; border: 1rpx solid rgba(201,162,75,.5); padding: 6rpx 16rpx; border-radius: 30rpx; margin-bottom: 24rpx; }
.hero-title { font-size: 52rpx; font-weight: 800; line-height: 1.2; display: block; letter-spacing: 2rpx; }
.hero-sub { font-size: 26rpx; color: #d8d0d8; line-height: 1.6; display: block; margin-top: 20rpx; }
.hero-badges { display: flex; gap: 14rpx; margin-top: 28rpx; }
.badge { font-size: 20rpx; color: #fcefe9; background: rgba(255,255,255,.12); padding: 8rpx 18rpx; border-radius: 30rpx; }
.hero-cta { margin-top: 40rpx; background: linear-gradient(90deg, #C9A24B, #d4af5a); border-radius: 18rpx; padding: 28rpx 0; text-align: center; box-shadow: 0 12rpx 30rpx rgba(201,162,75,.35); position: relative; z-index: 1; }
.cta-main { display: block; font-size: 32rpx; font-weight: 800; color: #2d1b2e; }
.cta-sub { display: block; font-size: 22rpx; color: #5a4723; margin-top: 6rpx; }

/* Section */
.section { padding: 36rpx 28rpx; }
.sec-title { font-size: 32rpx; font-weight: 800; color: #2d1b2e; display: block; margin-bottom: 24rpx; }

/* Steps */
.steps { display: flex; align-items: center; justify-content: space-between; }
.step { flex: 1; text-align: center; }
.step-num { width: 56rpx; height: 56rpx; line-height: 56rpx; border-radius: 50%; background: #2d1b2e; color: #C9A24B; font-weight: 800; font-size: 26rpx; margin: 0 auto 14rpx; }
.step-t { display: block; font-size: 26rpx; font-weight: 700; color: #2d1b2e; }
.step-d { display: block; font-size: 20rpx; color: #888; margin-top: 6rpx; line-height: 1.4; }
.step-arrow { font-size: 32rpx; color: #C9A24B; font-weight: 700; }

/* Version cards */
.version-card { background: #fff; border-radius: 24rpx; padding: 32rpx; margin-bottom: 24rpx; box-shadow: 0 4rpx 20rpx rgba(0,0,0,.04); position: relative; }
.version-card.pro { border: 2rpx solid #C9A24B; }
.v-badge { position: absolute; top: -2rpx; right: 32rpx; background: #C9A24B; color: #2d1b2e; font-size: 20rpx; font-weight: 700; padding: 10rpx 20rpx; border-radius: 0 0 12rpx 12rpx; }
.v-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 8rpx; }
.v-name { font-size: 34rpx; font-weight: 800; color: #2d1b2e; }
.v-price { font-size: 38rpx; font-weight: 800; color: #C9A24B; }
.v-desc { font-size: 22rpx; color: #888; display: block; margin-bottom: 20rpx; }
.v-features { margin-bottom: 28rpx; }
.feature { display: block; font-size: 24rpx; color: #444; line-height: 1.8; }
.feature.ok { color: #2d1b2e; }
.feature.no { color: #aaa; }
.v-btn { text-align: center; background: #f7f5f2; color: #2d1b2e; font-size: 28rpx; font-weight: 700; padding: 22rpx 0; border-radius: 14rpx; border: 1rpx solid #e0d8d0; }
.v-btn.pro-btn { background: #2d1b2e; color: #C9A24B; border-color: #2d1b2e; }

/* Packages */
.pkg-row { display: flex; justify-content: space-between; align-items: center; background: #fff; border-radius: 18rpx; padding: 24rpx; margin-bottom: 16rpx; border: 1rpx solid #eee; }
.pkg-row.hl { background: rgba(201,162,75,.08); border-color: #C9A24B; }
.pkg-name { font-size: 28rpx; font-weight: 700; color: #2d1b2e; display: block; }
.pkg-desc { font-size: 20rpx; color: #888; display: block; margin-top: 4rpx; }
.pkg-right { text-align: right; }
.pkg-price { font-size: 38rpx; font-weight: 800; color: #C9A24B; }
.pkg-unit { font-size: 20rpx; color: #999; }

/* FAQ */
.faq-item { margin-bottom: 24rpx; }
.faq-q { display: block; font-size: 26rpx; font-weight: 700; color: #2d1b2e; margin-bottom: 8rpx; }
.faq-a { display: block; font-size: 22rpx; color: #777; line-height: 1.5; }

/* Bottom bar */
.bottom-bar { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; border-top: 1rpx solid #eee; padding: 20rpx 28rpx; padding-bottom: calc(20rpx + constant(safe-area-inset-bottom)); padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); display: flex; align-items: center; justify-content: space-between; z-index: 20; }
.bottom-info { display: flex; flex-direction: column; }
.bottom-price { font-size: 34rpx; font-weight: 800; color: #C9A24B; }
.bottom-tip { font-size: 20rpx; color: #999; }
.bottom-btn { background: linear-gradient(90deg, #2d1b2e, #4a2d4c); color: #C9A24B; font-size: 30rpx; font-weight: 800; padding: 22rpx 50rpx; border-radius: 14rpx; }

/* Toast */
.toast { position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); background: rgba(0,0,0,.78); color: #fff; font-size: 26rpx; padding: 20rpx 36rpx; border-radius: 12rpx; z-index: 100; }
