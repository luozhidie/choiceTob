<view class="page">
  <!-- AI生成显著标识（合规：深度合成-AI创作类目要求） -->
  <view class="ai-gen-bar">
    <text class="ai-gen-tag">{{tryon.aiTag}}</text>
    <text class="ai-gen-txt">{{tryon.aiText}}</text>
  </view>
  <!-- Hero：深色 + 金色，首单只放这里 -->
  <view class="hero">
    <view class="hero-tag">{{tryon.promo.tag}}</view>
    <text class="hero-title">{{tryon.promo.title}}</text>
    <text class="hero-sub">{{tryon.promo.sub}}</text>
    <view class="hero-badges">
      <text class="badge" wx:for="{{tryon.promo.badges}}" wx:key="*this">{{item}}</text>
    </view>
    <view class="hero-cta" bindtap="onFirstTry">
      <text class="cta-main">{{tryon.promo.ctaMain}}</text>
      <text class="cta-sub">{{tryon.promo.ctaSub}}</text>
    </view>
  </view>

  <!-- 三步 -->
  <view class="section">
    <text class="sec-title">{{tryon.promo.stepsTitle}}</text>
    <view class="steps">
      <view class="step" wx:for="{{tryon.promo.steps}}" wx:key="t">
        <view class="step-num">{{index + 1}}</view>
        <text class="step-t">{{item.t}}</text>
        <text class="step-d">{{item.d}}</text>
      </view>
    </view>
  </view>

  <!-- 4 入口卡 -->
  <view class="section">
    <text class="sec-title">{{tryon.promo.entryTitle}}</text>
    <view class="entry-grid">
      <view class="entry" bindtap="goSub" data-page="tryon-normal">
        <text class="entry-emoji">{{tryon.promo.entries[0].emoji}}</text>
        <text class="entry-name">{{tryon.promo.entries[0].name}}</text>
        <text class="entry-sub">{{tryon.promo.entries[0].sub}}</text>
      </view>
      <view class="entry pro" bindtap="goSub" data-page="tryon-pro">
        <text class="entry-emoji">{{tryon.promo.entries[1].emoji}}</text>
        <text class="entry-name">{{tryon.promo.entries[1].name}}</text>
        <text class="entry-sub">{{tryon.promo.entries[1].sub}}</text>
      </view>
      <view class="entry" bindtap="goSub" data-page="tryon-guide">
        <text class="entry-emoji">{{tryon.promo.entries[2].emoji}}</text>
        <text class="entry-name">{{tryon.promo.entries[2].name}}</text>
        <text class="entry-sub">{{tryon.promo.entries[2].sub}}</text>
      </view>
      <view class="entry" bindtap="goSub" data-page="tryon-faq">
        <text class="entry-emoji">{{tryon.promo.entries[3].emoji}}</text>
        <text class="entry-name">{{tryon.promo.entries[3].name}}</text>
        <text class="entry-sub">{{tryon.promo.entries[3].sub}}</text>
      </view>
    </view>
  </view>

  <!-- 套餐选择已移除：入口卡已承载普通版/专业版入口，避免重复堆叠 -->

  <view wx:if="{{toast}}" class="toast">{{toast}}</view>
</view>
