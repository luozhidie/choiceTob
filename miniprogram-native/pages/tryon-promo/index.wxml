<view class="page">
  <!-- Hero：深色 + 金色，首单只放这里 -->
  <view class="hero">
    <view class="hero-tag">骆芷蝶智选 · AI 试衣</view>
    <text class="hero-title">先试再买\n穿上身再决定</text>
    <text class="hero-sub">上传你的照片，AI 把衣服「穿」到你身上。好不好看，一眼就知道。</text>
    <view class="hero-badges">
      <text class="badge">9.9元首单</text>
      <text class="badge">30 秒出图</text>
      <text class="badge">隐私保护</text>
    </view>
    <view class="hero-cta" bindtap="onFirstTry">
      <text class="cta-main">新人首单 ¥9.9 试穿</text>
      <text class="cta-sub">9 次普通 + 1 次专业 · 限时体验</text>
    </view>
  </view>

  <!-- 三步 -->
  <view class="section">
    <text class="sec-title">三步，看见上身效果</text>
    <view class="steps">
      <view class="step">
        <view class="step-num">1</view>
        <text class="step-t">上传照片</text>
        <text class="step-d">正面半身照，仅用于本次合成</text>
      </view>
      <view class="step-arrow">→</view>
      <view class="step">
        <view class="step-num">2</view>
        <text class="step-t">挑选衣服</text>
        <text class="step-d">从店铺商品里选，或 AI 推荐</text>
      </view>
      <view class="step-arrow">→</view>
      <view class="step">
        <view class="step-num">3</view>
        <text class="step-t">生成上身图</text>
        <text class="step-d">AI 合成真实穿着效果</text>
      </view>
    </view>
  </view>

  <!-- 普通版 -->
  <view class="section card-section">
    <view class="vcard basic">
      <text class="v-name">普通版</text>
      <text class="v-desc">像后台验收一样简单：上传人像 + 上传衣服，点试穿</text>
      <view class="v-feat">
        <text class="ok">✓ 上传自己的人像照片</text>
        <text class="ok">✓ 上传想试穿的衣服照片</text>
        <text class="ok">✓ 一键 AI 合成上身效果</text>
        <text class="ok">✓ 也可以从店铺挑选商品试穿</text>
        <text class="no">— 不含风格诊断</text>
        <text class="no">— 不含 AI 智能搭配 / 买手推荐</text>
      </view>
      <view class="price-row" bindtap="buyPackage" data-id="tryon_normal_monthly_59">
        <view>
          <text class="price-row-title">普通月卡</text>
          <text class="price-row-sub">30 天 70 次普通试穿</text>
        </view>
        <text class="price-row-num">¥59</text>
      </view>
    </view>
  </view>

  <!-- 专业版 -->
  <view class="section card-section">
    <view class="vcard pro">
      <view class="v-badge">专业版</view>
      <view class="v-head">
        <text class="v-name">专业版</text>
        <text class="v-price">¥199<text class="v-unit">/月起</text></text>
      </view>
      <text class="v-desc">在普通版基础上，加风格诊断与智能搭配</text>
      <view class="v-feat">
        <text class="ok">✓ 普通版全部功能</text>
        <text class="ok">✓ 21 题穿衣风格诊断</text>
        <text class="ok">✓ AI 按风格自动生成造型</text>
        <text class="ok">✓ 专属买手推荐 + 优先新款</text>
      </view>
      <view class="v-btn pro-btn" bindtap="onOpenPro">开通专业版</view>
    </view>
  </view>

  <!-- 专业年卡 -->
  <view class="section card-section">
    <view class="vcard year-card">
      <view class="year-head">
        <view>
          <text class="v-name">专业年卡</text>
          <text class="year-sub">365 天 1000 次专业诊断</text>
        </view>
        <text class="v-price">¥999</text>
      </view>
      <view class="v-btn year-btn" bindtap="buyPackage" data-id="tryon_pro_year_999">开通专业年卡</view>
    </view>
  </view>

  <!-- 常见问题 -->
  <view class="section faq">
    <text class="sec-title">常见问题</text>
    <view class="faq-item">
      <text class="faq-q">照片会被保存或公开吗？</text>
      <text class="faq-a">不会。照片仅用于本次 AI 试衣合成，处理后不保留、不公开。</text>
    </view>
    <view class="faq-item">
      <text class="faq-q">试衣效果能当真实试穿看吗？</text>
      <text class="faq-a">AI 合成效果仅供参考，帮助你判断款式、颜色是否适合自己。</text>
    </view>
    <view class="faq-item">
      <text class="faq-q">专业版可以随时取消吗？</text>
      <text class="faq-a">可以。到期不续费自动回到基础版，已购权益不受影响。</text>
    </view>
  </view>

  <view class="bottom-pad"></view>

  <!-- 底部固定 CTA -->
  <view class="bottom-bar">
    <view class="bottom-info">
      <text class="bottom-price">首单 ¥9.9</text>
      <text class="bottom-tip">新人限时体验价</text>
    </view>
    <view class="bottom-btn" bindtap="goLookStudio">立即试穿</view>
  </view>

  <view wx:if="{{toast}}" class="toast">{{toast}}</view>
</view>
