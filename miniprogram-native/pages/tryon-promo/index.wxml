<view class="page">
  <!-- Hero：深色 + 金色，首单只放这里 -->
  <view class="hero">
    <view class="hero-tag">骆芷蝶智选 · AI 试衣</view>
    <text class="hero-title">先试再买\n穿上身再决定</text>
    <text class="hero-sub">上传你的照片，AI 把衣服「穿」到你身上。好不好看，一眼就知道。</text>
    <view class="hero-badges">
      <text class="badge">9.9元首单</text>
      <text class="badge">30 秒出图</text>
      <text class="badge">隐私保护</text>
    </view>
    <view class="hero-cta" bindtap="onFirstTry">
      <text class="cta-main">新人首单 ¥9.9 试穿</text>
      <text class="cta-sub">9 次普通 + 1 次专业 · 限时</text>
    </view>
  </view>

  <!-- 三步 -->
  <view class="section">
    <text class="sec-title">三步，看见上身效果</text>
    <view class="steps">
      <view class="step">
        <view class="step-num">1</view>
        <text class="step-t">上传照片</text>
        <text class="step-d">正面半身照，仅用于本次合成</text>
      </view>
      <view class="step-arrow">→</view>
      <view class="step">
        <view class="step-num">2</view>
        <text class="step-t">挑选衣服</text>
        <text class="step-d">从店铺商品里选，或 AI 推荐</text>
      </view>
      <view class="step-arrow">→</view>
      <view class="step">
        <view class="step-num">3</view>
        <text class="step-t">生成上身图</text>
        <text class="step-d">AI 合成真实穿着效果</text>
      </view>
    </view>
  </view>

  <!-- 4 入口卡 -->
  <view class="section">
    <text class="sec-title">选择你的试衣方式</text>
    <view class="entry-grid">
      <view class="entry" bindtap="goSub" data-page="tryon-normal">
        <text class="entry-emoji">👕</text>
        <text class="entry-name">普通版</text>
        <text class="entry-sub">快速看上身 · ¥59/月</text>
      </view>
      <view class="entry pro" bindtap="goSub" data-page="tryon-pro">
        <text class="entry-emoji">✨</text>
        <text class="entry-name">专业版</text>
        <text class="entry-sub">诊断+搭配 · ¥199/月起</text>
      </view>
      <view class="entry" bindtap="goSub" data-page="tryon-guide">
        <text class="entry-emoji">📖</text>
        <text class="entry-name">怎么用</text>
        <text class="entry-sub">一步步图文教程</text>
      </view>
      <view class="entry" bindtap="goSub" data-page="tryon-faq">
        <text class="entry-emoji">❓</text>
        <text class="entry-name">常见问题</text>
        <text class="entry-sub">隐私/效果/退订</text>
      </view>
    </view>
  </view>

  <!-- 套餐选择 -->
  <view class="section">
    <text class="sec-title">普通版套餐</text>
    <view class="package-list">
      <view wx:for="{{packages}}" wx:key="id" wx:if="{{item.type === 'first' || item.type === 'normal_month'}}" class="package-card {{item.highlight ? 'highlight' : ''}}" bindtap="buyPackageById" data-id="{{item.id}}">
        <view class="package-header">
          <view>
            <text class="package-name">{{item.name}}</text>
            <text class="package-desc">{{item.desc}}</text>
          </view>
          <text class="package-price">¥{{item.price}}</text>
        </view>
        <view class="package-btn">立即购买</view>
      </view>
    </view>
  </view>

  <view class="section" style="padding-top:0">
    <text class="sec-title">专业版套餐</text>
    <view class="package-list">
      <view wx:for="{{packages}}" wx:key="id" wx:if="{{item.type === 'pro_month' || item.type === 'pro_year'}}" class="package-card {{item.highlight ? 'highlight' : ''}} {{item.type === 'pro_year' ? 'dark' : ''}}" bindtap="buyPackageById" data-id="{{item.id}}">
        <view class="package-header">
          <view>
            <text class="package-name">{{item.name}}</text>
            <text class="package-desc">{{item.desc}}</text>
          </view>
          <text class="package-price">¥{{item.price}}</text>
        </view>
        <view class="package-btn">立即购买</view>
      </view>
    </view>
  </view>

  <view class="bottom-pad"></view>

  <!-- 底部固定 CTA -->
  <view class="bottom-bar">
    <view class="bottom-info">
      <text class="bottom-price">首单 ¥9.9</text>
      <text class="bottom-tip">9 次普通 + 1 次专业</text>
    </view>
    <view class="bottom-btn" bindtap="goLookStudio">立即试穿</view>
  </view>

  <view wx:if="{{toast}}" class="toast">{{toast}}</view>
</view>
