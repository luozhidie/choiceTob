page { background: var(--bg); }

/* hero */
.hero {
  background: linear-gradient(135deg, #2d1b2e, #4a3a4b);
  color: #fff;
  padding: 48rpx 32rpx 36rpx;
  border-radius: 0 0 32rpx 32rpx;
  text-align: center;
}
.hero-label { font-size: 24rpx; opacity: 0.8; }
.hero-score {
  font-size: 88rpx;
  font-weight: 800;
  line-height: 1.1;
  margin: 8rpx 0;
  color: #C9A24B;
}
.hero-sub { font-size: 22rpx; opacity: 0.75; }
.hero-exchange {
  margin: 28rpx auto 0;
  display: inline-block;
  background: #C9A24B;
  color: #2d1b2e;
  font-weight: 700;
  font-size: 26rpx;
  padding: 16rpx 40rpx;
  border-radius: 40rpx;
}
.hero-exchange.on { opacity: 1; }
.hero-exchange:not(.on) { background: rgba(201, 162, 75, 0.35); color: #fdf6e3; }
.hero-tip { font-size: 20rpx; opacity: 0.7; margin-top: 14rpx; }

/* card block */
.card-block {
  background: var(--surface);
  border-radius: var(--r-md);
  margin: 24rpx 24rpx 0;
  padding: 28rpx 24rpx;
  box-shadow: var(--sh-1);
}
.block-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.block-title { font-size: 30rpx; font-weight: 700; color: var(--text); }
.block-extra { font-size: 22rpx; color: var(--text-3); }

/* checkin grid */
.checkin-grid {
  display: flex;
  justify-content: space-between;
  gap: 10rpx;
}
.checkin-cell {
  flex: 1;
  background: #f7f3ee;
  border-radius: 14rpx;
  padding: 18rpx 0;
  text-align: center;
  position: relative;
  border: 2rpx solid transparent;
}
.checkin-cell.done {
  background: linear-gradient(135deg, #fbe9c9, #f6d89a);
  border-color: #C9A24B;
}
.checkin-day { font-size: 20rpx; color: var(--text-2); display: block; }
.checkin-pts { font-size: 24rpx; font-weight: 700; color: #2d1b2e; display: block; margin-top: 6rpx; }
.checkin-flag {
  position: absolute;
  top: -10rpx;
  right: -6rpx;
  width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  background: #C9A24B;
  color: #fff;
  border-radius: 50%;
  font-size: 20rpx;
}
.checkin-btn {
  margin-top: 24rpx;
  background: linear-gradient(135deg, #2d1b2e, #4a3a4b);
  color: #fff;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.checkin-btn.done { background: #d9d2cc; color: #fff; }

/* tasks */
.task {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.task:last-child { border-bottom: none; }
.task-icon {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #f7f3ee;
  border-radius: 16rpx;
  font-size: 38rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}
.task-main { flex: 1; }
.task-label { font-size: 26rpx; color: var(--text); display: block; }
.task-tag { font-size: 20rpx; color: #b8860b; display: block; margin-top: 4rpx; }
.task-btn {
  background: #2d1b2e;
  color: #fff;
  font-size: 22rpx;
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  flex-shrink: 0;
}
.task-btn.done { background: #d9d2cc; }

/* empty / loading */
.empty { text-align: center; padding: 120rpx 0; color: #ccc; }
.empty-icon { font-size: 80rpx; display: block; margin-bottom: 20rpx; }
.empty-text { font-size: 26rpx; }
.empty-btn {
  margin-top: 30rpx;
  background: #2d1b2e;
  color: #fff;
  font-size: 26rpx;
  padding: 14rpx 56rpx;
  border-radius: 40rpx;
  display: inline-block;
}
.loading { text-align: center; padding: 80rpx 0; }
.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 3rpx solid #eee;
  border-top-color: #2d1b2e;
  border-radius: 50%;
  display: inline-block;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
