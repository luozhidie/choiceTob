<view class="page">
  <view wx:if="{{loading}}" class="loading"><text>加载中...</text></view>

  <block wx:else>
    <!-- 顶部状态条 -->
    <view class="topbar {{order.status}}">
      <text class="tb-status">{{statusLabel}}</text>
      <text class="tb-tip">{{statusTip}}</text>
    </view>

    <!-- 商品卡片 -->
    <view class="card">
      <view class="card-head">
        <text class="ch-no">订单号：{{order.order_no}}</text>
      </view>
      <view class="prod">
        <image src="{{order.product_image||''}}" mode="aspectFill" class="prod-img"/>
        <view class="prod-info">
          <text class="prod-name">{{order.product_title||'商品'}}</text>
          <view class="prod-price-row">
            <text class="prod-price">¥{{priceYuan}}</text>
            <text class="prod-qty">x{{order.quantity||1}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 金额 -->
    <view class="card">
      <view class="row"><text class="rl">商品金额</text><text class="rv">¥{{totalYuan}}</text></view>
      <view class="row total"><text class="rl">实付金额</text><text class="rv gold">¥{{totalYuan}}</text></view>
    </view>

    <!-- 订单信息 -->
    <view class="card">
      <view class="row"><text class="rl">下单时间</text><text class="rv">{{createdAt||'—'}}</text></view>
      <view class="row"><text class="rl">支付时间</text><text class="rv">{{paidAt||'—'}}</text></view>
      <view class="row"><text class="rl">收货信息</text><text class="rv">{{order.contact||'—'}}</text></view>
      <view class="row"><text class="rl">收货地址</text><text class="rv">{{order.address||'—'}}</text></view>
      <view class="row" wx:if="{{order.note}}"><text class="rl">买家备注</text><text class="rv">{{order.note}}</text></view>
    </view>

    <view class="sbtm"></view>

    <!-- 底部操作 -->
    <view class="footer">
      <view class="fbtn back" bindtap="goBack">返回</view>
      <view class="fbtn pay" wx:if="{{order.status==='pending'}}" bindtap="payAgain">去支付 ¥{{totalYuan}}</view>
      <view class="fbtn confirm" wx:if="{{order.status==='shipped'}}" bindtap="confirmReceive">确认收货</view>
    </view>
  </block>
</view>
