page{background:#f6f3f0;}

.loading{text-align:center;padding:120rpx 0;color:#999;font-size:26rpx;}

/* 顶部状态条 */
.topbar{padding:48rpx 32rpx;color:#fff;background:linear-gradient(135deg,#2d1b2e,#4a3a4b);}
.topbar.paid{background:linear-gradient(135deg,#2d1b2e,#4a3a4b);}
.topbar.shipped{background:linear-gradient(135deg,#3a2e1e,#6b5a3a);}
.topbar.completed{background:linear-gradient(135deg,#1f3a2e,#2e5a45);}
.topbar.cancelled{background:linear-gradient(135deg,#555,#777);}
.topbar.refund_pending,.topbar.refunded{background:linear-gradient(135deg,#5a3a1e,#8a5a2a);}
.tb-status{font-size:38rpx;font-weight:700;display:block;}
.tb-tip{font-size:24rpx;opacity:.85;margin-top:10rpx;display:block;}

/* 卡片 */
.card{background:#fff;border-radius:16rpx;margin:16rpx;padding:8rpx 24rpx;box-shadow:0 2rpx 10rpx rgba(0,0,0,.04);}

.card-head{padding:18rpx 0;border-bottom:1rpx solid #f5f2ef;}
.ch-no{font-size:23rpx;color:#888;}

.prod{display:flex;padding:18rpx 0;align-items:center;}
.prod-img{width:150rpx;height:150rpx;border-radius:12rpx;background:#eee;flex-shrink:0;margin-right:18rpx;}
.prod-info{flex:1;}
.prod-name{font-size:28rpx;font-weight:500;color:#333;display:block;margin-bottom:12rpx;}
.prod-price-row{display:flex;align-items:baseline;}
.prod-price{font-size:32rpx;color:#2d1b2e;font-weight:700;}
.prod-qty{font-size:23rpx;color:#999;margin-left:10rpx;}

/* 信息行 */
.row{display:flex;justify-content:space-between;align-items:flex-start;padding:18rpx 0;border-bottom:1rpx solid #f5f2ef;font-size:26rpx;}
.row:last-child{border-bottom:none;}
.rl{color:#888;}
.rv{color:#333;text-align:right;max-width:68%;}
.row.total .rl{font-weight:600;color:#333;}
.row.total .rv.gold{color:#C9A24B;font-weight:700;font-size:30rpx;}

.sbtm{height:30rpx;}

/* 底部操作 */
.footer{position:fixed;left:0;right:0;bottom:0;display:flex;gap:16rpx;padding:18rpx 24rpx;background:#fff;box-shadow:0 -2rpx 10rpx rgba(0,0,0,.06);}
.fbtn{flex:1;text-align:center;padding:22rpx 0;border-radius:40rpx;font-size:28rpx;font-weight:600;}
.fbtn.back{border:1rpx solid #ddd;color:#666;flex:0 0 30%;}
.fbtn.pay{background:linear-gradient(135deg,#2d1b2e,#4a3a4b);color:#fff;}
.fbtn.confirm{background:linear-gradient(135deg,#C9A24B,#b8902f);color:#fff;}
