var formatMoney = function(cents){
  if (!cents || cents <= 0) return '0';
  var s = (cents / 100).toFixed(0);
  // 正数千分位加逗号
  var parts = s.split('.');
  var intPart = parts[0];
  var out = '';
  var len = intPart.length;
  for (var i = 0; i < len; i++) {
    if (i > 0 && (len - i) % 3 === 0) out += ',';
    out += intPart.charAt(i);
  }
  return out;
};
module.exports = { formatMoney: formatMoney };
