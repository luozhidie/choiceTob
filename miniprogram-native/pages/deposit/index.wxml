<view class="page">
  <!-- 标题区 -->
  <view class="header">
    <view class="htitle"><text>📦 预存货款 · 折扣拿货</text></view>
    <text class="hdesc">预存越多，折扣越低。预存款可用于采购下单，随时退。</text>
  </view>

  <!-- 当前权益 -->
  <view class="status-bar {{agentStatus.active?'active':''}}">
    <block wx:if="{{agentStatus.active}}">
      <text class="st-main">已激活：预存 ¥{{agentStatus.depositText}}</text>
      <text class="st-sub">拿货 {{agentStatus.discountText}} 折 · 可退 {{agentStatus.returnText}}%</text>
    </block>
    <block wx:else>
      <text class="st-main">未开通预存货款会员</text>
      <text class="st-sub">充值后即可享受批发折扣价</text>
    </block>
  </view>

  <!-- 代理中心入口 -->
  <view class="agent-center-entry {{agentStatus.active?'ace-active':''}}" bindtap="goAgentCenter">
    <view class="ace-left">
      <text class="ace-title">代理中心</text>
      <text class="ace-desc">{{agentStatus.active?'已开通代理店铺 · 去设置对客卖价、分享试衣卖货':'充值后自动开通代理店铺，设置卖价卖货赚差价'}}</text>
    </view>
    <view class="ace-btn">{{agentStatus.active?'进入 ›':'去开通 ›'}}</view>
  </view>

  <!-- 套餐卡片 -->
  <view class="cards">
    <view class="card {{item.isTest?'card-test':''}} {{item.id==='wholesale_6k'?'card-rec':''}}" wx:for="{{plans}}" wx:key="id" bindtap="selectPlan" data-plan="{{item}}">
      <view class="rec-tag" wx:if="{{item.isTest}}">测试</view>
      <view class="rec-tag" wx:if="{{item.id==='wholesale_6k'}}">首充推荐</view>
      <text class="camt">{{item.amount}}</text>
      <text class="csub">{{item.isTest?'支付金额':'预存金额'}}</text>
      <text class="cdisc">{{item.discount}}</text>
      <text class="crefund">{{item.refund>0?('退'+item.refund+'%'):'不退现'}}</text>
      <view class="cexample"><text>{{item.example}}</text></view>
      <view class="tryon-tip" wx:if="{{item.tryonTip}}"><text>{{item.tryonTip}}</text></view>
    </view>
  </view>

  <!-- 提示 -->
  <view class="tip"><text>💡 预存货款仅用于本店拿货，不退现；已享折扣的已消费部分不退。详情请联系客服</text></view>
  <view class="contact"><text>如有疑问或需要帮助，请 </text><text class="clink" bindtap="goContact">联系客服</text></view>

  <!-- 支付弹窗 -->
  <view class="mask" wx:if="{{showPay}}" bindtap="closePay">
    <view class="modal" catchtap="noop">
      <text class="mtit">确认充值</text>
      <text class="mname">{{selectedPlan.name}}</text>
      <text class="mpr">{{selectedPlan.amountLabel}}</text>
      <text class="mdesc">{{selectedPlan.discount}} · {{selectedPlan.refund>0?('退'+selectedPlan.refund+'%可退'):'货款不退现'}}</text>
      <view class="tryon-tip" wx:if="{{selectedPlan.tryonTip}}"><text>{{selectedPlan.tryonTip}}</text></view>
      <view class="mbtn {{loading?'disabled':''}}" bindtap="{{loading?'noop':'confirmPay'}}">
        <text>{{loading?'请稍候...':'微信支付'}}</text>
      </view>
    </view>
  </view>

  <!-- 协议弹窗 -->
  <view class="mask" wx:if="{{showAgreement}}" bindtap="closeAgreement">
    <view class="modal agreement-modal" catchtap="noop">
      <text class="mtit">请阅读并签署《预充货款协议》</text>
      <scroll-view class="agreement-box" scroll-y="true">
        <text class="agreement-text" user-select="true">{{agreementText}}</text>
      </scroll-view>
      <view class="mbtn" bindtap="signAgreement"><text>我已阅读并同意签署</text></view>
      <view class="mcancel" bindtap="closeAgreement"><text>暂不开通</text></view>
    </view>
  </view>
</view>
