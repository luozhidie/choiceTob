<view class="page">
  <!-- 标题区 -->
  <view class="header">
    <view class="htitle"><text>{{depositCopy.header.title}}</text></view>
    <text class="hdesc">{{depositCopy.header.subtitle}}</text>
  </view>

  <!-- 当前权益 -->
  <view class="status-bar {{agentStatus.active?'active':''}}">
    <block wx:if="{{agentStatus.active}}">
      <text class="st-main">{{statusMain}}</text>
      <text class="st-sub">{{statusSub}}</text>
    </block>
    <block wx:else>
      <text class="st-main">{{statusMain}}</text>
      <text class="st-sub">{{statusSub}}</text>
    </block>
  </view>

  <!-- 代理中心入口 -->
  <view class="agent-center-entry {{agentStatus.active?'ace-active':''}}" bindtap="goAgentCenter">
    <view class="ace-left">
      <text class="ace-title">{{depositCopy.agentEntry.title}}</text>
      <text class="ace-desc">{{agentStatus.active?depositCopy.agentEntry.descActive:depositCopy.agentEntry.descInactive}}</text>
    </view>
    <view class="ace-btn">{{agentStatus.active?depositCopy.agentEntry.btnActive:depositCopy.agentEntry.btnInactive}}</view>
  </view>

  <!-- 套餐卡片 -->
  <view class="cards">
    <view class="card {{item.isTest?'card-test':''}} {{item.id==='wholesale_6k'?'card-rec':''}}" wx:for="{{plans}}" wx:key="id" bindtap="selectPlan" data-plan="{{item}}">
      <view class="rec-tag" wx:if="{{item.isTest}}">测试</view>
      <view class="rec-tag" wx:if="{{item.id==='wholesale_6k'}}">首充推荐</view>
      <text class="camt">{{item.amount}}</text>
      <text class="csub">{{item.isTest?depositCopy.amountLabels.pay:depositCopy.amountLabels.deposit}}</text>
      <text class="cdisc">{{item.discount}}</text>
      <text class="crefund">{{item.refund>0?('退'+item.refund+'%'):depositCopy.amountLabels.noRefund}}</text>
      <view class="cexample"><text>{{item.example}}</text></view>
      <view class="tryon-tip" wx:if="{{item.tryonTip}}"><text>{{item.tryonTip}}</text></view>
    </view>
  </view>

  <!-- 提示 -->
  <view class="tip"><text>{{depositCopy.tips.tip}}</text></view>
  <view class="contact"><text>{{depositCopy.tips.contactPrefix}} </text><text class="clink" bindtap="goContact">{{depositCopy.tips.contactLink}}</text></view>

  <!-- 支付弹窗 -->
  <view class="mask" wx:if="{{showPay}}" bindtap="closePay">
    <view class="modal" catchtap="noop">
      <text class="mtit">{{depositCopy.payModal.title}}</text>
      <text class="mname">{{selectedPlan.name}}</text>
      <text class="mpr">{{selectedPlan.amountLabel}}</text>
      <text class="mdesc">{{selectedPlan.discount}} · {{selectedPlan.refund>0?('退'+selectedPlan.refund+'%可退'):'货款不退现'}}</text>
      <view class="tryon-tip" wx:if="{{selectedPlan.tryonTip}}"><text>{{selectedPlan.tryonTip}}</text></view>
      <view class="pay-tip"><text>{{depositCopy.payModal.payTip}}</text></view>
      <view class="mwx"><text class="mwxl">{{depositCopy.payModal.advisorLabel}}</text><text class="mwxv" user-select="true">{{advisorWx}}</text></view>
      <view class="mbtn" bindtap="copyAdvisor"><text>{{depositCopy.payModal.copyBtn}}</text></view>
    </view>
  </view>

  <!-- 协议弹窗 -->
  <view class="mask" wx:if="{{showAgreement}}" bindtap="closeAgreement">
    <view class="modal agreement-modal" catchtap="noop">
      <text class="mtit">{{depositCopy.agreement.title}}</text>
      <scroll-view class="agreement-box" scroll-y="true">
        <text class="agreement-text" user-select="true">{{agreementText}}</text>
      </scroll-view>
      <view class="mbtn" bindtap="signAgreement"><text>{{depositCopy.agreement.agreeBtn}}</text></view>
      <view class="mcancel" bindtap="closeAgreement"><text>{{depositCopy.agreement.cancelBtn}}</text></view>
    </view>
  </view>
</view>
