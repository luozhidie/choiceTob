<view class="fb-root">
  <!-- 第一行：排序 -->
  <view class="fb-sort-bar" wx:if="{{showSort}}">
    <block wx:for="{{filterConfig.sorts}}" wx:key="key">
      <text class="fb-st {{sortType===item.key||(sortType==='price_desc'&&item.key==='price_asc')?'fb-st-on':''}}"
        bindtap="setSort" data-sort="{{item.key}}">{{item.label}}{{sortType==='price_asc'&&item.key==='price_asc'?'↑':''}}{{sortType==='price_desc'&&item.key==='price_asc'?'↓':''}}</text>
    </block>
    <text class="fb-st fb-trigger {{hasFilter?'fb-st-on':''}}" bindtap="openFilter">筛选 ▽</text>
  </view>

  <!-- 第二行：快捷筛选（横向滚动） -->
  <scroll-view class="fb-quick-bar" scroll-x show-scrollbar="{{false}}">
    <view wx:if="{{!showSort}}" class="fb-quick-item fb-quick-entry {{hasFilter?'fb-quick-on':''}}" bindtap="openFilter">
      <text>全部筛选 ▽</text>
    </view>
    <block wx:for="{{filterConfig.quickFilters}}" wx:key="key">
      <view class="fb-quick-item {{selectedFilters[item.key]&&selectedFilters[item.key].length?'fb-quick-on':''}} {{quickPopup===item.key?'fb-quick-active':''}}"
        bindtap="toggleQuick" data-key="{{item.key}}" data-type="{{item.type}}">
        <text wx:if="{{item.type==='toggle'&&selectedFilters[item.key]&&selectedFilters[item.key].length}}">✓ </text>
        <text>{{item.label}}</text>
        <text wx:if="{{item.type==='popup'}}"> ▼</text>
      </view>
    </block>
  </scroll-view>

  <!-- 第三行：品类/货品面料标签 -->
  <scroll-view wx:if="{{subCats.length}}" class="fb-subcat-scroll" scroll-x show-scrollbar="{{false}}">
    <view class="fb-subcat-row">
      <view class="fb-subcat-chip {{subCategory===''?'fb-sub-on':''}}" bindtap="switchSubCategory" data-name="">全部</view>
      <view wx:for="{{subCats}}" wx:key="*this" class="fb-subcat-chip {{subCategory===item?'fb-sub-on':''}}"
        bindtap="switchSubCategory" data-name="{{item}}">{{item}}</view>
    </view>
  </scroll-view>

  <!-- ========== 全部筛选抽屉 ========== -->
  <view class="fb-mask show" bindtap="closeFilter" wx:if="{{filterOpen}}"></view>
  <view class="fb-panel in" wx:if="{{filterOpen}}">
    <view class="fb-head">
      <text class="fb-title">全部筛选</text>
      <text class="fb-close" bindtap="closeFilter">✕</text>
    </view>
    <scroll-view class="fb-body" scroll-y>
      <block wx:for="{{filterConfig.filterPanel.sections}}" wx:key="key">
        <view class="fb-sec">
          <view class="fb-sec-title">{{item.title}}<text wx:if="{{item.type!=='price'}}" class="fb-mode">({{item.multiple?'多选':'单选'}})</text></view>
          <view wx:if="{{item.type==='price'}}" class="fb-price-row">
            <input class="fb-price-input" type="digit" placeholder="最低价格" value="{{minPrice}}" data-type="min" bindinput="onPriceInput"/>
            <text class="fb-price-line">-</text>
            <input class="fb-price-input" type="digit" placeholder="最高价格" value="{{maxPrice}}" data-type="max" bindinput="onPriceInput"/>
          </view>
          <view wx:else class="fb-tags">
            <view wx:for="{{item.options}}" wx:key="*this" wx:for-item="opt"
              class="fb-tag {{selectedFilters[item.key]&&selectedFilters[item.key].indexOf(opt)>=0?'fb-tag-on':''}}"
              bindtap="toggleFilter" data-key="{{item.key}}" data-value="{{opt}}" data-multiple="{{item.multiple}}">{{opt}}</view>
          </view>
        </view>
      </block>
      <!-- 配置里没有价格区间时，兜底提供一个 -->
      <view class="fb-sec" wx:if="{{!filterConfig.filterPanel.sections.length}}">
        <view class="fb-sec-title">价格区间</view>
        <view class="fb-price-row">
          <input class="fb-price-input" type="digit" placeholder="最低价格" value="{{minPrice}}" data-type="min" bindinput="onPriceInput"/>
          <text class="fb-price-line">-</text>
          <input class="fb-price-input" type="digit" placeholder="最高价格" value="{{maxPrice}}" data-type="max" bindinput="onPriceInput"/>
        </view>
      </view>
      <view class="fb-foot-space"></view>
    </scroll-view>
    <view class="fb-foot">
      <view class="fb-reset" bindtap="resetFilter">重置</view>
      <view class="fb-confirm" bindtap="confirmFilter">确定</view>
    </view>
  </view>

  <!-- ========== 快捷筛选弹窗（尺码/面料等） ========== -->
  <view class="fb-mask show" bindtap="closeQuickPopup" wx:if="{{quickPopup}}"></view>
  <view class="fb-popup in" wx:if="{{quickPopup}}">
    <view class="fb-head">
      <text class="fb-title">{{quickPopupLabel}}</text>
      <text class="fb-close" bindtap="closeQuickPopup">✕</text>
    </view>
    <view class="fb-popup-body">
      <view class="fb-tags">
        <view wx:for="{{quickPopupOptions}}" wx:key="*this"
          class="fb-tag {{selectedFilters[quickPopup]&&selectedFilters[quickPopup].indexOf(item)>=0?'fb-tag-on':''}}"
          bindtap="selectQuickPopup" data-key="{{quickPopup}}" data-value="{{item}}">{{item}}</view>
      </view>
    </view>
    <view class="fb-foot fb-foot-static">
      <view class="fb-reset" bindtap="closeQuickPopup">取消</view>
      <view class="fb-confirm" bindtap="confirmQuickPopup">完成</view>
    </view>
  </view>
</view>
