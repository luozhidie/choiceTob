/* ===== 通用筛选栏组件 ===== */
.fb-root{background:#fff;}

/* 第一行：排序 */
.fb-sort-bar{display:flex;align-items:center;padding:14rpx 24rpx;background:#fff;border-bottom:1rpx solid #f0ece8;}
.fb-st{font-size:25rpx;color:#888;padding:8rpx 18rpx;}
.fb-st-on{color:#ff4081;font-weight:700;}
.fb-trigger{margin-left:auto;}

/* 第二行：快捷筛选 */
.fb-quick-bar{white-space:nowrap;background:#fff;padding:12rpx 24rpx;border-bottom:1rpx solid #f0ece8;}
.fb-quick-item{display:inline-flex;align-items:center;padding:10rpx 18rpx;margin-right:14rpx;background:#f5f2ef;border-radius:28rpx;font-size:23rpx;color:#555;}
.fb-quick-item.fb-quick-on{background:#ff4081;color:#fff;}
.fb-quick-item.fb-quick-active{background:#2d1b2e;color:#fff;}
.fb-quick-entry{background:#2d1b2e;color:#fff;font-weight:600;}

/* 第三行：品类小标签 */
.fb-subcat-scroll{white-space:nowrap;background:#fff;padding:12rpx 24rpx;border-bottom:1rpx solid #f0ece8;}
.fb-subcat-row{display:inline-flex;gap:14rpx;}
.fb-subcat-chip{display:inline-flex;align-items:center;font-size:22rpx;color:#555;background:#f8f7f4;border-radius:12rpx;padding:10rpx 18rpx;}
.fb-subcat-chip.fb-sub-on{background:#2d1b2e;color:#fff;}

/* 抽屉 / 弹窗 */
.fb-mask{position:fixed;left:0;top:0;right:0;bottom:0;background:rgba(0,0,0,0);z-index:900;opacity:0;visibility:hidden;transition:all .25s;}
.fb-mask.show{background:rgba(0,0,0,.45);opacity:1;visibility:visible;}
.fb-panel{position:fixed;left:0;right:0;bottom:0;background:#fff;z-index:901;border-radius:24rpx 24rpx 0 0;transform:translateY(100%);transition:transform .3s;max-height:80vh;display:flex;flex-direction:column;}
.fb-panel.in{transform:translateY(0);}
.fb-popup{position:fixed;left:40rpx;right:40rpx;bottom:20vh;background:#fff;z-index:901;border-radius:24rpx;transform:translateY(100%);transition:transform .3s;max-height:60vh;display:flex;flex-direction:column;}
.fb-popup.in{transform:translateY(0);}

.fb-head{display:flex;align-items:center;justify-content:space-between;padding:24rpx 28rpx;border-bottom:1rpx solid #f0ece8;}
.fb-title{font-size:30rpx;font-weight:700;color:#333;}
.fb-close{font-size:28rpx;color:#999;padding:8rpx;}
.fb-body{flex:1;padding:20rpx 28rpx;overflow:auto;min-height:400rpx;}
.fb-popup-body{padding:24rpx 28rpx;}
.fb-foot-space{height:120rpx;}
.fb-foot{position:absolute;left:0;right:0;bottom:0;display:flex;padding:16rpx 28rpx 28rpx;background:#fff;border-top:1rpx solid #f0ece8;}
.fb-foot-static{position:static;padding:16rpx 28rpx 24rpx;}
.fb-reset{flex:1;text-align:center;padding:20rpx 0;background:#2d1b2e;color:#fff;font-size:28rpx;border-radius:36rpx 0 0 36rpx;}
.fb-confirm{flex:1;text-align:center;padding:20rpx 0;background:#ff4081;color:#fff;font-size:28rpx;border-radius:0 36rpx 36rpx 0;}

.fb-sec{margin-bottom:28rpx;}
.fb-sec-title{font-size:27rpx;font-weight:700;color:#333;margin-bottom:16rpx;}
.fb-mode{font-size:21rpx;color:#bbb;font-weight:400;margin-left:8rpx;}
.fb-tags{display:flex;flex-wrap:wrap;gap:14rpx;}
.fb-tag{padding:12rpx 22rpx;background:#f5f2ef;border-radius:28rpx;font-size:23rpx;color:#555;}
.fb-tag.fb-tag-on{background:#ff4081;color:#fff;}

.fb-price-row{display:flex;align-items:center;gap:16rpx;}
.fb-price-input{flex:1;height:64rpx;background:#f5f2ef;border-radius:12rpx;padding:0 16rpx;font-size:24rpx;text-align:center;}
.fb-price-line{color:#999;font-size:28rpx;}
